<odoo>

    <!-- Hooks into the public layout. Everything here is conditional on
         website.pwa_enabled, so a website with the app switched off serves
         exactly the same HTML it served before this module existed. -->
    <template
        id="pwa_layout_head"
        inherit_id="website.layout"
        name="PWA: manifest y meta en la cabecera"
    >
        <xpath expr="//head" position="inside">
            <t t-if="website.pwa_enabled">
                <link
                    rel="manifest"
                    href="/website_pwa/manifest.webmanifest"
                />
                <meta
                    name="theme-color"
                    t-att-content="website.pwa_theme_color or '#1a7f5a'"
                />
                <!-- iOS ignores the manifest entirely: without these three
                     tags "Añadir a pantalla de inicio" produces a bookmark
                     that opens Safari with its chrome, not an app. -->
                <meta name="apple-mobile-web-app-capable" content="yes" />
                <meta
                    name="apple-mobile-web-app-status-bar-style"
                    content="default"
                />
                <meta
                    name="apple-mobile-web-app-title"
                    t-att-content="website._pwa_short_name()"
                />
                <link
                    rel="apple-touch-icon"
                    sizes="192x192"
                    href="/website_pwa/icon/192.png"
                />
            </t>
        </xpath>
    </template>

    <!-- "Download Canarias Conectada": a compact install card meant to be
         t-called from pages that are not built in the editor, first of all
         the login, signup and reset-password pages.

         It carries the SAME classes as the s_pwa_install snippet on purpose:
         pwa_install.js drives every `.o_pwa_install_card` on the page, so the
         Android prompt, the iOS instructions and "already installed, stay
         hidden" are decided in one place and cannot drift between the two.

         Starts hidden. Only the script can know whether the browser offers an
         install prompt, whether this is an iPhone, or whether the page is
         already running inside the installed app. -->
    <template id="pwa_install_quick_access" name="PWA: quick install block">
        <div
            class="o_pwa_install_card o_pwa_quick_access d-none mt-4 p-3 rounded-3 text-center"
        >
            <div class="fw-bold mb-1">
                <i class="fa fa-mobile me-1" role="img" aria-hidden="true" />
                Download Canarias Conectada
            </div>
            <p class="small text-muted mb-2">
                Install the app on your phone: one tap to open it, and chat
                notifications even when it is closed.
            </p>
            <!-- Android / Chrome: revealed only once the browser fired
                 beforeinstallprompt, i.e. once it agrees to install. -->
            <button
                type="button"
                class="btn btn-primary btn-sm o_pwa_install_button d-none"
            >
                <i class="fa fa-download me-1" role="img" aria-hidden="true" />
                Install the app
            </button>
            <!-- iOS / iPadOS Safari: there is no prompt to trigger, so the
                 block shows where the two taps are. -->
            <ol class="o_pwa_ios_hint d-none small text-start mb-0 ps-3">
                <li>
                    Tap
                    <span class="o_pwa_ios_icon" aria-hidden="true">
                        <svg
                            width="14"
                            height="18"
                            viewBox="0 0 14 18"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M7 1v10M3.5 4.5 7 1l3.5 3.5M4.5 7.5H2.5v9h9v-9h-2" />
                        </svg>
                    </span>
                    <strong>Share</strong>
                    in the Safari toolbar.
                </li>
                <li>
                    Choose
                    <i
                        class="fa fa-plus-square-o o_pwa_ios_icon"
                        role="img"
                        aria-hidden="true"
                    />
                    <strong>Add to Home Screen</strong>
                    and open the app from there.
                </li>
            </ol>
        </div>
    </template>

</odoo>
