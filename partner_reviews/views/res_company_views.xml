<odoo>

    <record id="view_company_form_inherit_reviews" model="ir.ui.view">
        <field name="name">res.company.form.inherit.partner.reviews</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="website" position="after">
                <field name="enable_reviews" widget="boolean_toggle"/>
                <field name="review_avg" invisible="not enable_reviews"/>
                <field name="review_count" invisible="not enable_reviews"/>
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_reviews" type="object" class="oe_stat_button" icon="fa-star" invisible="not enable_reviews">
                    <field name="review_count" string="Reviews" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
