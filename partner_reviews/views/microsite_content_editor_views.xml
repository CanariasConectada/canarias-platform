<odoo>

    <!-- The merchant's own switch for their reviews page (client request
         2026-09-16), on the content editor they already use. Mirrored by the
         Reviews page of the company form's Microsite notebook. -->
    <record id="view_microsite_content_editor_form_reviews" model="ir.ui.view">
        <field name="name">microsite.content.editor.form.reviews</field>
        <field name="model">microsite.content.editor</field>
        <field name="inherit_id"
               ref="partner_microsite_manager.view_microsite_content_editor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Reviews" name="reviews">
                    <group>
                        <field name="enable_reviews" widget="boolean_toggle"/>
                    </group>
                    <group invisible="not enable_reviews">
                        <field name="review_avg"/>
                        <field name="review_count"/>
                        <field name="reviews_page_url" widget="url"/>
                    </group>
                    <p class="text-muted">When the page is enabled, your site's menu shows a Reviews entry leading to it. Changes apply when you save.</p>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
