<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="reviews_page_template" name="Página de Reseñas">
        <t t-call="website.layout">
            <div id="partner-reviews-app" class="oe_structure">
                <section class="py-5">
                    <div class="container">
                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h1 class="mb-0">Reseñas de <t t-esc="partner.name"/></h1>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Stats -->
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fa fa-star text-warning me-2"/>Valoración</h5>
                                    </div>
                                    <div class="card-body text-center">
                                        <span class="display-4 fw-bold text-primary" t-esc="'{:.1f}'.format(partner.review_rating_avg)"/>
                                        <div class="partner-review-stars mt-2" data-rating="0" data-readonly="1">
                                            <span class="star" data-value="1">★</span>
                                            <span class="star" data-value="2">★</span>
                                            <span class="star" data-value="3">★</span>
                                            <span class="star" data-value="4">★</span>
                                            <span class="star" data-value="5">★</span>
                                        </div>
                                        <p class="text-muted small mt-2">
                                            <span t-esc="partner.review_rating_count"/> valoraciones
                                            · <span t-esc="partner.review_comment_count"/> comentarios
                                        </p>
                                    </div>
                                </div>

                                <!-- Distribución -->
                                <div class="card border-0 shadow-sm mb-4">
                                    <div class="card-body">
                                        <t t-foreach="[5,4,3,2,1]" t-as="star">
                                            <div class="d-flex align-items-center mb-1">
                                                <span class="me-2 small" style="width: 2rem;"><t t-esc="star"/>★</span>
                                                <div class="flex-grow-1 progress" style="height: 8px;">
                                                    <div class="progress-bar bg-warning" role="progressbar"
                                                         t-att-style="'width: ' + str((distribucion.get(star, 0) / total_ratings * 100) if total_ratings else 0) + '%'"/>
                                                </div>
                                                <span class="ms-2 text-muted small" style="width: 1.5rem;"><t t-esc="distribucion.get(star, 0)"/></span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- Formularios y Listado -->
                            <div class="col-md-8">
                                <!-- Formulario de valoración (visible para todos) -->
                                <div class="card border-0 shadow-sm mb-4">
                                    <div class="card-body">
                                        <h5 class="mb-3">Tu valoración</h5>
                                        <div class="partner-review-stars interactive" id="rating-form" t-att-data-partner-id="partner.id" data-user-rating="0">
                                            <span class="star" data-value="1">★</span>
                                            <span class="star" data-value="2">★</span>
                                            <span class="star" data-value="3">★</span>
                                            <span class="star" data-value="4">★</span>
                                            <span class="star" data-value="5">★</span>
                                        </div>
                                        <div class="mt-3">
                                            <button id="btn-enviar-rating" class="btn btn-sm btn-primary">Enviar valoración</button>
                                            <button id="btn-eliminar-rating" class="btn btn-sm btn-outline-danger ms-2 d-none">Eliminar mi valoración</button>
                                        </div>
                                        <t t-if="request.env.user._is_public()">
                                            <p class="text-muted small mt-2 mb-0">
                                                <a href="/web/login?redirect=/resenas">Inicia sesión</a> para enviar tu valoración.
                                            </p>
                                        </t>
                                        <div id="rating-mensaje" class="alert alert-success mt-3 d-none py-2"></div>
                                    </div>
                                </div>

                                <t t-if="not request.env.user._is_public()">
                                    <!-- Formulario de comentario -->
                                    <t t-if="config.get('permitir_comentarios')">
                                        <div class="card border-0 shadow-sm mb-4">
                                            <div class="card-body">
                                                <h5 class="mb-3">Deja tu comentario</h5>
                                                <form id="comentario-form">
                                                    <textarea id="comment-content" class="form-control" rows="3" placeholder="Comparte tu experiencia..." required=""/>
                                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                                        <small class="text-muted">Serás notificado cuando tu comentario sea aprobado.</small>
                                                        <button type="submit" id="btn-enviar-comentario" class="btn btn-primary btn-sm">
                                                            <i class="fa fa-paper-plane me-1"/>Enviar
                                                        </button>
                                                    </div>
                                                </form>
                                                <div id="comment-mensaje" class="alert mt-3 d-none py-2"></div>
                                            </div>
                                        </div>
                                    </t>
                                </t>

                                <t t-if="request.env.user._is_public()">
                                    <!-- CTA para comentarios (anónimos) -->
                                    <div class="card border-0 shadow-sm mb-4 bg-light">
                                        <div class="card-body text-center py-4">
                                            <i class="fa fa-comments fa-2x text-primary mb-3"/>
                                            <h5>¿Quieres dejar un comentario?</h5>
                                            <a href="/web/login?redirect=/resenas" class="btn btn-primary btn-lg mt-2">Iniciar sesión</a>
                                        </div>
                                    </div>
                                </t>

                                <!-- Listado de comentarios -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="mb-0">Comentarios</h3>
                                    <span class="badge bg-secondary" id="total-comentarios">0</span>
                                </div>
                                <div id="comentarios-lista" t-att-data-partner-id="partner.id">
                                    <p class="text-muted">Cargando comentarios...</p>
                                </div>
                                <button id="btn-cargar-mas" class="btn btn-outline-primary w-100 d-none mt-3">Ver más comentarios</button>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- Modal Confirmar Eliminación -->
                <div class="modal fade" id="modal-eliminar-comentario" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Confirmar eliminación</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"/>
                            </div>
                            <div class="modal-body">
                                <p>¿Estás seguro de que deseas eliminar este comentario?</p>
                                <p class="text-muted small mb-0">Las respuestas asociadas quedarán visibles como comentarios independientes.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn btn-danger" id="btn-confirmar-eliminar">Eliminar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                window.PARTNER_REVIEWS_CONFIG = {
                    partnerId: <t t-esc="partner.id"/>,
                    isLoggedIn: <t t-esc="'true' if not request.env.user._is_public() else 'false'"/>,
                    permitirComentarios: <t t-esc="'true' if config.get('permitir_comentarios') else 'false'"/>,
                    esEmpleadoPartner: <t t-esc="'true' if (not request.env.user._is_public() and partner.user_ids and request.env.user.id in partner.user_ids.ids) else 'false'"/>,
                    userId: <t t-esc="request.env.user.id if not request.env.user._is_public() else 'null'"/>,
                    isModerator: <t t-esc="'true' if (not request.env.user._is_public() and (request.env.user.has_group('partner_reviews.group_partner_reviews_manager') or (partner.user_ids and request.env.user.id in partner.user_ids.ids))) else 'false'"/>
                };
            </script>
        </t>
    </template>
</odoo>
