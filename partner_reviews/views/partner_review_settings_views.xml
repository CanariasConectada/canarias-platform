<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_review_settings_form" model="ir.ui.view">
        <field name="name">partner.review.settings.form</field>
        <field name="model">partner.review.settings</field>
        <field name="arch" type="xml">
            <form string="Configuración de Reseñas">
                <sheet>
                    <group>
                        <field name="permitir_comentarios"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_partner_review_settings" model="ir.actions.act_window">
        <field name="name">Configuración de Reseñas</field>
        <field name="res_model">partner.review.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
