<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_review_rating_list" model="ir.ui.view">
        <field name="name">partner.review.rating.list</field>
        <field name="model">partner.review.rating</field>
        <field name="arch" type="xml">
            <list string="Valoraciones">
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="rating"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_partner_review_rating_form" model="ir.ui.view">
        <field name="name">partner.review.rating.form</field>
        <field name="model">partner.review.rating</field>
        <field name="arch" type="xml">
            <form string="Valoración">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="user_id"/>
                        <field name="rating"/>
                        <field name="create_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_partner_review_rating_search" model="ir.ui.view">
        <field name="name">partner.review.rating.search</field>
        <field name="model">partner.review.rating</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter string="5 estrellas" name="rating_5" domain="[('rating', '=', 5)]"/>
                <filter string="4 estrellas" name="rating_4" domain="[('rating', '=', 4)]"/>
                <filter string="3 estrellas" name="rating_3" domain="[('rating', '=', 3)]"/>
                <filter string="2 estrellas" name="rating_2" domain="[('rating', '=', 2)]"/>
                <filter string="1 estrella" name="rating_1" domain="[('rating', '=', 1)]"/>
            </search>
        </field>
    </record>

    <record id="action_partner_review_rating" model="ir.actions.act_window">
        <field name="name">Valoraciones</field>
        <field name="res_model">partner.review.rating</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
