<odoo>

    <record id="privilege_partner_reviews" model="res.groups.privilege">
        <field name="name">Merchant Reviews</field>
    </record>

    <record id="group_partner_reviews_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_partner_reviews"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_partner_reviews_moderator" model="res.groups">
        <field name="name">Moderator</field>
        <field name="privilege_id" ref="privilege_partner_reviews"/>
        <field name="implied_ids" eval="[(4, ref('group_partner_reviews_user'))]"/>
    </record>

    <record id="group_partner_reviews_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_partner_reviews"/>
        <field name="implied_ids" eval="[(4, ref('group_partner_reviews_moderator'))]"/>
    </record>

</odoo>
