<odoo>

    <record id="discuss_channel_pending_message_view_list" model="ir.ui.view">
        <field name="name">discuss.channel.pending.message.list</field>
        <field name="model">discuss.channel.pending.message</field>
        <field name="arch" type="xml">
            <!-- create/delete disabled: held messages are history, they are
                 decided, never authored or erased from the backend. -->
            <list create="0" delete="0"
                  decoration-muted="state == 'rejected'"
                  decoration-success="state == 'approved'">
                <field name="create_date" string="Received"/>
                <field name="channel_id"/>
                <field name="author_name"/>
                <field name="body"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <button name="action_approve" type="object" string="Approve"
                        icon="fa-check" class="text-success"
                        invisible="state != 'pending'"/>
                <button name="action_reject" type="object" string="Reject"
                        icon="fa-times" class="text-danger"
                        invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="discuss_channel_pending_message_view_form" model="ir.ui.view">
        <field name="name">discuss.channel.pending.message.form</field>
        <field name="model">discuss.channel.pending.message</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-secondary" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group string="Origin">
                            <field name="channel_id" readonly="1"/>
                            <field name="author_name" readonly="1"/>
                            <field name="guest_id" readonly="1" invisible="not guest_id"/>
                            <field name="partner_id" readonly="1" invisible="not partner_id"/>
                            <field name="create_date" string="Received" readonly="1"/>
                            <field name="parent_id" readonly="1" invisible="not parent_id"/>
                        </group>
                        <group string="Decision">
                            <field name="moderator_id" readonly="1"/>
                            <field name="moderation_date" readonly="1"/>
                            <!-- Visible only once it happened: on a row decided
                                 in time it would be a permanently empty field
                                 saying nothing. -->
                            <field name="late_alert_date" readonly="1"
                                   invisible="not late_alert_date"/>
                            <field name="message_id" readonly="1"
                                   invisible="state != 'approved'"/>
                            <field name="rejection_reason"
                                   readonly="state != 'pending'"
                                   placeholder="Explain the rejection to the author..."/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="body" nolabel="1" readonly="1"/>
                        <field name="attachment_ids" nolabel="1" readonly="1"
                               widget="many2many_binary"/>
                    </group>
                    <field name="moderation_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="discuss_channel_pending_message_view_search" model="ir.ui.view">
        <field name="name">discuss.channel.pending.message.search</field>
        <field name="model">discuss.channel.pending.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="author_name"/>
                <field name="body"/>
                <field name="channel_id"/>
                <filter name="filter_pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <!-- "Which ones already cost somebody an email" is the question
                     an administrator asks when the queue is not being emptied. -->
                <filter name="filter_escalated" string="Escalated"
                        domain="[('late_alert_date', '!=', False)]"/>
                <group>
                    <filter name="group_by_channel" string="Channel"
                            context="{'group_by': 'channel_id'}"/>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pending_message" model="ir.actions.act_window">
        <field name="name">Pending Messages</field>
        <field name="res_model">discuss.channel.pending.message</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="context">{'search_default_group_by_channel': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                The queue is empty
            </p>
            <p>
                Comments held on the channels you moderate show up here. Until
                you approve one, it is not a message: nobody but its author can
                see it.
            </p>
        </field>
    </record>

    <record id="action_moderation_history" model="ir.actions.act_window">
        <field name="name">Moderation History</field>
        <field name="res_model">discuss.channel.pending.message</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>

</odoo>
