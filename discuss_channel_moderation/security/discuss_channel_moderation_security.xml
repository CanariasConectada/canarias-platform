<odoo>

    <record id="privilege_discuss_channel_moderation" model="res.groups.privilege">
        <field name="name">Channel Moderation</field>
    </record>

    <!-- Moderator: sees and decides the queue of the channels they are listed
         on, and nothing else. Implies base.group_user because the queue is a
         backend tool; portal and public users get NO group here on purpose. -->
    <record id="group_moderation_user" model="res.groups">
        <field name="name">Moderator</field>
        <field name="privilege_id" ref="privilege_discuss_channel_moderation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Administrator: configures moderation and sees every queue. -->
    <record id="group_moderation_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_discuss_channel_moderation"/>
        <field name="implied_ids" eval="[(4, ref('group_moderation_user'))]"/>
    </record>

</odoo>
