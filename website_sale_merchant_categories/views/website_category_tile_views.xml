<odoo>

    <!-- The merchant's screen, and the only one for the shop's categories:
         one row per category of THEIR shop, own first, then the shared ones
         their products use. The rows are kept in step by
         `website._wsmc_sync_category_rows` when the screen is opened. Every
         row takes an image and a label for this shop; an OWN row is also
         renamed and deleted right here (the category's record rules still
         decide on the server), a shared row is neither. No row is added by
         hand (`create="0"`): the sync lists every category already, and a
         new own category arrives as a row of its own. The header button
         re-reads the shop from the action context and asserts ownership on
         the server (see `_wsmc_website_from_context`). -->
    <record id="website_category_tile_view_list" model="ir.ui.view">
        <field name="name">website.category.tile.list</field>
        <field name="model">website.category.tile</field>
        <field name="arch" type="xml">
            <list string="Shop categories" editable="bottom" create="0">
                <header>
                    <button name="action_new_own_category" type="object"
                            string="New own category" display="always"
                            class="btn-secondary"/>
                </header>
                <field name="website_id" column_invisible="not context.get('group_by')"/>
                <field name="allowed_category_ids" column_invisible="1"/>
                <field name="category_id"
                       domain="[('id', 'in', allowed_category_ids)]"
                       readonly="1"
                       column_invisible="1"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="category_name" string="Name"
                       readonly="category_type != 'own'"/>
                <field name="category_type"/>
                <field name="image" widget="image" options="{'size': [80, 80]}"/>
                <field name="name" optional="show"/>
                <button name="action_delete_own_category" type="object"
                        title="Delete category" icon="fa-trash"
                        invisible="category_type != 'own'"
                        confirm="Delete this category? The products that use it will no longer have it."/>
            </list>
        </field>
    </record>

    <record id="website_category_tile_view_form" model="ir.ui.view">
        <field name="name">website.category.tile.form</field>
        <field name="model">website.category.tile</field>
        <field name="arch" type="xml">
            <form string="Shop category">
                <sheet>
                    <group>
                        <group>
                            <field name="website_id" readonly="1" force_save="1"/>
                            <field name="allowed_category_ids" invisible="1"/>
                            <field name="category_id"
                                   domain="[('id', 'in', allowed_category_ids)]"
                                   readonly="id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="category_type"/>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="image" widget="image" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <p class="text-muted">The image only changes in your shop; the shared category stays the same for the other shops.</p>
                </sheet>
            </form>
        </field>
    </record>

    <!-- A server action rather than a window action, because the right
         screen depends on who clicked (see `action_open_shop_categories`).
         Any internal user may run it: the code resolves the shop from the
         account, so nothing but the caller's own is ever opened. -->
    <record id="action_open_shop_categories" model="ir.actions.server">
        <field name="name">Shop categories</field>
        <field name="model_id" ref="model_website_category_tile"/>
        <field name="state">code</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="code">action = model.action_open_shop_categories()</field>
    </record>

    <!-- The shared eCommerce categories screen (Website > eCommerce >
         Products > eCommerce Categories) ships with no gate, so a merchant
         landed on a form of a category shared by every shop, changed its
         cover and got "Error de acceso" on save (2026-09-16). Merchants curate
         their shop in "Shop categories"; the shared screen stays with the
         people who may edit shared categories. Owned in replace form so a
         core update cannot reopen it. -->
    <record id="website_sale.menu_catalog_categories" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('base.group_system'),
            ref('website.group_website_designer'),
            ref('sales_team.group_sale_manager'),
        ])]"/>
    </record>

    <!-- Website > Configuration, next to "My shops" and "Page content",
         which is where a merchant already works on their site. -->
    <menuitem id="menu_shop_categories"
              name="Shop categories"
              parent="website.menu_website_configuration"
              action="action_open_shop_categories"
              groups="website.group_website_restricted_editor"
              sequence="5"/>

</odoo>
