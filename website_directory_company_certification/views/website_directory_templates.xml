<odoo>
    <!-- Reusable badge strip: one pill per seal in force. Expects `entry`. -->
    <template id="directory_certification_badges" name="Directory Certification Badges">
        <t t-foreach="entry.company_id.sudo()._get_valid_certifications()" t-as="cert">
            <span t-attf-class="badge rounded-pill ms-1 {{
                    {'bronze': 'text-bg-info',
                     'silver': 'text-bg-secondary',
                     'gold': 'text-bg-warning'}.get(cert.level, 'text-bg-light')
                }}"
                  t-attf-title="{{ cert.type_id.name }}: {{ cert._get_level_label() }}">
                <i class="fa fa-certificate me-1"/>
                <t t-esc="cert.type_id.name"/>
            </span>
        </t>
    </template>

    <!-- Grid card badge. -->
    <template id="directory_entry_card_certification" inherit_id="website_directory.directory_entry_card">
        <xpath expr="//h5[@class='card-title mb-1 fs-6']" position="after">
            <t t-call="website_directory_company_certification.directory_certification_badges"/>
        </xpath>
    </template>

    <!-- List row badge. -->
    <template id="directory_entry_list_item_certification" inherit_id="website_directory.directory_entry_list_item">
        <xpath expr="//h5[@class='mb-0 fs-6']" position="after">
            <t t-call="website_directory_company_certification.directory_certification_badges"/>
        </xpath>
    </template>

    <!-- Sidebar filter card in the extension hook. -->
    <template id="directory_sidebar_certification" inherit_id="website_directory.directory_sidebar_extra">
        <xpath expr="//div[@id='o_wd_sidebar_extra']" position="inside">
            <div t-if="certification_types" class="card border-0 shadow-sm mb-3 o_wdcc_filter">
                <div class="card-body">
                    <h6 class="card-title fw-bold mb-3">
                        <i class="fa fa-certificate me-2"/>Certifications
                    </h6>
                    <!-- The selected seal is the directory's shared chip
                         (`website_directory.directory_filter_chip`), so its
                         cross is the same control the zone, the category and
                         the facilities now carry. This card is where that
                         cross came from: it was the only deselect affordance
                         a visitor ever noticed (reported 2026-09-05), which
                         is why the others were made to match it. -->
                    <div class="d-flex flex-column gap-2">
                        <t t-foreach="certification_types" t-as="cert_type">
                            <t t-if="selected_certification == cert_type.code"
                               t-call="website_directory.directory_filter_chip">
                                <t t-set="remove_url" t-value="certification_urls.get(cert_type.code)"/>
                                <t t-set="remove_label" t-value="cert_type.name"/>
                                <t t-set="chip_class" t-value="'btn btn-sm btn-primary text-start d-flex align-items-center justify-content-between'"/>
                                <t t-esc="cert_type.name"/>
                            </t>
                            <a t-else=""
                               t-att-href="certification_urls.get(cert_type.code)"
                               class="wd-filter-link btn btn-sm btn-outline-secondary text-start d-flex align-items-center justify-content-between">
                                <t t-esc="cert_type.name"/>
                            </a>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Top active-filters summary chip. -->
    <template id="directory_active_filters_certification" inherit_id="website_directory.directory_active_filters_extra">
        <xpath expr="//span[@id='o_wd_active_filters_extra']" position="inside">
            <t t-if="selected_certification">
                <t t-set="selected_certification_type"
                   t-value="request.env['certification.type'].sudo().search([('code', '=', selected_certification)], limit=1)"/>
                <t t-if="selected_certification_type" t-call="website_directory.directory_filter_chip">
                    <t t-set="remove_url" t-value="certification_urls.get(selected_certification)"/>
                    <t t-set="remove_label" t-value="selected_certification_type.name"/>
                    <t t-set="chip_class" t-value="'badge bg-primary wd-filter-chip d-inline-flex align-items-center'"/>
                    <i class="fa fa-certificate me-1"/>
                    <t t-esc="remove_label"/>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
