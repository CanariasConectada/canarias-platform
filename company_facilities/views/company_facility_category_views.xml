<odoo>

    <record id="view_company_facility_category_list" model="ir.ui.view">
        <field name="name">company.facility.category.list</field>
        <field name="model">company.facility.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon" placeholder="fa-wheelchair"/>
                <field name="facility_count" string="Items"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_company_facility_category_form" model="ir.ui.view">
        <field name="name">company.facility.category.form</field>
        <field name="model">company.facility.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Accessibility"/></h1>
                    </div>
                    <group>
                        <field name="icon" placeholder="fa-wheelchair"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="facility_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="icon" placeholder="fa-wifi"/>
                                    <field name="description" optional="show"/>
                                    <field name="active" widget="boolean_toggle"
                                           optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_company_facility_category_search" model="ir.ui.view">
        <field name="name">company.facility.category.search</field>
        <field name="model">company.facility.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_company_facility_category" model="ir.actions.act_window">
        <field name="name">Subdivisions</field>
        <field name="res_model">company.facility.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a subdivision</p>
            <p>
                A subdivision groups what a shop offers — accessibility,
                payment, parking — so a microsite shows four short lists
                instead of one long row of icons.
            </p>
        </field>
    </record>

</odoo>
