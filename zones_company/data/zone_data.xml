<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Datos iniciales - Solo se crean en la instalación, no en actualizaciones -->
    <record id="zone_north" model="zone">
        <field name="name">Guanarteme</field>
        <field name="code">GUA</field>
        <field name="description">Zona de Guanarteme.</field>
        <field name="sequence">10</field>
    </record>

    <record id="zone_tamaraceite" model="zone">
        <field name="name">Tamaraceite</field>
        <field name="code">TAM</field>
        <field name="description">Zona de Tamaraceite.</field>
        <field name="sequence">20</field>
    </record>

    <record id="zone_lomo_frailes" model="zone">
        <field name="name">Lomo los Frailes</field>
        <field name="code">LOM</field>
        <field name="description">Zona de Lomo los Frailes.</field>
        <field name="sequence">30</field>
    </record>

    <record id="zone_none" model="zone">
        <field name="name">Ninguna</field>
        <field name="code">NIN</field>
        <field name="description">Sin zona asignada.</field>
        <field name="sequence">999</field>
    </record>
</odoo>
