<odoo>
    <data noupdate="0">
        <record id="res_groups_privilege_certification" model="res.groups.privilege">
            <field name="name">Company Certification</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="base.module_category_marketing"/>
        </record>

        <!-- Base group shared by every vertical: carries the ACLs. It is
             never assigned directly; each vertical's user group implies it.
             Plain internal users are NOT in it: they see nothing. -->
        <record id="group_certification_user" model="res.groups">
            <field name="name">Certification User (base)</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_certification"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_certification_manager" model="res.groups">
            <field name="name">Certification Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_certification"/>
            <field name="implied_ids" eval="[(4, ref('group_certification_user')), (4, ref('survey.group_survey_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- Users only see real evaluations of their own companies, and only
             for the verticals whose user group they belong to. -->
        <record id="survey_user_input_rule_certification_user" model="ir.rule">
            <field name="name">Certification: user sees own companies' evaluations of own verticals</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="domain_force">[
                ('certification_type_id', '!=', False),
                ('certification_type_id.group_user_id', 'in', user.all_group_ids.ids),
                ('company_id', 'in', user.company_ids.ids),
                ('test_entry', '=', False),
            ]</field>
            <field name="groups" eval="[(4, ref('group_certification_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Vertical managers see every evaluation of the verticals they
             manage; the generic manager group sees them all. -->
        <record id="survey_user_input_rule_certification_manager" model="ir.rule">
            <field name="name">Certification: manager sees managed verticals' evaluations</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="domain_force">[
                ('certification_type_id', '!=', False),
                '|',
                ('certification_type_id.group_manager_id', 'in', user.all_group_ids.ids),
                ('certification_type_id.group_manager_id', '=', False),
            ]</field>
            <field name="groups" eval="[(4, ref('group_certification_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Users only read the active questionnaires of their verticals. -->
        <record id="survey_survey_rule_certification_user" model="ir.rule">
            <field name="name">Certification: user reads own verticals' questionnaires</field>
            <field name="model_id" ref="survey.model_survey_survey"/>
            <field name="domain_force">[
                ('certification_type_id', '!=', False),
                ('certification_type_id.group_user_id', 'in', user.all_group_ids.ids),
                ('active', '=', True),
            ]</field>
            <field name="groups" eval="[(4, ref('group_certification_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
