<odoo>
    <!-- ============================================================ -->
    <!-- Friendly pages for the /certification/<code>/start route     -->
    <!-- ============================================================ -->
    <template id="certification_no_company" name="Certification - No Company">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="alert alert-warning">
                    <h4>No company assigned</h4>
                    <p>You need a company on your user profile to run a
                       certification evaluation.</p>
                    <a href="javascript:window.close()" class="btn btn-primary">Back</a>
                </div>
            </div>
        </t>
    </template>

    <template id="certification_cooldown" name="Certification - Cooldown">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="alert alert-info">
                    <h4>Evaluation not available yet</h4>
                    <p>Your company already ran a recent
                       <t t-esc="cert_type.name"/> evaluation.</p>
                    <p>You can run a new one from:
                       <strong t-esc="next_date"/></p>
                    <a href="javascript:window.close()" class="btn btn-primary">Back</a>
                </div>
            </div>
        </t>
    </template>

    <template id="certification_error" name="Certification - Error">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="alert alert-danger">
                    <h4>Could not start the evaluation</h4>
                    <p t-esc="error"/>
                    <a href="javascript:window.close()" class="btn btn-primary">Back</a>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Public landing page: /certification/<code>                   -->
    <!-- ============================================================ -->
    <template id="certification_landing" name="Certification - Landing Page">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="cert_type.website_title or cert_type.name"/>
            <div id="wrap" class="oe_structure o_cc_landing">
                <!-- Hero: gradient band with the vertical's title, lead and seal.
                     Same treatment as the Lugares de Interes / Memoria Viva heros. -->
                <section class="o_cc_landing_hero">
                    <div class="container">
                        <div class="row align-items-center g-4">
                            <div class="col-lg-8 text-center text-lg-start">
                                <h1 class="o_cc_landing_hero__title display-4 fw-bold mb-3"
                                    t-out="cert_type.website_title or cert_type.name"/>
                                <p t-if="cert_type.website_description"
                                   class="o_cc_landing_hero__lead lead mb-0"
                                   t-out="cert_type.website_description"/>
                            </div>
                            <div class="col-lg-4 text-center"
                                 t-if="cert_type.badge_image">
                                <img class="o_cc_landing_hero__badge img-fluid"
                                     t-attf-src="/certification/{{ cert_type.code }}/badge"
                                     t-att-alt="cert_type.name"
                                     loading="lazy"/>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Descriptive rich text (optional, per vertical). -->
                <section t-if="cert_type.landing_description"
                         class="o_cc_landing_section py-5">
                    <div class="container">
                        <div class="o_cc_landing_richtext mx-auto"
                             t-out="cert_type.landing_description"/>
                    </div>
                </section>

                <!-- Who holds the seal: sidebar filter + card grid, the same
                     shape as the Lugares de Interes / Memoria Viva index.
                     Without it the page explains a seal and never shows a
                     single business wearing one. -->
                <section t-if="holders or level" class="o_cc_landing_section o_cc_holders py-5">
                    <div class="container">
                        <div class="row">
                            <aside class="col-12 col-lg-3 mb-4">
                                <h2 class="o_cc_landing_section__title h5 mb-3">Nivel del sello</h2>
                                <div class="list-group">
                                    <a t-att-href="base_url"
                                       t-attf-class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ '' if level else 'active' }}">
                                        <span>Todos</span>
                                        <span class="badge text-bg-secondary rounded-pill"
                                              t-out="sum(level_counts.values())"/>
                                    </a>
                                    <t t-foreach="['gold', 'silver', 'bronze']" t-as="level_code">
                                        <a t-if="level_counts.get(level_code)"
                                           t-attf-href="{{ base_url }}?level={{ level_code }}"
                                           t-attf-class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ 'active' if level == level_code else '' }}">
                                            <span>
                                                <i t-attf-class="fa fa-certificate me-2 o_cc_level_dot o_cc_level_dot--{{ level_code }}"
                                                   aria-hidden="true"/>
                                                <t t-out="{'gold': 'Oro', 'silver': 'Plata', 'bronze': 'Bronce'}.get(level_code)"/>
                                            </span>
                                            <span class="badge text-bg-secondary rounded-pill"
                                                  t-out="level_counts.get(level_code)"/>
                                        </a>
                                    </t>
                                </div>
                            </aside>
                            <div class="col-12 col-lg-9">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h2 class="o_cc_landing_section__title h5 mb-0">Comercios certificados</h2>
                                    <span class="text-muted">
                                        <t t-out="len(holders)"/> resultados
                                    </span>
                                </div>
                                <div t-if="holders" class="row g-3">
                                    <div t-foreach="holders" t-as="holder"
                                         class="col-6 col-md-4 col-xl-3">
                                        <a t-att-href="holder['url']"
                                           class="o_cc_holder_card card h-100 border-0 shadow-sm text-decoration-none">
                                            <div class="o_cc_holder_card__imgwrap">
                                                <img t-if="holder['logo']"
                                                     t-attf-src="/web/image/res.company/{{ holder['company_id'] }}/logo"
                                                     class="o_cc_holder_card__img"
                                                     t-att-alt="holder['name']"
                                                     loading="lazy"/>
                                                <span t-else="" class="o_cc_holder_card__placeholder">
                                                    <i class="fa fa-shopping-bag" aria-hidden="true"/>
                                                </span>
                                                <span t-attf-class="badge o_cc_holder_card__level o_cc_holder_card__level--{{ holder['level'] }}"
                                                      t-out="holder['level_label']"/>
                                            </div>
                                            <div class="card-body">
                                                <span class="o_cc_holder_card__name d-block fw-bold"
                                                      t-out="holder['name']"/>
                                                <small class="text-muted">
                                                    <t t-out="holder['score']"/>% de cumplimiento
                                                </small>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                                <div t-else="" class="alert alert-info mb-0">
                                    Todavía no hay comercios con este nivel.
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Training material as a lift-on-hover card grid. -->
                <section t-if="materials"
                         class="o_cc_landing_section o_cc_landing_materials py-5">
                    <div class="container">
                        <h2 class="o_cc_landing_section__title text-center mb-5">Material formativo</h2>
                        <div class="row g-4">
                            <t t-foreach="materials" t-as="material"
                               t-att-key="material.id">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <a t-att-href="material.download_url"
                                       download="download"
                                       class="o_cc_landing_card card h-100 border-0 shadow-sm text-decoration-none">
                                        <div class="card-body d-flex align-items-start gap-3">
                                            <span class="o_cc_landing_card__icon">
                                                <i class="fa fa-file-pdf-o" aria-hidden="true"/>
                                            </span>
                                            <span class="flex-grow-1">
                                                <span class="o_cc_landing_card__title d-block fw-bold"
                                                      t-out="material.name"/>
                                                <small t-if="material.description"
                                                       class="o_cc_landing_card__desc d-block text-muted mt-1"
                                                       t-out="material.description"/>
                                            </span>
                                            <i class="fa fa-download o_cc_landing_card__dl align-self-center"
                                               aria-hidden="true"/>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Survey flow tweaks for certification questionnaires          -->
    <!-- ============================================================ -->

    <!-- No retake button: retries are ruled by the cooldown, not the user. -->
    <template id="survey_button_retake_certification" inherit_id="survey.survey_button_retake">
        <xpath expr="//div[@class='d-print-none']" position="attributes">
            <attribute name="t-if">not survey.certification_type_id and not answer.is_session_answer and not (survey.certification and answer.scoring_success)</attribute>
        </xpath>
    </template>

    <!-- Result panel on the survey completion page.
         SINGLE source of truth for every certification (Silver, Sostenibilidad
         and any future one). The vertical modules used to add their OWN seal
         block on top of this one, which doubled the panel and the buttons and
         mixed English with Spanish; they no longer do — this renders the seal
         once, in Spanish, keyed on the generic certification type. -->
    <template id="survey_fill_form_done_certification" inherit_id="survey.survey_fill_form_done">
        <xpath expr="//div[@class='o_survey_finished mt32 mb32']" position="inside">
            <t t-set="cert_type" t-value="survey.certification_type_id"/>
            <t t-set="cc_medal" t-value="{'bronze': '🥉', 'silver': '🥈', 'gold': '🥇'}"/>
            <t t-if="cert_type and answer.certification_level != 'none'">
                <div class="o_cc_seal card border-0 shadow-sm mt-4 mx-auto" style="max-width:34rem;background:#e9f5ee;">
                    <div class="card-body text-center p-4">
                        <h3 class="fw-bold mb-3" style="color:#1e6b3f;">
                            🎉 ¡Felicidades! Tu empresa ha obtenido el sello <t t-esc="cert_type.name"/>
                        </h3>
                        <span class="badge rounded-pill px-4 py-2 fs-5" style="background:#f6e9b8;color:#7a5c00;">
                            <t t-esc="cc_medal.get(answer.certification_level, '')"/>
                            <t t-esc="answer._get_certification_level_label()"/>
                        </span>
                        <p class="mt-3 mb-1">
                            Puntuación: <strong t-esc="answer.scoring_total"/> /
                            <t t-esc="cert_type.max_score"/> puntos
                            (<t t-esc="answer.scoring_percentage"/>%)
                        </p>
                        <p class="text-muted mb-0">
                            El sello es válido hasta: <strong t-esc="answer.expiry_date"/>
                        </p>
                    </div>
                </div>
            </t>
            <t t-if="cert_type and answer.certification_level == 'none'">
                <div class="o_cc_seal card border-0 shadow-sm mt-4 mx-auto" style="max-width:34rem;">
                    <div class="card-body text-center p-4">
                        <h4 class="fw-bold mb-2">Resultado de la evaluación</h4>
                        <p class="mb-1">
                            Puntuación: <strong t-esc="answer.scoring_total"/> /
                            <t t-esc="cert_type.max_score"/> puntos
                            (<t t-esc="answer.scoring_percentage"/>%)
                        </p>
                        <p class="mb-1">En esta ocasión no has alcanzado el nivel mínimo para el sello
                           <t t-esc="cert_type.name"/>.</p>
                        <p class="text-muted mb-0">Podrás volver a intentarlo a partir del:
                           <strong t-esc="answer.next_attempt_date"/></p>
                    </div>
                </div>
            </t>
            <!-- Improvement recommendations. -->
            <t t-if="cert_type">
                <t t-set="weak_lines" t-value="answer.user_input_line_ids.filtered(lambda l: l.question_id.comments_allowed and l.answer_score &lt; cert_type.question_full_score and l.question_id.comments_message)"/>
                <div t-if="weak_lines" class="mt-4 mx-auto" style="max-width:34rem;">
                    <h5 class="fw-bold mb-3">
                        <i class="fa fa-lightbulb-o text-warning me-2"/>Recomendaciones para mejorar
                    </h5>
                    <div class="row">
                        <t t-foreach="weak_lines" t-as="line">
                            <div class="col-12 col-md-6 mb-3">
                                <div class="card h-100 border-start border-warning border-3">
                                    <div class="card-body">
                                        <h6 class="card-title text-muted mb-2" t-esc="line.question_id.title"/>
                                        <p class="card-text small text-secondary fst-italic">
                                            <i class="fa fa-arrow-right text-warning me-1"/>
                                            <t t-esc="line.question_id.comments_message"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[contains(@class, 'o_survey_finished')]//div[contains(@class, 'd-flex') and contains(@class, 'gap-3')]" position="inside">
            <a t-if="survey.certification_type_id" role="button"
               class="btn btn-outline-secondary btn-lg"
               href="javascript:window.close()">
                <i class="fa fa-times"/> Cerrar
            </a>
        </xpath>
        <!-- On a certification survey, hide the raw Odoo score ("You scored
             X%") and the "Review your answers" button: the seal card below
             already shows the score in a readable way, and the certification
             is not a quiz the user re-reads. Keeps the survey title. -->
        <xpath expr="//h1[hasclass('fs-2')]" position="attributes">
            <attribute name="t-if">not survey.certification_type_id</attribute>
        </xpath>
        <xpath expr="//a[hasclass('o_survey_review')]" position="attributes">
            <attribute name="t-att-class">'o_survey_review btn btn-secondary btn-lg' + (' d-none' if survey.certification_type_id else '')</attribute>
        </xpath>
    </template>

    <!-- Show the question's comment message as a fixed recommendation
         instead of a free comment box on certification questionnaires. -->
    <template id="question_simple_choice_certification" inherit_id="survey.question_simple_choice">
        <xpath expr="//div[@t-if='question.comments_allowed and not question.comment_count_as_answer']" position="replace">
            <div t-if="question.comments_allowed and not question.comment_count_as_answer"
                 class="mb-2 o_survey_comment_container mt-3">
                <t t-if="survey.certification_type_id and not answer.test_entry">
                    <div class="alert alert-light border mt-2 p-2">
                        <i class="fa fa-lightbulb-o text-warning me-2"/>
                        <strong>Recommendation:</strong>
                        <span t-out="question.comments_message"/>
                    </div>
                </t>
                <t t-else="">
                    <textarea type="text" class="col form-control o_survey_comment o_survey_question_text_box bg-transparent rounded-0 p-0"
                        t-att-placeholder="question.comments_message or default_comments_message if not survey_form_readonly else ''"><t t-esc="comment_line.value_char_box if comment_line else ''"/></textarea>
                </t>
            </div>
        </xpath>
    </template>

    <template id="question_multiple_choice_certification" inherit_id="survey.question_multiple_choice">
        <xpath expr="//div[@t-if='question.comments_allowed and not question.comment_count_as_answer']" position="replace">
            <div t-if="question.comments_allowed and not question.comment_count_as_answer"
                 class="mb-2 o_survey_comment_container mt-3">
                <t t-if="survey.certification_type_id and not answer.test_entry">
                    <div class="alert alert-light border mt-2 p-2">
                        <i class="fa fa-lightbulb-o text-warning me-2"/>
                        <strong>Recommendation:</strong>
                        <span t-out="question.comments_message"/>
                    </div>
                </t>
                <t t-else="">
                    <textarea type="text" class="col form-control o_survey_comment o_survey_question_text_box bg-transparent rounded-0 p-0"
                        t-att-placeholder="question.comments_message or default_comments_message if not survey_form_readonly else ''"><t t-esc="comment_line.value_char_box if comment_line else ''"/></textarea>
                </t>
            </div>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Microsite: certification section above the footer            -->
    <!-- ============================================================ -->

    <!-- Do not show the section while filling a survey. -->
    <template id="survey_page_fill_suppress_certification" inherit_id="survey.survey_page_fill">
        <xpath expr="//t[@t-call='survey.layout']" position="before">
            <t t-set="suppress_certification_section" t-value="True"/>
        </xpath>
    </template>

    <template id="certification_microsite_section" inherit_id="website.layout" name="Certification - Microsite Section">
        <xpath expr="//footer[@id='bottom']" position="before">
            <t t-set="cc_company" t-value="website.company_id"/>
            <t t-set="cc_is_homepage" t-value="request.httprequest.path == (website.homepage_url or '/')"/>
            <!-- Only resolve the (sudo + filtered) certifications on the
                 homepage, where the section is actually rendered. -->
            <t t-set="cc_certifications" t-value="cc_company._get_valid_certifications() if (cc_is_homepage and not suppress_certification_section) else []"/>
            <section t-if="cc_is_homepage and cc_certifications and not suppress_certification_section"
                     class="o_cc o_cc2 pt32 pb32 o_colored_level">
                <div class="container">
                    <t t-foreach="cc_certifications" t-as="cert">
                        <t t-set="cert_type" t-value="cert.type_id"/>
                        <t t-set="bar_color" t-value="{'gold': '#FFD700', 'silver': '#C0C0C0', 'bronze': '#CD7F32'}.get(cert.level, '#6c757d')"/>
                        <div class="row align-items-center mb-5">
                            <div class="col-lg-6 text-center mb-4 mb-lg-0">
                                <!-- A URL, not image_data_uri: the seal is a
                                     258 KB PNG and inlining it put that in
                                     the HTML of every microsite homepage,
                                     uncached and re-sent on every view. -->
                                <img t-if="cert_type.badge_image"
                                     t-attf-src="/certification/{{ cert_type.code }}/badge"
                                     t-att-alt="cert_type.name"
                                     class="img-fluid"
                                     style="max-width: 280px; height: auto; object-fit: contain;"
                                     loading="lazy"/>
                            </div>
                            <div class="col-lg-6">
                                <div class="d-flex align-items-center justify-content-center mb-3">
                                    <span class="badge rounded-pill px-4 py-2 fw-bold"
                                          t-attf-style="background-color: {{ bar_color }}; color: {{ '#212529' if cert.level in ('gold', 'silver') else '#fff' }}; font-size: 1rem;"
                                          t-esc="cert._get_level_label()"/>
                                    <div t-attf-style="width: 3px; height: 60px; background-color: {{ bar_color }}; margin: 0 20px; opacity: 0.6;"/>
                                    <div class="display-3 fw-bold" t-attf-style="color: {{ bar_color }}; line-height: 1;">
                                        <t t-esc="int(cert.score)"/>%
                                    </div>
                                </div>
                                <h3 class="fw-bold text-center mb-3" style="font-size: 1.5rem;"
                                    t-esc="cert_type.website_title or cert_type.name"/>
                                <p class="text-center text-muted"
                                   style="font-size: 0.95rem; line-height: 1.6;"
                                   t-esc="cert_type.website_description"/>
                            </div>
                        </div>
                        <!-- What the seal means, as an icon grid: the pattern
                             a visitor already knows from a lodging site's
                             "what this place offers". A centered single
                             column made ten short items read as one long
                             sentence; a grid lets the eye scan icons. -->
                        <t t-set="amenities" t-value="cc_company._get_certification_amenities(cert_type)"/>
                        <div class="row" t-if="amenities">
                            <div class="col-12">
                                <h4 class="o_cc_amenities__title h5 fw-bold mb-4"
                                    t-out="cert_type.amenities_title or 'Lo que ofrece este comercio'"/>
                                <div class="row g-3 o_cc_amenities mb-4">
                                    <div t-foreach="amenities" t-as="item"
                                         class="col-12 col-sm-6 col-lg-4">
                                        <div class="o_cc_amenity d-flex align-items-start gap-3">
                                            <i t-attf-class="fa {{ item['icon'] }} o_cc_amenity__icon"
                                               t-attf-style="color: {{ bar_color }};"
                                               aria-hidden="true"/>
                                            <span>
                                                <span class="o_cc_amenity__label d-block"
                                                      t-out="item['label']"/>
                                                <small t-if="item.get('description')"
                                                       class="o_cc_amenity__desc d-block text-muted"
                                                       t-out="item['description']"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
