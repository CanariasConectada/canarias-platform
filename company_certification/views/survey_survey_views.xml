<odoo>
    <record id="survey_survey_view_form_certification" model="ir.ui.view">
        <field name="name">survey.survey.form.certification</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Company Certification" name="company_certification"
                      groups="company_certification.group_certification_manager">
                    <group>
                        <field name="certification_type_id"/>
                    </group>
                    <!-- The per-question "positive items" that used to be
                         edited here are deprecated: the items shown on the
                         microsite and the answers that trigger them are
                         edited on the certification type now. -->
                    <p class="text-muted">
                        The items shown on the microsite, and the answers that
                        make them appear, are edited on the certification type
                        (Items shown on microsite tab).
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
