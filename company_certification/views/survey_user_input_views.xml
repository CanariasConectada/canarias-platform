<odoo>
    <!-- One list for every seal, grouped by which seal it is. The same shape
         `website_local_content` uses for its Items: a single list of
         everything, with the vertical as a group-by rather than as a separate
         menu per vertical. A seal is a `certification.type` record here for
         exactly the reason a content type is one there, so the two lists can
         be read the same way.

         The group-by is what makes one list better than two rather than just
         shorter: the seals stay visually separated, and a merchant who holds
         both sees them side by side instead of having to remember which menu
         held which. -->
    <record id="survey_user_input_view_search_certification" model="ir.ui.view">
        <field name="name">survey.user_input.search.certification</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="group_by_certification_type"
                        string="Sello"
                        context="{'group_by': 'certification_type_id'}"/>
                <filter name="group_by_certification_company"
                        string="Comercio"
                        context="{'group_by': 'company_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="survey_user_input_view_list_certification" model="ir.ui.view">
        <field name="name">survey.user_input.list.certification</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_tree"/>
        <field name="arch" type="xml">
            <!-- The way in, next to the list it fills. The menu entry exists
                 too, but somebody who is already looking at their evaluations
                 and wants another one should not have to go back to the menu
                 to find out that starting one is possible. Gated on
                 `certification_display` because this list view is core's and
                 is reached from Surveys as well, where the button would open
                 a dialog about seals to somebody reading a satisfaction
                 questionnaire.

                 `display="always"` is what puts it in the control panel beside
                 where "New" would be. Without it the list renderer files a
                 header button under the bar that only appears once rows are
                 ticked (`list_controller.xml`: the always-buttons slot tests
                 `button.display === 'always'`), so on a screen opened with
                 nothing selected there was no visible way in at all, which
                 is exactly how this list has been shipping. -->
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(company_certification.action_certification_evaluation_start)d"
                            type="action"
                            string="New Evaluation"
                            class="btn-primary"
                            display="always"
                            invisible="not context.get('certification_display')"/>
                </header>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-info">certification_level == 'bronze'</attribute>
                <attribute name="decoration-primary">certification_level == 'silver'</attribute>
                <attribute name="decoration-warning">certification_level == 'gold'</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <button name="action_continue_certification_evaluation" type="object"
                        icon="fa-play" title="Continue evaluation"
                        invisible="state not in ('new', 'in_progress') or not context.get('certification_display')"/>
            </xpath>
            <xpath expr="//field[@name='survey_id']" position="after">
                <!-- Which seal this evaluation is for. On one list per seal it
                     was implicit in the menu you came through; on a single
                     list it has to be on the row. -->
                <field name="certification_type_id" optional="show"
                       column_invisible="not context.get('certification_display')"/>
                <field name="company_id" optional="show" column_invisible="not context.get('certification_display')"/>
                <field name="certification_level" optional="show" widget="badge"
                       decoration-muted="certification_level == 'none'"
                       decoration-info="certification_level == 'bronze'"
                       decoration-primary="certification_level == 'silver'"
                       decoration-warning="certification_level == 'gold'"
                       column_invisible="not context.get('certification_display')"/>
                <field name="next_attempt_date" optional="show" column_invisible="not context.get('certification_display')"/>
                <field name="expiry_date" optional="show" column_invisible="not context.get('certification_display')"/>
                <field name="is_manually_overridden" optional="hide" column_invisible="not context.get('certification_display')"/>
            </xpath>
        </field>
    </record>

    <record id="survey_user_input_view_form_certification" model="ir.ui.view">
        <field name="name">survey.user_input.form.certification</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Certification" name="certification"
                      invisible="not certification_type_id">
                    <group>
                        <group string="Result">
                            <field name="certification_type_id"/>
                            <field name="company_id"/>
                            <field name="certification_level" widget="badge"/>
                            <field name="next_attempt_date"/>
                            <field name="expiry_date"/>
                        </group>
                        <group string="Manual Override"
                               groups="company_certification.group_certification_manager">
                            <field name="is_manually_overridden"/>
                            <field name="manual_certification_level"
                                   required="is_manually_overridden"
                                   invisible="not is_manually_overridden"/>
                            <field name="override_reason" invisible="not is_manually_overridden"/>
                            <field name="override_user_id" readonly="1" invisible="not is_manually_overridden"/>
                            <field name="override_date" readonly="1" invisible="not is_manually_overridden"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
