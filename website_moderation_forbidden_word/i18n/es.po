#. module: website_moderation_forbidden_word
#: model_terms:ir.actions.act_window,help:website_moderation_forbidden_word.action_moderation_forbidden_word
msgid ""
"Texts containing any of these words or expressions are held\n"
"                for a manual check instead of being published automatically.\n"
"                Matching ignores case and accents and only hits whole words."
msgstr ""
"Los textos que contienen alguna de estas palabras o expresiones se\n"
"                retienen para una revisión manual en lugar de publicarse\n"
"                automáticamente. La coincidencia ignora mayúsculas y acentos y\n"
"                solo detecta palabras completas."

