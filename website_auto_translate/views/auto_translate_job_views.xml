<odoo>

    <record id="view_auto_translate_job_list" model="ir.ui.view">
        <field name="name">auto.translate.job.list</field>
        <field name="model">auto.translate.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="field_name"/>
                <field name="lang"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'locked'"/>
                <field name="engine_id"/>
                <field name="attempts"/>
                <field name="error" optional="show"/>
                <field name="write_date"/>
                <button name="action_retry" type="object" icon="fa-repeat"
                        title="Queue again"
                        invisible="state not in ('failed', 'done')"/>
                <button name="action_unlock" type="object" icon="fa-unlock"
                        title="Discard the hand-written text and translate it again"
                        invisible="state != 'locked'"/>
            </list>
        </field>
    </record>

    <record id="view_auto_translate_job_search" model="ir.ui.view">
        <field name="name">auto.translate.job.search</field>
        <field name="model">auto.translate.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_name"/>
                <field name="field_name"/>
                <field name="lang"/>
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="failed" string="Failed"
                        domain="[('state', '=', 'failed')]"/>
                <filter name="locked" string="Written by hand"
                        domain="[('state', '=', 'locked')]"/>
                <separator/>
                <group name="group_by">
                    <filter name="by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="by_lang" string="Language"
                            context="{'group_by': 'lang'}"/>
                    <filter name="by_engine" string="Winning engine"
                            context="{'group_by': 'engine_id'}"/>
                    <filter name="by_model" string="Model"
                            context="{'group_by': 'model_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_auto_translate_job" model="ir.actions.act_window">
        <field name="name">Translation Queue</field>
        <field name="res_model">auto.translate.job</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_by_state': 1}</field>
    </record>

</odoo>
