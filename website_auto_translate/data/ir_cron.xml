<odoo>

    <record id="cron_run_pending_translations" model="ir.cron">
        <field name="name">Auto Translate: run pending translations</field>
        <field name="model_id" ref="model_auto_translate_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_pending()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall">2026-01-01 00:00:00</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
