<!-- Copyright 2026 Canarias Conectada
     License AGPL-3.0 or later (https://www.gnu.org/licenses/agpl).

     Starting glossary. Deliberately short and justifiable rather than long:
     every entry here is either a name of ours or a brand measured coming back
     wrong on 2026-08-15. A frequency sweep of the catalogue was tried first and
     rejected, because it ranks "Sandalia", "Pizza" and "Queso" alongside
     "Acer", and freezing an ordinary noun untranslated is the same class of
     mistake as translating a brand.

     These records are noupdate so that a term somebody edits or archives is
     not silently reinstated on the next module update. -->
<odoo noupdate="1">

    <!-- Ours. A zone is a place, and places keep their names. -->
    <record id="glossary_canarias_conectada" model="auto.translate.glossary">
        <field name="name">Canarias Conectada</field>
        <field name="note">Nombre de la plataforma</field>
    </record>
    <record id="glossary_zona_comercial_guanarteme" model="auto.translate.glossary">
        <field name="name">Zona Comercial Guanarteme</field>
        <field name="note">Nombre propio de la zona</field>
    </record>
    <record id="glossary_guanarteme" model="auto.translate.glossary">
        <field name="name">Guanarteme</field>
        <field name="note">Topónimo</field>
    </record>
    <record id="glossary_lomo_los_frailes" model="auto.translate.glossary">
        <field name="name">Lomo Los Frailes</field>
        <field name="note">Topónimo. "Frailes" se traduciría solo</field>
    </record>
    <record id="glossary_tamaraceite" model="auto.translate.glossary">
        <field name="name">Tamaraceite</field>
        <field name="note">Topónimo</field>
    </record>
    <record id="glossary_gran_canaria" model="auto.translate.glossary">
