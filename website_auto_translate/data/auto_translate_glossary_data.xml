    </record>
    <record id="glossary_memoria_viva" model="auto.translate.glossary">
        <field name="name">Memoria Viva</field>
        <field name="note">Nombre de la sección</field>
    </record>

    <!-- Marcas con daño medido el 15-ago-2026. -->
