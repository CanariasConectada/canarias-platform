<odoo>

    <!-- One grid card. Expects `entry` in the rendering context. -->
    <template id="directory_entry_card" name="Directory Entry Card">
        <div class="col-6 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm wd-card position-relative">
                <span t-attf-class="wd-zone-badge badge rounded-pill text-white {{
                        {'guanarteme': 'bg-primary',
                         'tamaraceite': 'bg-success',
                         'lomolosfrailes': 'bg-info'}.get(entry.zone, 'bg-secondary')
                    }}" t-esc="entry.get_zone_label()"/>
                <div class="card-img-top wd-card-img-wrap d-flex align-items-center justify-content-center bg-white">
                    <img t-att-src="entry.get_image_url()" class="wd-logo" t-att-alt="entry.get_display_name()" loading="lazy"/>
                </div>
                <div class="card-body">
                    <h5 class="card-title mb-1 fs-6" t-esc="entry.get_display_name()"/>
                    <p t-if="entry.short_description" class="card-text text-muted small mb-2" t-esc="entry.short_description"/>
                    <div t-if="entry.category_id" class="mb-2 wd-category-badges">
                        <t t-foreach="entry.get_category_badges()" t-as="badge">
                            <a t-att-href="'/comercio/categoria/%s' % badge['id']" t-attf-class="badge {{
                                    {1: 'bg-primary', 2: 'bg-info'}.get(badge['level'], 'bg-success')
                                }} text-white me-1 small fw-normal text-decoration-none" t-esc="badge['name']"/>
                        </t>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                    <a t-if="entry.has_external_website()" t-att-href="entry.get_website_url()" class="btn btn-primary btn-sm w-100" target="_blank" rel="noopener">
                        <i class="fa fa-globe me-1"/>Visit website
                    </a>
                    <span t-else="" class="btn btn-outline-secondary btn-sm w-100 disabled">
                        <i class="fa fa-globe me-1"/>Website not available
                    </span>
                </div>
            </div>
        </div>
    </template>

    <!-- One list row. Expects `entry` in the rendering context. -->
    <template id="directory_entry_list_item" name="Directory Entry List Item">
        <div class="list-group-item d-flex align-items-center gap-3 py-3">
            <div class="flex-shrink-0 wd-list-logo-wrap bg-white rounded d-flex align-items-center justify-content-center">
                <img t-att-src="entry.get_image_url()" class="wd-list-logo img-fluid rounded" t-att-alt="entry.get_display_name()" loading="lazy"/>
            </div>
            <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <h5 class="mb-0 fs-6" t-esc="entry.get_display_name()"/>
                    <span t-attf-class="badge rounded-pill text-white {{
                            {'guanarteme': 'bg-primary',
                             'tamaraceite': 'bg-success',
                             'lomolosfrailes': 'bg-info'}.get(entry.zone, 'bg-secondary')
                        }}" t-esc="entry.get_zone_label()"/>
                </div>
                <p t-if="entry.short_description" class="text-muted small mb-1" t-esc="entry.short_description"/>
                <div t-if="entry.category_id" class="wd-category-badges">
                    <t t-foreach="entry.get_category_badges()" t-as="badge">
                        <a t-att-href="'/comercio/categoria/%s' % badge['id']" t-attf-class="badge {{
                                {1: 'bg-primary', 2: 'bg-info'}.get(badge['level'], 'bg-success')
                            }} text-white me-1 small fw-normal text-decoration-none" t-esc="badge['name']"/>
                    </t>
                </div>
            </div>
            <div class="flex-shrink-0">
                <a t-if="entry.has_external_website()" t-att-href="entry.get_website_url()" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener">
                    <i class="fa fa-globe me-1"/>Visit
                </a>
                <span t-else="" class="btn btn-outline-secondary btn-sm disabled">
                    <i class="fa fa-globe me-1"/>Visit
                </span>
            </div>
        </div>
    </template>

    <!-- Entries (grid or list) + empty state + pager. Shared by the full
         page and the AJAX partial rendering. -->
    <template id="directory_results" name="Directory Results">
        <div t-if="view_type == 'grid'" id="entries_grid" class="row g-3">
            <t t-foreach="entries" t-as="entry">
                <t t-call="website_directory.directory_entry_card"/>
            </t>
        </div>
        <div t-if="view_type == 'list'" id="entries_list" class="list-group list-group-flush">
            <t t-foreach="entries" t-as="entry">
                <t t-call="website_directory.directory_entry_list_item"/>
            </t>
        </div>
        <div t-if="not entries" class="text-center py-5">
            <i class="fa fa-inbox fa-4x text-muted mb-3"/>
            <h4 class="text-muted">No businesses found</h4>
            <p class="text-muted" t-if="search">Try another search term</p>
        </div>
        <div class="wd-pager d-flex justify-content-center mt-4">
            <t t-call="website.pager"/>
        </div>
    </template>

    <!-- AJAX partial: active filter badges + results. -->
    <template id="directory_search_results" name="Directory Search Results">
        <div class="wd-active-filters mb-3 d-flex flex-wrap gap-2 align-items-center">
            <span t-if="search" class="badge bg-info d-inline-flex align-items-center">
                <i class="fa fa-search me-1"/>
                <t t-esc="search"/>
            </span>
            <t t-if="selected_category">
                <t t-set="filter_category_obj" t-value="request.env['res.company.category'].sudo().browse(selected_category)"/>
                <span t-if="filter_category_obj.exists()" class="badge bg-primary d-inline-flex align-items-center">
                    <i class="fa fa-folder me-1"/>
                    <t t-esc="filter_category_obj.name"/>
                </span>
            </t>
            <!-- Red trash: wipes every active filter (search, category, zone)
                 by reloading the bare directory page. Only rendered when
                 there is something to clear. -->
            <a t-if="search or selected_category or (current_zone and current_zone != 'canarias')"
               href="/comercio"
               class="btn btn-sm btn-outline-danger wd-clear-filters d-inline-flex align-items-center"
               title="Clear all filters">
                <i class="fa fa-trash"/>
            </a>
            <span class="text-muted small ms-auto">
                <t t-esc="entries_count"/> result(s)
            </span>
        </div>
        <t t-call="website_directory.directory_results"/>
    </template>

    <!-- Extension hook: bridge modules (silver economy, sustainability,
         zones...) inherit this template to add their filter cards to the
         sidebar. The base module renders nothing here. -->
    <template id="directory_sidebar_extra" name="Directory Sidebar Extension Hook">
        <div id="o_wd_sidebar_extra"/>
    </template>

    <!-- Main page. -->
    <template id="directory_index" name="Business Directory">
        <t t-call="website.layout">
            <t t-set="additional_title">Business Directory</t>

            <section class="wd-header py-5 bg-light border-bottom">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8 text-center">
                            <h1 class="display-5 mb-3 fw-bold">Business Directory</h1>
                            <p class="lead mb-4 text-muted">Find the best businesses and services in your area</p>
                            <form action="/comercio" method="get" class="input-group input-group-lg" id="wd_search_form">
                                <input type="hidden" name="category" t-att-value="selected_category or ''"/>
                                <input type="text" name="search" id="wd_search_input" class="form-control border-end-0" placeholder="Search businesses..." t-att-value="search or ''" autocomplete="off"/>
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="fa fa-search me-2"/>Search
                                </button>
                            </form>
                            <div id="wd_search_loading" class="text-center mt-3 d-none">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <div id="wrap" class="wd-directory-page">
                <div class="container-lg container py-4 mb-5">
                    <!-- Data for the frontend script. -->
                    <div id="wd_data" class="d-none" t-att-data-directory="categories_json" t-att-data-view="view_type" t-att-data-ppg="ppg" t-att-data-base-url="base_url" t-att-data-search="search or ''"/>

                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="btn-toolbar flex-wrap align-items-center justify-content-between gap-2 p-3 bg-light rounded">
                                <div class="d-flex align-items-center flex-wrap gap-2">
                                    <span class="text-muted">
                                        <t t-if="entries_count == 0">No businesses found</t>
                                        <t t-else=""><strong t-esc="entries_count"/> businesses</t>
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="btn-group" role="group" aria-label="View type">
                                        <button type="button" data-wd-view="grid" t-attf-class="btn btn-sm {{view_type == 'grid' and 'btn-primary active' or 'btn-outline-secondary'}}" title="Grid view">
                                            <i class="fa fa-th"/>
                                        </button>
                                        <button type="button" data-wd-view="list" t-attf-class="btn btn-sm {{view_type == 'list' and 'btn-primary active' or 'btn-outline-secondary'}}" title="List view">
                                            <i class="fa fa-list"/>
                                        </button>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <label class="text-muted small mb-0 d-none d-md-block">Show:</label>
                                        <div class="btn-group" role="group">
                                            <t t-foreach="[12, 21, 48]" t-as="ppg_option">
                                                <button type="button" t-att-data-wd-ppg="ppg_option" t-attf-class="btn btn-sm {{ppg == ppg_option and 'btn-primary active' or 'btn-outline-secondary'}}" t-esc="ppg_option"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <aside class="col-lg-3 mb-4">
                            <!-- Zone filter -->
                            <div class="card border-0 shadow-sm mb-3 wd-filter-card" id="wd_zone_card">
                                <div class="card-header bg-white py-3">
                                    <h5 class="mb-0 fw-bold fs-6"><i class="fa fa-map-marker text-primary me-2"/>Commercial Zone</h5>
                                </div>
                                <div class="card-body">
                                    <select class="form-select" id="wd_zone_select" t-att-data-current="current_zone or 'canarias'">
                                        <option value="/comercio" t-att-selected="not current_zone or current_zone == 'canarias' or None">All zones</option>
                                        <t t-foreach="zone_options" t-as="zone_option">
                                            <option t-if="zone_option[0] != 'canarias'" t-att-value="'/comercio/zona/%s' % zone_option[0]" t-att-selected="current_zone == zone_option[0] or None" t-esc="zone_option[1]"/>
                                        </t>
                                    </select>
                                    <div t-if="current_zone and current_zone != 'canarias'" class="mt-3">
                                        <small class="text-muted d-block mb-1">Filtering by:</small>
                                        <span class="badge bg-primary d-inline-flex align-items-center">
                                            <t t-esc="dict(zone_options).get(current_zone, current_zone)"/>
                                            <a href="/comercio" class="text-white ms-2 text-decoration-none fw-bold">×</a>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Cascading category filter -->
                            <div class="card border-0 shadow-sm mb-3 wd-filter-card" id="wd_category_card">
                                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold fs-6"><i class="fa fa-tags text-primary me-2"/>Category</h5>
                                    <div id="wd_category_loader" class="spinner-border spinner-border-sm text-primary d-none" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <form action="/comercio" method="get" id="wd_category_form" autocomplete="off">
                                        <input type="hidden" name="search" t-att-value="search or ''"/>
                                        <div class="mb-3">
                                            <label class="form-label small text-muted mb-1" for="wd_cat_l1">
                                                <i class="fa fa-folder-open me-1"/>Main category
                                            </label>
                                            <select name="category" class="form-select" id="wd_cat_l1">
                                                <option value="">All categories</option>
                                                <t t-foreach="category_tree" t-as="root">
                                                    <option t-att-value="root['id']" t-att-selected="selected_category_path[0] == root['id'] or None" t-esc="root['name']"/>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="mb-3 d-none" id="wd_cat_l2_wrap">
                                            <label class="form-label small text-muted mb-1" for="wd_cat_l2">
                                                <i class="fa fa-folder me-1"/>Subcategory
                                            </label>
                                            <select class="form-select" id="wd_cat_l2">
                                                <option value="">All subcategories</option>
                                            </select>
                                        </div>
                                        <div class="mb-3 d-none" id="wd_cat_l3_wrap">
                                            <label class="form-label small text-muted mb-1" for="wd_cat_l3">
                                                <i class="fa fa-file-text me-1"/>Specialty
                                            </label>
                                            <select class="form-select" id="wd_cat_l3">
                                                <option value="">All specialties</option>
                                            </select>
                                        </div>
                                    </form>
                                    <div t-if="selected_category" class="mt-3 pt-3 border-top" id="wd_category_badge">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <small class="text-muted">Filtering by:</small>
                                            <a href="/comercio" class="btn btn-sm btn-outline-secondary py-0 px-2">
                                                <i class="fa fa-times me-1"/>Clear
                                            </a>
                                        </div>
                                        <div class="d-flex flex-wrap gap-1">
                                            <t t-set="selected_category_obj" t-value="request.env['res.company.category'].sudo().browse(selected_category)"/>
                                            <span t-if="selected_category_obj.exists()" class="badge bg-primary">
                                                <i class="fa fa-folder-open me-1"/><t t-esc="selected_category_obj.complete_name"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Extension hook for bridge modules. -->
                            <t t-call="website_directory.directory_sidebar_extra"/>
                        </aside>

                        <div class="col-lg-9">
                            <div id="wd_results">
                                <!-- Same partial the AJAX injects: keeps the
                                     active-filter badges (and the clear-all
                                     trash) visible on direct URL loads too. -->
                                <t t-call="website_directory.directory_search_results"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
