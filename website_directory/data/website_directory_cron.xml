<odoo>

    <record id="cron_sync_directory_entries" model="ir.cron">
        <field name="name">Website Directory: sync pending company entries</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_directory_entries()</field>
