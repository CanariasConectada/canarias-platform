<odoo>
    <record id="project_task_view_form_field_visit" model="ir.ui.view">
        <field name="name">project.task.form.field.visit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <field name="is_field_visit_project" invisible="1" />
                <button
                    name="action_log_field_visit"
                    type="object"
                    string="Log visit"
                    class="btn-primary"
                    icon="fa-map-marker"
                    invisible="not is_field_visit_project or not id"
                    groups="project_field_visit.group_field_visit_consultant"
                />
            </xpath>
            <span id="end_button_box" position="before">
                <button
                    name="action_open_business_microsite"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-globe"
                    invisible="not is_field_visit_project or not business_microsite_url"
                    groups="project_field_visit.group_field_visit_consultant"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Open microsite</span>
                    </div>
                </button>
            </span>
            <field name="task_properties" position="before">
                <group
                    name="field_visit_business"
                    string="Visited business"
                    invisible="not is_field_visit_project"
                    groups="project_field_visit.group_field_visit_consultant"
                >
                    <group>
                        <!-- no_open: the business is usually outside the
                             consultant's companies; the name is enough. -->
                        <field
                            name="business_company_id"
                            options="{'no_open': True, 'no_create': True}"
                        />
                        <field
                            name="business_partner_id"
                            options="{'no_open': True}"
                            context="{'default_is_company': True, 'default_is_field_visit_prospect': True}"
                        />
                    </group>
                    <group>
                        <field
                            name="business_website_id"
                            options="{'no_open': True, 'no_create': True}"
                            invisible="not business_company_id"
                        />
                        <field
                            name="business_microsite_url"
                            widget="url"
                            invisible="not business_microsite_url"
                        />
                        <field
                            name="field_visit_last_date"
                            invisible="not field_visit_last_date"
                        />
                        <field
                            name="field_visit_last_outcome"
                            invisible="not field_visit_last_outcome"
                        />
                    </group>
                </group>
                <group
                    name="field_visit_logistics"
                    string="Where and whom to visit"
                    invisible="not is_field_visit_project"
                    groups="project_field_visit.group_field_visit_consultant"
                >
                    <group>
                        <field name="field_visit_address" />
                        <field
                            name="field_visit_map_url"
                            widget="url"
                            text="Open in Google Maps"
                            invisible="not field_visit_map_url"
                        />
                        <field name="field_visit_zone" />
                    </group>
                    <group>
                        <field name="field_visit_contact_name" />
                        <field name="field_visit_phone" widget="phone" />
                        <field name="field_visit_email" widget="email" />
                    </group>
                </group>
            </field>
        </field>
    </record>

    <record id="project_task_view_kanban_field_visit" model="ir.ui.view">
        <field name="name">project.task.kanban.field.visit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="is_field_visit_project" invisible="1" />
                <field
                    name="business_name"
                    invisible="not is_field_visit_project or not business_name"
                    class="fw-semibold"
                />
                <field
                    name="business_microsite_url"
                    widget="url"
                    invisible="not is_field_visit_project or not business_microsite_url"
                />
                <field
                    name="field_visit_address"
                    invisible="not is_field_visit_project or not field_visit_address"
                    class="text-muted small"
                />
                <field
                    name="field_visit_last_date"
                    widget="date"
                    invisible="not is_field_visit_project or not field_visit_last_date"
                />
            </field>
        </field>
    </record>

    <record id="project_task_view_list_field_visit" model="ir.ui.view">
        <field name="name">project.task.list.field.visit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_task_view_tree_main_base" />
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="business_name" optional="show" />
                <field name="field_visit_last_date" optional="hide" />
                <field name="field_visit_last_outcome" optional="hide" />
            </field>
        </field>
    </record>

    <record id="project_task_view_search_field_visit" model="ir.ui.view">
        <field name="name">project.task.search.field.visit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field
                    name="business_name"
                    filter_domain="['|', '|', ('business_name', 'ilike', self), ('field_visit_address', 'ilike', self), ('field_visit_contact_name', 'ilike', self)]"
                />
                <field name="field_visit_zone" />
            </field>
            <filter name="my_tasks" position="after">
                <filter
                    string="My visits"
                    name="field_visit_mine"
                    domain="[('user_ids', 'in', uid), ('is_field_visit_project', '=', True)]"
                    groups="project_field_visit.group_field_visit_consultant"
                />
            </filter>
            <filter name="stage" position="after">
                <filter
                    string="Zone"
                    name="groupby_field_visit_zone"
                    context="{'group_by': 'field_visit_zone'}"
                    groups="project_field_visit.group_field_visit_consultant"
                />
            </filter>
        </field>
    </record>

    <!-- The consultant's day: whom to visit, where, how to reach them. -->
    <record id="project_task_view_list_field_visit_daily" model="ir.ui.view">
        <field name="name">project.task.list.field.visit.daily</field>
        <field name="model">project.task</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Field visits" sample="1">
                <field name="is_field_visit_project" column_invisible="1" />
                <field name="business_name" />
                <field name="name" optional="hide" />
                <field name="field_visit_zone" optional="show" />
                <field name="field_visit_address" optional="show" />
                <field
                    name="field_visit_map_url"
                    widget="url"
                    text="Map"
                    optional="show"
                />
                <field name="field_visit_contact_name" optional="show" />
                <field name="field_visit_phone" widget="phone" optional="show" />
                <field name="field_visit_email" widget="email" optional="hide" />
                <field
                    name="user_ids"
                    widget="many2many_avatar_user"
                    optional="show"
                />
                <field name="date_deadline" string="Planned visit" optional="show" />
                <field name="stage_id" optional="show" />
                <field name="field_visit_last_date" optional="show" />
                <field name="field_visit_last_outcome" optional="hide" />
                <field name="activity_ids" widget="list_activity" optional="show" />
                <field name="project_id" optional="hide" />
                <button
                    name="action_log_field_visit"
                    type="object"
                    string="Log visit"
                    icon="fa-map-marker"
                />
            </list>
        </field>
    </record>

    <record id="action_field_visit_my_visits" model="ir.actions.act_window">
        <field name="name">My visits</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="domain">[('is_field_visit_project', '=', True)]</field>
        <field name="search_view_id" ref="project.view_task_search_form" />
        <field
            name="context"
        >{'search_default_field_visit_mine': 1, 'search_default_stage': 1}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('project_task_view_list_field_visit_daily')}),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('project.view_task_kanban')}),
                (0, 0, {'view_mode': 'calendar', 'view_id': ref('project.view_task_calendar')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('project.view_task_form2')})]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No visits assigned to you</p>
            <p>
                The businesses you visit appear here once a manager assigns
                them to you or imports the phase spreadsheet.
            </p>
        </field>
    </record>

    <record id="action_field_visit_all_visits" model="ir.actions.act_window">
        <field name="name">All visits</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="domain">[('is_field_visit_project', '=', True)]</field>
        <field name="search_view_id" ref="project.view_task_search_form" />
        <field name="context">{'search_default_groupby_field_visit_zone': 1}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('project_task_view_list_field_visit_daily')}),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('project.view_task_kanban')}),
                (0, 0, {'view_mode': 'calendar', 'view_id': ref('project.view_task_calendar')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('project.view_task_form2')})]"
        />
    </record>
</odoo>
