<odoo>
    <record id="project_project_view_form_field_visit" model="ir.ui.view">
        <field name="name">project.project.form.field.visit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <setting id="project_milestone_setting" position="after">
                <setting
                    class="col-lg-12"
                    id="field_visit_setting"
                    groups="project_field_visit.group_field_visit_manager"
                    help="Each task is a business of the platform visited by the consultants; the task properties are the checklist of this phase."
                >
                    <field name="is_field_visit_project" />
                    <div
                        class="mt-2"
                        invisible="not is_field_visit_project or not id"
                    >
                        <button
                            name="action_open_field_visit_import"
                            type="object"
                            string="Import spreadsheet"
                            icon="fa-upload"
                            class="btn-link p-0"
                        />
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
