<odoo>
    <record id="res_partner_view_form_field_visit" model="ir.ui.view">
        <field name="name">res.partner.form.field.visit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_field_visits"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-map-marker"
                    groups="project_field_visit.group_field_visit_consultant"
                    invisible="not field_visit_task_count"
                >
                    <field
                        name="field_visit_task_count"
                        string="Field visits"
                        widget="statinfo"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
