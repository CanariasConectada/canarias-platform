<odoo noupdate="1">
    <!-- Runs at install only: a <function> inside a noupdate block is
         skipped by every later upgrade (odoo/tools/convert.py,
         _tag_function: "if self.noupdate and self.mode != 'init'").
         Databases that already had the module get the same step once from
         migrations/19.0.1.2.0. Idempotent either way, and a no-op once
         somebody was appointed manager. -->
    <function model="project.project" name="_field_visit_grant_admins" />
</odoo>
