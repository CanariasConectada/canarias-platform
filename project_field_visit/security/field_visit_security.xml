<odoo>
    <record id="res_groups_privilege_field_visit" model="res.groups.privilege">
        <field name="name">Field visits</field>
        <field name="sequence">4</field>
        <field name="category_id" ref="base.module_category_services" />
    </record>

    <!-- Being a project user is NOT enough: a field-visit task names a
         business of the platform and exposes its data. Only people the
         programme appoints get these groups; merchants and guests never. -->
    <record id="group_field_visit_consultant" model="res.groups">
        <field name="name">Field visit consultant</field>
        <field name="comment">Visits the businesses of the platform: sees the field-visit projects and logs visits.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_field_visit" />
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]" />
    </record>

    <record id="group_field_visit_manager" model="res.groups">
        <field name="name">Field visit manager</field>
        <field name="comment">Runs the programme: creates phase projects and imports the spreadsheets.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_field_visit" />
        <field
            name="implied_ids"
            eval="[(4, ref('group_field_visit_consultant')), (4, ref('project.group_project_manager'))]"
        />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <!-- GLOBAL rules (group rules are OR-ed and could not narrow anything):
         every task and project that is not a field visit stays exempt. -->
    <record id="project_task_rule_field_visit" model="ir.rule">
        <field name="name">Project/Task: field visits only for field-visit consultants</field>
        <field name="model_id" ref="project.model_project_task" />
        <field name="global" eval="True" />
        <field name="domain_force">[
            '|',
            ('is_field_visit_project', '=', False),
            (1, '=', 1) if (user.has_group('project_field_visit.group_field_visit_consultant') or user.has_group('base.group_system')) else (0, '=', 1),
        ]</field>
    </record>

    <record id="project_project_rule_field_visit" model="ir.rule">
        <field name="name">Project: field-visit projects only for field-visit consultants</field>
        <field name="model_id" ref="project.model_project_project" />
        <field name="global" eval="True" />
        <field name="domain_force">[
            '|',
            ('is_field_visit_project', '=', False),
            (1, '=', 1) if (user.has_group('project_field_visit.group_field_visit_consultant') or user.has_group('base.group_system')) else (0, '=', 1),
        ]</field>
    </record>
</odoo>
