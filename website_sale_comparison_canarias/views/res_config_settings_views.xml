<odoo>

    <record id="res_config_settings_view_form_comparison" model="ir.ui.view">
        <field name="name">res.config.settings.form.website.sale.comparison.canarias</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Price comparator" id="wscc_comparison_settings">
                    <setting
                        string="Price Comparator"
                        id="wscc_comparison_enabled_setting"
                        help="Show the comparator on the shop listings and product pages of every website. When off, no Compare button, picker or comparison bar is rendered anywhere."
                        info="This setting is common to all websites."
                    >
                        <field name="wscc_comparison_enabled"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
