<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================== -->
    <!-- VISTAS PARA PÚBLICO OBJETIVO -->
    <!-- ======================================== -->
    <record id="view_lugares_interes_publico_objetivo_list" model="ir.ui.view">
        <field name="name">lugares.interes.publico.objetivo.list</field>
        <field name="model">lugares.interes.publico.objetivo</field>
        <field name="arch" type="xml">
            <list string="Públicos">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lugares_interes_publico_objetivo_form" model="ir.ui.view">
        <field name="name">lugares.interes.publico.objetivo.form</field>
        <field name="model">lugares.interes.publico.objetivo</field>
        <field name="arch" type="xml">
            <form string="Público Objetivo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lugares_interes_publico_objetivo" model="ir.actions.act_window">
        <field name="name">Público Objetivo</field>
        <field name="res_model">lugares.interes.publico.objetivo</field>
        <field name="view_mode">list,form</field>
    </record>

