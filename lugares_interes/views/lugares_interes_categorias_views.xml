<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================== -->
    <!-- VISTAS PARA TIPOS (Nivel 1) -->
    <!-- ======================================== -->
    <record id="view_lugares_interes_tipo_list" model="ir.ui.view">
        <field name="name">lugares.interes.tipo.list</field>
        <field name="model">lugares.interes.tipo</field>
        <field name="arch" type="xml">
            <list string="Tipos">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="categoria_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lugares_interes_tipo_form" model="ir.ui.view">
        <field name="name">lugares.interes.tipo.form</field>
        <field name="model">lugares.interes.tipo</field>
        <field name="arch" type="xml">
            <form string="Tipo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="categoria_ids">
                        <list string="Categorías" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lugares_interes_tipo_search" model="ir.ui.view">
        <field name="name">lugares.interes.tipo.search</field>
        <field name="model">lugares.interes.tipo</field>
        <field name="arch" type="xml">
            <search string="Tipos">
                <field name="name"/>
                <filter string="Archivados" name="filter_inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_lugares_interes_tipo" model="ir.actions.act_window">
        <field name="name">Tipos</field>
        <field name="res_model">lugares.interes.tipo</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lugares_interes_tipo_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer tipo de lugar</p>
        </field>
    </record>

    <!-- ======================================== -->
    <!-- VISTAS PARA CATEGORÍAS (Nivel 2) -->
    <!-- ======================================== -->
    <record id="view_lugares_interes_categoria_list" model="ir.ui.view">
        <field name="name">lugares.interes.categoria.list</field>
        <field name="model">lugares.interes.categoria</field>
        <field name="arch" type="xml">
            <list string="Categorías">
                <field name="sequence" widget="handle"/>
                <field name="tipo_id"/>
                <field name="name"/>
                <field name="subcategoria_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lugares_interes_categoria_form" model="ir.ui.view">
        <field name="name">lugares.interes.categoria.form</field>
        <field name="model">lugares.interes.categoria</field>
        <field name="arch" type="xml">
            <form string="Categoría">
                <sheet>
                    <group>
                        <field name="tipo_id"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="subcategoria_ids">
                        <list string="Subcategorías" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lugares_interes_categoria_search" model="ir.ui.view">
        <field name="name">lugares.interes.categoria.search</field>
        <field name="model">lugares.interes.categoria</field>
        <field name="arch" type="xml">
            <search string="Categorías">
                <field name="name"/>
                <field name="tipo_id"/>
                <filter string="Archivados" name="filter_inactive" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lugares_interes_categoria" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">lugares.interes.categoria</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lugares_interes_categoria_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera categoría</p>
        </field>
    </record>

    <!-- ======================================== -->
    <!-- VISTAS PARA SUBCATEGORÍAS (Nivel 3) -->
    <!-- ======================================== -->
    <record id="view_lugares_interes_subcategoria_list" model="ir.ui.view">
        <field name="name">lugares.interes.subcategoria.list</field>
        <field name="model">lugares.interes.subcategoria</field>
        <field name="arch" type="xml">
            <list string="Subcategorías">
                <field name="sequence" widget="handle"/>
                <field name="tipo_id"/>
                <field name="categoria_id"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lugares_interes_subcategoria_form" model="ir.ui.view">
        <field name="name">lugares.interes.subcategoria.form</field>
        <field name="model">lugares.interes.subcategoria</field>
        <field name="arch" type="xml">
            <form string="Subcategoría">
                <sheet>
                    <group>
                        <field name="tipo_id"/>
                        <field name="categoria_id" domain="[('tipo_id', '=', tipo_id)]"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lugares_interes_subcategoria_search" model="ir.ui.view">
        <field name="name">lugares.interes.subcategoria.search</field>
        <field name="model">lugares.interes.subcategoria</field>
        <field name="arch" type="xml">
            <search string="Subcategorías">
                <field name="name"/>
                <field name="tipo_id"/>
                <field name="categoria_id"/>
                <filter string="Archivados" name="filter_inactive" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo_id'}"/>
                    <filter string="Categoría" name="group_categoria" context="{'group_by': 'categoria_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lugares_interes_subcategoria" model="ir.actions.act_window">
        <field name="name">Subcategorías</field>
        <field name="res_model">lugares.interes.subcategoria</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lugares_interes_subcategoria_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera subcategoría</p>
        </field>
    </record>
</odoo>
