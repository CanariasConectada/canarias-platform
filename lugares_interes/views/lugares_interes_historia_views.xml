<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lugares_interes_historia_list" model="ir.ui.view">
        <field name="name">lugares.interes.historia.list</field>
        <field name="model">lugares.interes.historia</field>
        <field name="arch" type="xml">
            <list string="Lugares">
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="tipo_id" optional="show"/>
                <field name="categoria_id" optional="hide"/>
                <field name="barrio" optional="show"/>
                <field name="website_primario_id"/>
                <field name="state" widget="badge" decoration-info="state == 'borrador'" decoration-warning="state == 'pendiente'" decoration-success="state == 'aprobado'" decoration-danger="state == 'rechazado'"/>
            </list>
        </field>
    </record>

    <record id="view_lugares_interes_historia_form" model="ir.ui.view">
        <field name="name">lugares.interes.historia.form</field>
        <field name="model">lugares.interes.historia</field>
        <field name="arch" type="xml">
            <form string="Lugar">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del lugar..."/>
                        </h1>
                        <h3 class="text-muted">
                            <field name="slug" placeholder="Se genera automáticamente desde el nombre, pero puedes editarlo"/>
                        </h3>
                    </div>
                    
                    <group>
                        <group>
                            <field name="tipo_id"/>
                            <field name="categoria_id" domain="[('tipo_id', '=', tipo_id)]"/>
                            <field name="subcategoria_id" domain="[('categoria_id', '=', categoria_id)]"/>
                            <field name="ciudad"/>
                            <field name="barrio"/>
                        </group>
                        <group>
                            <field name="website_primario_id"/>
                            <field name="website_ids" widget="many2many_tags"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- PESTAÑA: GENERAL -->
                        <page string="General">
                            <group>
                                <group string="Ubicación">
                                    <field name="direccion"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                </group>
                                <group string="Clasificación">
                                    <field name="publico_ids" widget="many2many_tags"/>
                                    <field name="momento_ids" widget="many2many_tags"/>
                                    <field name="ambiente_ids" widget="many2many_tags"/>
                                    <field name="experiencia_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <group string="Imagen Destacada">
                                <field name="image_main" widget="image" class="oe_avatar" options="{'preview_image': 'image_main'}"/>
                            </group>
                            <group string="Versiones Optimizadas">
                                <div class="text-muted">
                                    Las versiones Grid (600x600) y Detail (1600x1200) se generan automáticamente al guardar la imagen principal.
                                </div>
                            </group>
                        </page>

                        <!-- PESTAÑA: DESCRIPCIONES -->
                        <page string="Descripciones">
                            <group>
                                <field name="description" placeholder="Descripción corta para listados..."/>
                            </group>
                            <group>
                                <field name="descripcion_larga" placeholder="Descripción completa del lugar..."/>
                            </group>
                        </page>

                        <!-- PESTAÑA: CONTACTO -->
                        <page string="Contacto y Redes">
                            <group>
                                <group string="Contacto">
                                    <field name="telefono"/>
                                    <field name="whatsapp"/>
                                    <field name="website_url" widget="url"/>
                                </group>
                                <group string="Redes Sociales">
                                    <field name="instagram"/>
                                    <field name="tiktok"/>
                                </group>
                            </group>
                            <group string="Tags de Búsqueda">
                                <field name="tags_busqueda" placeholder="Tags separados por comas..."/>
                            </group>
                        </page>

                        <!-- PESTAÑA: HORARIO -->
                        <page string="Horario">
                            <group>
                                <field name="horario" placeholder="Ej: Lunes a Viernes 09:00-20:00, Sábados 10:00-14:00"/>
                            </group>
                        </page>

                        <!-- PESTAÑA: GALERÍA -->
                        <page string="Galería">
                            <field name="image_ids">
                                <list string="Imágenes" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="image" widget="image" options="{'size': [90, 90]}"/>
                                </list>
                            </field>
                        </page>

                        <!-- PESTAÑA: INFO INTERNA -->
                        <page string="Info Interna" groups="base.group_system,lugares_interes.group_lugares_interes_approver">
                            <group>
                                <group string="Usuario que Publicó">
                                    <field name="partner_id"/>
                                    <field name="create_date"/>
                                    <field name="dni_remitente"/>
                                </group>
                                <group string="Datos del Formulario (Backup)">
                                    <field name="publicador_nombre" readonly="1"/>
                                    <field name="publicador_telefono" readonly="1"/>
                                    <field name="publicador_email" readonly="1"/>
                                </group>
                            </group>
                            <group string="Gestión">
                                <field name="user_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lugares_interes_historia_search" model="ir.ui.view">
        <field name="name">lugares.interes.historia.search</field>
        <field name="model">lugares.interes.historia</field>
        <field name="arch" type="xml">
            <search string="Lugares">
                <field name="name"/>
                <field name="description"/>
                <field name="direccion"/>
                <field name="tipo_id"/>
                <field name="categoria_id"/>
                <field name="barrio"/>
                <field name="website_primario_id"/>
                <field name="tags_busqueda"/>
                
                <filter string="Borradores" name="filter_borrador" domain="[('state','=','borrador')]"/>
                <filter string="Pendientes" name="filter_pendiente" domain="[('state','=','pendiente')]"/>
                <filter string="Aprobadas" name="filter_aprobado" domain="[('state','=','aprobado')]"/>
                <filter string="Rechazadas" name="filter_rechazado" domain="[('state','=','rechazado')]"/>
                <filter string="Publicadas" name="filter_publicado" domain="[('state','=','aprobado')]"/>
                
                <separator/>
                
                <group>
                    <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo_id'}"/>
                    <filter string="Categoría" name="group_categoria" context="{'group_by': 'categoria_id'}"/>
                    <filter string="Barrio" name="group_barrio" context="{'group_by': 'barrio'}"/>
                    <filter string="Microsite" name="group_website" context="{'group_by': 'website_primario_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lugares_interes_historia" model="ir.actions.act_window">
        <field name="name">Lugares</field>
        <field name="res_model">lugares.interes.historia</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lugares_interes_historia_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer lugar
            </p>
        </field>
    </record>
</odoo>
