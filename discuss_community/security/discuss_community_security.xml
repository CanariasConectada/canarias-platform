<odoo>

    <!--
        GLOBAL rules (no groups) on purpose: group rules are OR-ed together,
        so a narrowing rule attached to a group would be widened back by
        core's own `base.group_user` rule. A global rule is AND-ed with
        everything, and its domain exempts everybody who is not a community
        guest with a trivially true branch.

        What a community guest may read: the channels and conversations it is
        a member of, the open public channels (`group_public_id` unset) and
        the four community channels (`user.community_channel_ids`: the
        neighbourhood ones are gated on `group_zone_channel_member`, so the
        open branch does not cover them, and a guest must see all of them to
        join or leave each). Never the staff channels "general" and
        "Administrators", even if seated there before this rule existed.

        `user.is_community_guest` is fixed for the life of an account, which
        matters: the evaluated domain is cached per user
        (`ir.rule._compute_domain`).
    -->
    <record id="rule_discuss_channel_community_guest" model="ir.rule">
        <field name="name">discuss.channel: community guests only see their own, open and community channels</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="domain_force">
            [(1, "=", 1)] if not user.is_community_guest else [
                ("id", "not in", user.community_hidden_channel_ids.ids),
                "|", "|", "|",
                    ("is_member", "=", True),
                    ("parent_channel_id.is_member", "=", True),
                    ("id", "in", user.community_channel_ids.ids),
                    "&amp;",
                        ("channel_type", "=", "channel"),
                        ("group_public_id", "=", False),
            ]
        </field>
    </record>

    <!--
        Joining is creating one's own member row, and core's create rule lets
        any holder of a channel's group join it: a guest IS `base.group_user`,
        so without this it could join "general" by RPC even though it cannot
        read it. A guest joins the open channels and the four community
        channels (its OWN row only: core's create rules already refuse a row
        for somebody else in a `channel`). Create only: leaving (unlinking its
        own row) stays core's `ir_rule_discuss_channel_member_is_self_all`.
    -->
    <record id="rule_discuss_channel_member_community_guest_join" model="ir.rule">
        <field name="name">discuss.channel.member: community guests only join open and community channels</field>
        <field name="model_id" ref="mail.model_discuss_channel_member"/>
        <field name="domain_force">
            [(1, "=", 1)] if not user.is_community_guest else [
                ("channel_id", "not in", user.community_hidden_channel_ids.ids),
                "|", "|",
                    ("channel_id.channel_type", "!=", "channel"),
                    ("channel_id.group_public_id", "=", False),
                    ("channel_id", "in", user.community_channel_ids.ids),
            ]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="perm_create" eval="True"/>
    </record>

    <!--
        Who is in a channel. Core lets every internal user read the members of
        any open channel (`ir_rule_discuss_channel_member_read_all`), which
        for a guest would mean the whole roster of "Canarias Conectada",
        merchants included, one RPC away. A guest reads:
          * in a `channel`: only its OWN membership row;
          * in a chat or group it belongs to: the other members, since the
            conversation is named after them;
          * nothing at all in the staff channels.
    -->
    <record id="rule_discuss_channel_member_community_guest_read" model="ir.rule">
        <field name="name">discuss.channel.member: community guests only read their own rows in channels</field>
        <field name="model_id" ref="mail.model_discuss_channel_member"/>
        <field name="domain_force">
            [(1, "=", 1)] if not user.is_community_guest else [
                ("channel_id", "not in", user.community_hidden_channel_ids.ids),
                "|",
                    ("is_self", "=", True),
                    "&amp;",
                        ("channel_id.channel_type", "!=", "channel"),
                        ("channel_id.is_member", "=", True),
            ]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>

</odoo>
