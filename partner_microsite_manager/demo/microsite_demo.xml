<odoo>

    <!-- A demo merchant with its own website and microsite content. -->
    <record id="demo_microsite_company" model="res.company">
        <field name="name">Demo Microsite Bakery</field>
        <field name="street">Calle Triana 1</field>
        <field name="city">Las Palmas de Gran Canaria</field>
        <field name="zip">35002</field>
        <field name="microsite_name">La Tahona del Puerto</field>
        <field name="microsite_button_text">Shop</field>
        <field name="microsite_opening_hours">L-V 08:00-14:00 / L-V 17:00-20:00 / S 08:00-13:00</field>
        <field name="microsite_delivery_info">Home delivery in Las Palmas</field>
        <field name="microsite_parking_info">Public parking 50 m away</field>
        <field name="microsite_about_title">About Us</field>
        <field name="microsite_about_text">Family bakery baking traditional Canarian bread since 1952.</field>
        <field name="microsite_services_title">Our Services</field>
        <field name="microsite_services_text">Artisan bread, pastries and custom cakes for events.</field>
        <field name="microsite_intro_title">Fresh bread every morning</field>
        <field name="microsite_banner_title">Buy Canarian Products</field>
    </record>

    <record id="demo_microsite_website" model="website">
        <field name="name">Demo Microsite Bakery Website</field>
        <field name="company_id" ref="demo_microsite_company"/>
        <!-- Turn on the corporate footer so the microsite look is
             demonstrable out of the box (it is off by default). -->
        <field name="is_microsite_themed" eval="True"/>
    </record>

</odoo>
