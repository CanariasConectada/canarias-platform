<odoo>

    <!-- Dynamic microsite homepage. Everything is read from the company of
         the current website at render time: editing the company fields
         updates the live page, no re-synchronization needed. -->
    <template id="microsite_homepage_content" name="Microsite Homepage Content">
        <t t-set="company" t-value="website.company_id.sudo()"/>

        <!-- Hero -->
        <section
            class="s_cover pt96 pb96 text-center"
            data-name="Hero"
            t-attf-style="#{'background-image: url(/web/image/res.company/%s/microsite_hero_image); background-size: cover; background-position: center;' % company.id if company.microsite_hero_image else 'background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);'} min-height: 60vh; display: flex; align-items: center; position: relative;"
        >
            <div
                style="position: absolute; inset: 0; background: rgba(0,0,0,0.4);"
            />
            <div class="container" style="position: relative;">
                <h1 class="display-4 text-white" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.7);">
                    <t t-esc="company.microsite_name or company.name"/>
                </h1>
                <p>
                    <a class="btn btn-lg btn-primary" href="/shop">
                        <t t-if="company.microsite_button_text">
                            <t t-esc="company.microsite_button_text"/>
                        </t>
                        <t t-else="">Shop</t>
                    </a>
                </p>
            </div>
        </section>

        <!-- Practical info: opening hours / delivery / parking -->
        <t t-set="opening_lines" t-value="company._get_microsite_opening_hours_lines()"/>
        <section
            t-if="opening_lines or company.microsite_delivery_info or company.microsite_parking_info"
            class="pt48 pb48"
            data-name="Practical Information"
        >
            <div class="container">
                <div class="row justify-content-center">
                    <div t-if="opening_lines" class="col-lg-4 pt16 pb16 text-center">
                        <span class="fa fa-clock-o fa-2x mb-3 d-block"/>
                        <h5 class="fw-bold">Opening Hours</h5>
                        <div class="text-start d-inline-block">
                            <div t-foreach="opening_lines" t-as="line" class="d-flex justify-content-between gap-3">
                                <span t-esc="line[0]"/>
                                <span t-esc="line[1]"/>
                            </div>
                        </div>
                    </div>
                    <div t-if="company.microsite_parking_info" class="col-lg-4 pt16 pb16 text-center">
                        <span class="fa fa-map-marker fa-2x mb-3 d-block"/>
                        <h5 class="fw-bold">Parking</h5>
                        <p class="text-muted" t-esc="company.microsite_parking_info"/>
                    </div>
                    <div t-if="company.microsite_delivery_info" class="col-lg-4 pt16 pb16 text-center">
                        <span class="fa fa-truck fa-2x mb-3 d-block"/>
                        <h5 class="fw-bold">Delivery / Shipping</h5>
                        <p class="text-muted" t-esc="company.microsite_delivery_info"/>
                    </div>
                </div>
            </div>
        </section>

        <!-- Intro banner -->
        <t t-call="partner_microsite_manager.microsite_banner">
            <t t-set="banner_title" t-value="company.microsite_intro_title"/>
            <t t-set="banner_image_field" t-value="'microsite_intro_image'"/>
            <t t-set="banner_has_image" t-value="bool(company.microsite_intro_image)"/>
        </t>

        <!-- About / Services -->
        <section
            t-if="company.microsite_about_text or company.microsite_services_text"
            class="pt48 pb56"
            data-name="About"
        >
            <div class="container">
                <div class="row justify-content-center">
                    <div t-if="company.microsite_about_text" class="col-lg-6 text-center border pt-4 pb-4">
                        <span class="fa fa-book fa-3x mb-3 d-block"/>
                        <h4>
                            <t t-if="company.microsite_about_title">
                                <t t-esc="company.microsite_about_title"/>
                            </t>
                            <t t-else="">About Us</t>
                        </h4>
                        <p class="text-muted px-4" t-esc="company.microsite_about_text"/>
                    </div>
                    <div t-if="company.microsite_services_text" class="col-lg-6 text-center border pt-4 pb-4">
                        <span class="fa fa-cogs fa-3x mb-3 d-block"/>
                        <h4>
                            <t t-if="company.microsite_services_title">
                                <t t-esc="company.microsite_services_title"/>
                            </t>
                            <t t-else="">Our Services</t>
                        </h4>
                        <p class="text-muted px-4" t-esc="company.microsite_services_text"/>
                    </div>
                </div>
            </div>
        </section>

        <!-- Closing banner -->
        <t t-call="partner_microsite_manager.microsite_banner">
            <t t-set="banner_title" t-value="company.microsite_banner_title"/>
            <t t-set="banner_image_field" t-value="'microsite_banner_image'"/>
            <t t-set="banner_has_image" t-value="bool(company.microsite_banner_image)"/>
        </t>

        <!-- Contact: address / phones / email + embedded map -->
        <t t-set="map_url" t-value="company._get_microsite_map_url()"/>
        <section class="pt48 pb48" data-name="Contact">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <h4 class="mb-3">
                            <span class="fa fa-map-marker me-2"/>
                            <strong>Find Us</strong>
                        </h4>
                        <p t-if="company.partner_id.contact_address" class="mb-2">
                            <i class="fa fa-map-marker fa-fw me-2"/>
                            <span t-esc="company.partner_id.contact_address"/>
                        </p>
                        <p t-if="company.partner_id.phone" class="mb-2">
                            <i class="fa fa-phone fa-fw me-2"/>
                            <span t-esc="company.partner_id.phone"/>
                        </p>
                        <p t-if="company.partner_id.email" class="mb-2">
                            <i class="fa fa-envelope fa-fw me-2"/>
                            <span t-esc="company.partner_id.email"/>
                        </p>
                        <p class="mt-3">
                            <a class="btn btn-secondary" href="/contactus">Contact Us</a>
                        </p>
                    </div>
                    <div class="col-lg-6">
                        <iframe
                            t-if="map_url"
                            t-att-src="map_url"
                            width="100%"
                            height="240"
                            style="border: 0; border-radius: 8px;"
                            title="Map"
                        />
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Full-width banner with an optional fixed background image.
         Parameters: banner_title, banner_image_field, banner_has_image. -->
    <template id="microsite_banner" name="Microsite Banner">
        <section
            t-if="banner_title or banner_has_image"
            class="pt104 pb120"
            data-name="Banner"
            t-attf-style="#{'background-image: url(/web/image/res.company/%s/%s); background-size: cover; background-position: center; background-attachment: fixed;' % (company.id, banner_image_field) if banner_has_image else 'background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);'} position: relative;"
        >
            <div
                t-if="banner_has_image"
                style="position: absolute; inset: 0; background: rgba(0,0,0,0.4);"
            />
            <div class="container" style="position: relative;">
                <h2 t-if="banner_title" class="text-center text-white" t-esc="banner_title"/>
            </div>
        </section>
    </template>

</odoo>
