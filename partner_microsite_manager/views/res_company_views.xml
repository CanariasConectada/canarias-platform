<odoo>

    <!-- The administrator's copy of the merchant's page content editor
         (views/microsite_content_views.xml): same sections, same order, same
         field order, same labels, so both sides of a support call are
         looking at the same screen (client report 2026-09-16). Merchants do
         not reach this page any more: the partner smart button sends them to
         the editor, which can save. What only an administrator does
         (publishing the homepage) sits at the end of the Cover section.

         `company_facilities` appends its own section to the nested notebook
         (`microsite_sections`); keep that name stable. -->
    <record id="view_company_form_microsite" model="ir.ui.view">
        <field name="name">res.company.form.microsite</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Microsite" name="microsite" invisible="not has_microsite">
                    <field name="has_microsite" invisible="1"/>
                    <group>
                        <field name="microsite_name" string="Trade name"
                               placeholder="How your shop is called on its page"/>
                    </group>
                    <notebook name="microsite_sections">
                        <page string="Cover" name="cover">
                            <group>
                                <group string="Header">
                                    <field name="microsite_button_text" string="Cover button"/>
                                    <field name="microsite_hero_image" string="Cover image"
                                           widget="image"/>
                                </group>
                                <group string="Banners">
                                    <field name="microsite_intro_title" string="Intro banner"/>
                                    <field name="microsite_intro_image" string="Intro banner image"
                                           widget="image"/>
                                    <field name="microsite_banner_title" string="Closing banner"/>
                                    <field name="microsite_banner_image" string="Closing banner image"
                                           widget="image"/>
                                </group>
                            </group>
                            <group string="Publication" name="publication">
                                <field name="website_id" readonly="1"/>
                                <field name="microsite_homepage_page_id" readonly="1"/>
                                <button
                                    name="action_publish_microsite_homepage"
                                    type="object"
                                    string="Publish Homepage"
                                    class="btn-primary"
                                    help="Replace the homepage of the company website with the dynamic microsite template."
                                    confirm="This replaces the current homepage of the company website with the microsite template. Continue?"
                                />
                            </group>
                        </page>
                        <page string="Practical information" name="practical">
                            <group string="Opening hours" name="opening_hours">
                                <field name="microsite_opening_slot_ids" nolabel="1" colspan="2">
                                    <list editable="bottom">
                                        <field name="weekday"/>
                                        <field name="open_time" widget="float_time"/>
                                        <field name="close_time" widget="float_time"/>
                                    </list>
                                </field>
                                <!-- Generated from the rows; editable by hand
                                     only while the company has none (legacy
                                     free notation). -->
                                <field
                                    name="microsite_opening_hours"
                                    string="Shown on the page"
                                    placeholder="e.g. L-V 10:00-13:30 / L-V 16:30-20:00 / S 10:00-14:00"
                                    readonly="microsite_opening_slot_ids"
                                />
                            </group>
                            <group>
                                <group>
                                    <field name="microsite_delivery_info" string="Delivery"/>
                                    <field name="microsite_parking_info" string="Parking and directions"/>
                                </group>
                                <group>
                                    <field name="microsite_phone" string="Phone"/>
                                    <field name="microsite_phone2" string="Second phone"
                                           invisible="not microsite_phone"/>
                                    <field name="microsite_map_url" string="Map"/>
                                </group>
                            </group>
                        </page>
                        <page string="About the shop" name="about">
                            <group>
                                <group string="Our story">
                                    <field name="microsite_about_title" nolabel="1"
                                           placeholder="Heading"/>
                                    <field name="microsite_about_text" nolabel="1"
                                           placeholder="Tell your customers who you are"/>
                                </group>
                                <group string="What we do">
                                    <field name="microsite_services_title" nolabel="1"
                                           placeholder="Heading"/>
                                    <field name="microsite_services_text" nolabel="1"
                                           placeholder="Tell your customers what you offer"/>
                                </group>
                            </group>
                        </page>
                        <page string="Social networks" name="social">
                            <p class="text-muted">
                                Shown at the bottom of your page. Leave a
                                network empty to hide its icon.
                            </p>
                            <group>
                                <group>
                                    <field name="website" string="Website" widget="url"
                                           placeholder="https://www.example.com"/>
                                    <field name="microsite_social_facebook" string="Facebook"
                                           placeholder="https://www.facebook.com/..."/>
                                    <field name="microsite_social_instagram" string="Instagram"
                                           placeholder="https://www.instagram.com/..."/>
                                    <field name="microsite_social_twitter" string="X/Twitter"
                                           placeholder="https://x.com/..."/>
                                </group>
                                <group>
                                    <field name="microsite_social_youtube" string="YouTube"
                                           placeholder="https://www.youtube.com/..."/>
                                    <field name="microsite_social_linkedin" string="LinkedIn"
                                           placeholder="https://www.linkedin.com/company/..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
