<odoo>

    <record id="view_partner_form_microsite" model="ir.ui.view">
        <field name="name">res.partner.form.microsite</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_open_microsite_company"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-globe"
                    invisible="not has_microsite"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Microsite</span>
                    </div>
                </button>
                <field name="has_microsite" invisible="1"/>
            </div>
        </field>
    </record>

</odoo>
