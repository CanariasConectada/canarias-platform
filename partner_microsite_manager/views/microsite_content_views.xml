<odoo>

    <!-- ================================================================
         The merchant's own view of their page content
         ================================================================
         The fields live on `res.company`, which every internal user can read
         and only `base.group_erp_manager` can write. Sending a merchant to
         the company form would have produced a screen that loads and then
         refuses to save; opening the ACL so that it saves would have handed
         218 shop owners their own VAT number and chart of accounts.

         So this is a screen of its own that reads the shop in and writes a
         whitelist back. See wizards/microsite_content_editor.py. -->
    <record id="view_microsite_content_editor_form" model="ir.ui.view">
        <field name="name">microsite.content.editor.form</field>
        <field name="model">microsite.content.editor</field>
        <field name="arch" type="xml">
            <form string="Page content">
                <sheet>
                    <div class="oe_title">
                        <label for="microsite_name" string="Trade name"/>
                        <h1>
                            <field name="microsite_name"
                                   placeholder="How your shop is called on its page"/>
                        </h1>
                        <field name="company_id" invisible="1"/>
                        <div class="text-muted" invisible="not website_url">
                            <i class="fa fa-globe me-1"/><field name="website_url" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                    <notebook>
                        <page string="Cover" name="cover">
                            <group>
                                <group string="Header">
                                    <field name="microsite_button_text"/>
                                    <field name="microsite_hero_image" widget="image"/>
                                </group>
                                <group string="Banners">
                                    <field name="microsite_intro_title"/>
                                    <field name="microsite_intro_image" widget="image"/>
                                    <field name="microsite_banner_title"/>
                                    <field name="microsite_banner_image" widget="image"/>
                                </group>
                            </group>
                        </page>
                        <page string="Practical information" name="practical">
                            <group>
                                <group>
                                    <field name="microsite_opening_hours"
                                           placeholder="e.g. L-V 10:00-13:30 / L-V 16:30-20:00 / S 10:00-14:00"/>
                                    <field name="microsite_delivery_info"/>
                                    <field name="microsite_parking_info"/>
                                </group>
                                <group>
                                    <field name="microsite_phone"/>
                                    <field name="microsite_phone2"
                                           invisible="not microsite_phone"/>
                                    <field name="microsite_map_url"/>
                                </group>
                            </group>
                        </page>
                        <page string="About the shop" name="about">
                            <group>
                                <group string="Our story">
                                    <field name="microsite_about_title" nolabel="1"
                                           placeholder="Heading"/>
                                    <field name="microsite_about_text" nolabel="1"
                                           placeholder="Tell your customers who you are"/>
                                </group>
                                <group string="What we do">
                                    <field name="microsite_services_title" nolabel="1"
                                           placeholder="Heading"/>
                                    <field name="microsite_services_text" nolabel="1"
                                           placeholder="Tell your customers what you offer"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save"
                            class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_own_microsite_content" model="ir.actions.act_window">
        <field name="name">Page content</field>
        <field name="res_model">microsite.content.editor</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Website › Configuration, which is where a merchant already works.
         `group_website_restricted_editor` is the group the 218 merchant
         accounts actually hold; the screen itself resolves the shop from the
         account, so the menu cannot be used to reach somebody else's page. -->
    <menuitem id="menu_own_microsite_content"
              name="Page content"
              parent="website.menu_website_configuration"
              action="action_own_microsite_content"
              groups="website.group_website_restricted_editor"
              sequence="4"/>

</odoo>
