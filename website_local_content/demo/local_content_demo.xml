<odoo>

    <!-- Living Memory taxonomy -->
    <record id="demo_category_lm_daily_life" model="website.local.content.category">
        <field name="name">Daily Life</field>
        <field name="type_id" ref="content_type_living_memory"/>
    </record>
    <record id="demo_subcategory_lm_shops" model="website.local.content.subcategory">
        <field name="name">Old Shops</field>
        <field name="category_id" ref="demo_category_lm_daily_life"/>
    </record>
    <record id="demo_category_lm_celebrations" model="website.local.content.category">
        <field name="name">Celebrations</field>
        <field name="type_id" ref="content_type_living_memory"/>
    </record>

    <!-- Places of Interest taxonomy -->
    <record id="demo_category_poi_culture" model="website.local.content.category">
        <field name="name">Culture</field>
        <field name="type_id" ref="content_type_places_of_interest"/>
    </record>
    <record id="demo_subcategory_poi_museums" model="website.local.content.subcategory">
        <field name="name">Museums</field>
        <field name="category_id" ref="demo_category_poi_culture"/>
    </record>
    <record id="demo_category_poi_nature" model="website.local.content.category">
        <field name="name">Nature</field>
        <field name="type_id" ref="content_type_places_of_interest"/>
    </record>

    <!-- Living Memory items -->
    <record id="demo_item_lm_bakery" model="website.local.content.item">
        <field name="name">The Old Corner Bakery</field>
        <field name="type_id" ref="content_type_living_memory"/>
        <field name="category_id" ref="demo_category_lm_daily_life"/>
        <field name="subcategory_id" ref="demo_subcategory_lm_shops"/>
        <field name="description">The bakery that fed three generations of the neighbourhood.</field>
        <field name="photo_year">1965</field>
        <field name="state">approved</field>
        <field name="is_published" eval="True"/>
        <field name="submitter_name">Maria the neighbour</field>
        <field name="image_1920"></field>
    </record>
    <record id="demo_item_lm_festival" model="website.local.content.item">
        <field name="name">San Juan Bonfires at the Beach</field>
        <field name="type_id" ref="content_type_living_memory"/>
        <field name="category_id" ref="demo_category_lm_celebrations"/>
        <field name="description">The whole neighbourhood gathered around the bonfires.</field>
        <field name="photo_year">1982</field>
        <field name="state">approved</field>
        <field name="is_published" eval="True"/>
        <field name="image_1920"></field>
    </record>
    <record id="demo_item_lm_pending" model="website.local.content.item">
        <field name="name">Pending Memory (not public)</field>
        <field name="type_id" ref="content_type_living_memory"/>
        <field name="category_id" ref="demo_category_lm_daily_life"/>
        <field name="photo_year">1990</field>
        <field name="state">pending</field>
        <field name="image_1920"></field>
    </record>

    <!-- Places of Interest items -->
    <record id="demo_item_poi_museum" model="website.local.content.item">
        <field name="name">Neighbourhood History Museum</field>
        <field name="type_id" ref="content_type_places_of_interest"/>
        <field name="category_id" ref="demo_category_poi_culture"/>
        <field name="subcategory_id" ref="demo_subcategory_poi_museums"/>
        <field name="description">Small museum with the photographic archive of the area.</field>
        <field name="address">Calle Mayor, 12</field>
        <field name="city">Las Palmas de Gran Canaria</field>
        <field name="district">Guanarteme</field>
        <field name="phone">+34 928 000 000</field>
        <field name="opening_hours">Mon-Fri 10:00-18:00</field>
        <field name="state">approved</field>
        <field name="is_published" eval="True"/>
        <field name="image_1920"></field>
    </record>
    <record id="demo_item_poi_park" model="website.local.content.item">
        <field name="name">Seaside Park</field>
        <field name="type_id" ref="content_type_places_of_interest"/>
        <field name="category_id" ref="demo_category_poi_nature"/>
        <field name="description">Green area by the sea, perfect for families.</field>
        <field name="latitude">28.14000000</field>
        <field name="longitude">-15.43000000</field>
        <field name="state">approved</field>
        <field name="is_published" eval="True"/>
        <field name="image_1920"></field>
    </record>

    <!-- Gallery image and a couple of anonymous likes -->
    <record id="demo_image_lm_bakery_inside" model="website.local.content.image">
        <field name="name">Inside the bakery</field>
        <field name="item_id" ref="demo_item_lm_bakery"/>
        <field name="image_1920"></field>
    </record>
    <record id="demo_like_lm_bakery_1" model="website.local.content.like">
        <field name="item_id" ref="demo_item_lm_bakery"/>
        <field name="session_key">demo-session-0001</field>
        <field name="ip_address">127.0.0.1</field>
    </record>
    <record id="demo_like_poi_museum_1" model="website.local.content.like">
        <field name="item_id" ref="demo_item_poi_museum"/>
        <field name="session_key">demo-session-0002</field>
        <field name="ip_address">127.0.0.1</field>
    </record>

</odoo>
