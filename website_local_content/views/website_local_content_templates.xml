<odoo>

    <!-- Floating like button over the card image (legacy design). The click
         is handled by static/src/js/website_local_content.js (fetch POST to
         the existing like route); the <noscript> form keeps the feature
         working, and the CSRF token discoverable, without JavaScript.
         Expects `item`, `content_type`, `already_liked` and optionally
         `redirect_url` in the rendering context. -->
    <template id="content_like_button" name="Local Content Like Button">
        <button type="button"
                class="position-absolute top-0 end-0 m-2 btn btn-light btn-sm rounded-circle shadow-sm wlc-like-btn"
                t-attf-data-like-url="/explora/{{ content_type.url_slug }}/like/{{ item.id }}"
                t-att-data-csrf="request.csrf_token()"
                t-att-data-liked="'1' if already_liked else '0'"
                t-att-aria-pressed="'true' if already_liked else 'false'"
                aria-label="Like">
            <i t-attf-class="fa {{ 'fa-heart' if already_liked else 'fa-heart-o' }} text-danger"/>
        </button>
        <noscript>
            <form t-if="not already_liked"
                  t-attf-action="/explora/{{ content_type.url_slug }}/like/{{ item.id }}"
                  method="post"
                  class="position-absolute top-0 end-0 m-2 wlc-like-noscript">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="redirect" t-att-value="redirect_url or item.website_url"/>
                <button type="submit" class="btn btn-light btn-sm rounded-circle shadow-sm wlc-like-btn" aria-label="Like">
                    <i class="fa fa-heart-o text-danger"/>
                </button>
            </form>
        </noscript>
    </template>

    <!-- Read-only star row (0..5 filled stars). Expects `stars`.
         Same visual pattern as partner_reviews.review_stars, duplicated
         here to keep this module independent from the merchant reviews
         module. -->
    <template id="content_rating_stars" name="Local Content Rating Stars">
        <span class="wlc-rating-stars" t-att-aria-label="'%s/5' % int(stars)">
            <t t-foreach="range(1, 6)" t-as="star">
                <span t-attf-class="wlc-rating-star #{'filled' if star &lt;= int(stars) else ''}">★</span>
            </t>
        </span>
    </template>

    <!-- Institutional sponsor band (e.g. Gobierno de Canarias on Living
         Memory). Rendered on every public page of a type that carries a
         sponsor logo; nothing otherwise. Expects `content_type`. -->
    <template id="content_sponsor_band" name="Local Content Sponsor Band">
        <section t-if="content_type.sponsor_logo" class="py-3 bg-light border-top text-center wlc-sponsor-band">
            <div class="container">
                <img t-att-src="content_type.get_sponsor_logo_url()"
                     t-att-alt="content_type.sponsor_name or ''"
                     class="img-fluid wlc-sponsor-logo"
                     loading="lazy"/>
            </div>
        </section>
    </template>

    <!-- One grid card (legacy design: photo with gradient overlay, badges
         over the image and a floating like button). Expects `item`,
         `content_type`, `liked_item_ids`. -->
    <template id="content_item_card" name="Local Content Item Card">
        <div class="col-6 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm overflow-hidden wlc-card">
                <a t-att-href="item.website_url" class="text-decoration-none text-dark">
                    <div class="card-img-top position-relative wlc-card-img-box">
                        <img t-att-src="item.get_image_url(size=512)"
                             class="w-100 h-100 wlc-card-img"
                             t-att-alt="item.name"
                             loading="lazy"/>
                        <!-- Bottom gradient overlay: year, likes, rating -->
                        <div class="position-absolute bottom-0 start-0 w-100 p-2 wlc-card-overlay">
                            <div class="d-flex align-items-center gap-1 flex-wrap">
                                <span t-if="content_type.use_photo_year and item.photo_year" class="badge bg-primary">
                                    <i class="fa fa-calendar me-1"/><t t-esc="item.photo_year"/>
                                </span>
                                <span class="badge bg-light text-dark">
                                    <i class="fa fa-heart text-danger me-1"/><span class="wlc-like-count" t-esc="item.like_count"/>
                                </span>
                                <span class="badge bg-light text-dark">
                                    <i class="fa fa-star text-warning me-1"/><t t-esc="'%.1f' % (item.rating_avg or 0)"/>
                                </span>
                            </div>
                        </div>
                        <!-- Category badge (top-left corner) -->
                        <div t-if="item.category_id" class="position-absolute top-0 start-0 p-2">
                            <span class="badge bg-secondary">
                                <i class="fa fa-tag me-1"/><t t-esc="item.category_id.name"/>
                            </span>
                        </div>
                    </div>
                    <div class="card-body p-3">
                        <h5 class="card-title fs-6 fw-bold text-truncate" t-esc="item.name" t-att-title="item.name"/>
                        <p t-if="item.description" class="card-text text-muted small mb-0 wlc-card-teaser" t-esc="item.description"/>
                    </div>
                </a>
                <t t-call="website_local_content.content_like_button">
                    <t t-set="already_liked" t-value="item.id in liked_item_ids"/>
                    <t t-set="redirect_url" t-value="request.httprequest.full_path"/>
                </t>
            </div>
        </div>
    </template>

    <!-- Index page: photo hero with search, sidebar filter cards, grid and
         hand-built pager (legacy design). -->
    <template id="content_index" name="Local Content Index">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Hero with background photograph and overlay -->
                <!-- No py-5: its !important padding was silently winning
                     over .wlc-hero's 120px design (the stylesheet also
                     shrinks it on small screens). -->
                <section class="border-bottom position-relative wlc-hero"
                         t-attf-style="{{ 'background: url(%s) center/cover no-repeat;' % content_type.get_hero_image_url() if content_type.hero_image else '' }}">
                    <div class="position-absolute top-0 start-0 w-100 h-100 wlc-hero-overlay"/>
                    <div class="container position-relative wlc-hero-content">
                        <div class="row justify-content-center">
                            <div class="col-lg-8 text-center">
                                <h1 class="display-4 mb-3 fw-bold text-white" t-esc="content_type.name"/>
                                <p t-if="content_type.hero_subtitle or content_type.description"
                                   class="lead mb-4 text-white-50"
                                   t-esc="content_type.hero_subtitle or content_type.description"/>
                                <form t-attf-action="{{ base_url }}#entries_grid" method="get"
                                      class="input-group input-group-lg mb-3" role="search">
                                    <input type="text" name="search" class="form-control border-end-0"
                                           placeholder="Search..." t-att-value="search or ''"/>
                                    <button type="submit" class="btn btn-light px-4">
                                        <i class="fa fa-search me-2 text-primary"/>Search
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="container-lg container py-4 mb-5">
                    <t t-set="active_categories" t-value="[c for c in categories if c['id'] == category_id]"/>
                    <t t-set="active_category" t-value="active_categories[0] if active_categories else None"/>
                    <div class="row">
                        <!-- Sidebar filters (stacked cards, auto-submit selects) -->
                        <aside class="col-12 col-lg-3 mb-4">
                            <div t-if="search" class="mb-3">
                                <span class="badge bg-info text-dark px-3 py-2 d-inline-block text-truncate mw-100 wlc-search-badge">
                                    <i class="fa fa-search me-2"/><t t-esc="search"/>
                                </span>
                            </div>
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-white py-3">
                                    <h6 class="mb-0 fw-bold">
                                        <i class="fa fa-tags text-primary me-2"/>Category
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <form method="get" t-attf-action="{{ index_url }}#entries_grid">
                                        <input type="hidden" name="search" t-att-value="search" t-if="search"/>
                                        <input type="hidden" name="decade" t-att-value="decade" t-if="decade"/>
                                        <input type="hidden" name="sort" t-att-value="sort" t-if="sort != 'newest'"/>
                                        <input type="hidden" name="limit" t-att-value="ppg" t-if="ppg != 12"/>
                                        <select name="category" class="form-select" onchange="this.form.submit()">
                                            <option value="">All categories</option>
                                            <t t-foreach="categories" t-as="category">
                                                <option t-att-value="category['id']"
                                                        t-att-selected="category_id == category['id']">
                                                    <t t-esc="category['name']"/> (<t t-esc="category['count']"/>)
                                                </option>
                                            </t>
                                        </select>
                                    </form>
                                    <form t-if="active_category and active_category['subcategories']"
                                          method="get" t-attf-action="{{ base_url }}#entries_grid" class="mt-2">
                                        <input type="hidden" name="search" t-att-value="search" t-if="search"/>
                                        <input type="hidden" name="decade" t-att-value="decade" t-if="decade"/>
                                        <input type="hidden" name="sort" t-att-value="sort" t-if="sort != 'newest'"/>
                                        <input type="hidden" name="limit" t-att-value="ppg" t-if="ppg != 12"/>
                                        <select name="subcategory" class="form-select" onchange="this.form.submit()">
                                            <option value="">All subcategories</option>
                                            <t t-foreach="active_category['subcategories']" t-as="subcategory">
                                                <option t-att-value="subcategory['id']"
                                                        t-att-selected="subcategory_id == subcategory['id']"
                                                        t-esc="subcategory['name']"/>
                                            </t>
                                        </select>
                                    </form>
                                </div>
                            </div>
                            <div t-if="content_type.use_photo_year and decades" class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-white py-3">
                                    <h6 class="mb-0 fw-bold">
                                        <i class="fa fa-calendar text-primary me-2"/>Decade
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <form method="get" t-attf-action="{{ base_url }}#entries_grid">
                                        <input type="hidden" name="search" t-att-value="search" t-if="search"/>
                                        <input type="hidden" name="subcategory" t-att-value="subcategory_id" t-if="subcategory_id"/>
                                        <input type="hidden" name="sort" t-att-value="sort" t-if="sort != 'newest'"/>
                                        <input type="hidden" name="limit" t-att-value="ppg" t-if="ppg != 12"/>
                                        <select name="decade" class="form-select" onchange="this.form.submit()">
                                            <option value="">All decades</option>
                                            <t t-foreach="decades" t-as="decade_option">
                                                <option t-att-value="decade_option"
                                                        t-att-selected="decade == decade_option">
                                                    <t t-esc="decade_option"/>-<t t-esc="decade_option + 9"/>
                                                </option>
                                            </t>
                                        </select>
                                    </form>
                                </div>
                            </div>
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-white py-3">
                                    <h6 class="mb-0 fw-bold">
                                        <i class="fa fa-sort text-primary me-2"/>Sort by
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <form method="get" t-attf-action="{{ base_url }}#entries_grid">
                                        <input type="hidden" name="search" t-att-value="search" t-if="search"/>
                                        <input type="hidden" name="subcategory" t-att-value="subcategory_id" t-if="subcategory_id"/>
                                        <input type="hidden" name="decade" t-att-value="decade" t-if="decade"/>
                                        <input type="hidden" name="limit" t-att-value="ppg" t-if="ppg != 12"/>
                                        <select name="sort" class="form-select" onchange="this.form.submit()">
                                            <option value="rating" t-att-selected="sort == 'rating'">⭐ Best rated</option>
                                            <option value="likes" t-att-selected="sort == 'likes'">❤️ Most liked</option>
                                            <option value="newest" t-att-selected="sort == 'newest'">🕐 Newest first</option>
                                            <option value="oldest" t-att-selected="sort == 'oldest'">📅 Oldest first</option>
                                            <t t-if="content_type.use_photo_year">
                                                <option value="year_desc" t-att-selected="sort == 'year_desc'">📷 Photo year (newest)</option>
                                                <option value="year_asc" t-att-selected="sort == 'year_asc'">📷 Photo year (oldest)</option>
                                            </t>
                                        </select>
                                    </form>
                                </div>
                            </div>
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-white py-3">
                                    <h6 class="mb-0 fw-bold">
                                        <i class="fa fa-list-ol text-primary me-2"/>Show
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <form method="get" t-attf-action="{{ base_url }}#entries_grid">
                                        <input type="hidden" name="search" t-att-value="search" t-if="search"/>
                                        <input type="hidden" name="subcategory" t-att-value="subcategory_id" t-if="subcategory_id"/>
                                        <input type="hidden" name="decade" t-att-value="decade" t-if="decade"/>
                                        <input type="hidden" name="sort" t-att-value="sort" t-if="sort != 'newest'"/>
                                        <select name="limit" class="form-select" onchange="this.form.submit()">
                                            <t t-foreach="ppg_options" t-as="ppg_option">
                                                <option t-att-value="ppg_option"
                                                        t-att-selected="ppg == ppg_option">
                                                    <t t-esc="ppg_option"/> per page
                                                </option>
                                            </t>
                                        </select>
                                    </form>
                                    <div class="mt-2 text-center">
                                        <span class="badge bg-secondary">
                                            <t t-esc="items_count"/> in total
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div t-if="has_active_filters" class="d-grid mt-3">
                                <a t-attf-href="{{ index_url }}#entries_grid" class="btn btn-outline-danger">
                                    <i class="fa fa-trash me-2"/>Remove filters
                                </a>
                            </div>
                        </aside>
                        <!-- Results -->
                        <div class="col-12 col-lg-9">
                            <div class="products_header d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 bg-light rounded mb-4">
                                <div class="d-flex align-items-center flex-wrap gap-2">
                                    <span class="text-muted">
                                        <strong t-esc="items_count"/> results
                                    </span>
                                    <t t-if="active_category or decade">
                                        <span class="text-muted">|</span>
                                        <span t-if="active_category" class="badge bg-primary" t-esc="active_category['name']"/>
                                        <span t-if="decade" class="badge bg-primary">
                                            Decade <t t-esc="decade"/>-<t t-esc="decade + 9"/>
                                        </span>
                                    </t>
                                </div>
                            </div>
                            <div t-if="items" id="entries_grid" class="row g-4">
                                <t t-foreach="items" t-as="item">
                                    <t t-call="website_local_content.content_item_card"/>
                                </t>
                            </div>
                            <div t-else="" id="entries_grid" class="alert alert-info">
                                No content matches your filters.
                            </div>
                            <!-- Hand-built pagination (legacy design: every page
                                 number, chevrons, query string preserved). -->
                            <t t-if="total_pages > 1">
                                <t t-set="qs_suffix" t-value="('?' + page_qs if page_qs else '') + '#entries_grid'"/>
                                <nav aria-label="Page navigation" class="mt-4">
                                    <ul class="pagination justify-content-center flex-wrap">
                                        <li t-attf-class="page-item {{ 'disabled' if page == 1 else '' }}">
                                            <a t-att-href="(base_url if page - 1 &lt;= 1 else '%s/page/%s' % (base_url, page - 1)) + qs_suffix"
                                               class="page-link" aria-label="Previous">
                                                <span aria-hidden="true"><i class="fa fa-chevron-left"/></span>
                                            </a>
                                        </li>
                                        <t t-foreach="range(1, total_pages + 1)" t-as="p">
                                            <li t-attf-class="page-item {{ 'active' if p == page else '' }}">
                                                <a t-att-href="(base_url if p == 1 else '%s/page/%s' % (base_url, p)) + qs_suffix"
                                                   class="page-link" t-esc="p"/>
                                            </li>
                                        </t>
                                        <li t-attf-class="page-item {{ 'disabled' if page == total_pages else '' }}">
                                            <a t-att-href="'%s/page/%s' % (base_url, page + 1 if page &lt; total_pages else total_pages) + qs_suffix"
                                               class="page-link" aria-label="Next">
                                                <span aria-hidden="true"><i class="fa fa-chevron-right"/></span>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                                <div class="text-center text-muted small mt-2">
                                    Page <strong t-esc="page"/> of <strong t-esc="total_pages"/> — <strong t-esc="items_count"/> in total
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
                <t t-call="website_local_content.content_sponsor_band"/>
            </div>
        </t>
    </template>

    <!-- Detail page: main card + gallery card + reviews on the left,
         information / rating cards on the right (legacy design). -->
    <template id="content_detail" name="Local Content Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a t-att-href="index_url" t-esc="content_type.name"/>
                            </li>
                            <li t-if="item.category_id" class="breadcrumb-item">
                                <a t-attf-href="{{ index_url }}/categoria/{{ item.category_id.id }}" t-esc="item.category_id.name"/>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page" t-esc="item.name"/>
                        </ol>
                    </nav>
                    <div class="row">
                        <div class="col-lg-8">
                            <!-- Main card: image, title, badges, story -->
                            <div class="card border-0 shadow-sm mb-4">
                                <img t-att-src="item.get_image_url(size=1024)"
                                     class="card-img-top wlc-detail-img"
                                     t-att-alt="item.name"
                                     loading="eager"/>
                                <div class="card-body">
                                    <h1 class="card-title mb-3" t-esc="item.name"/>
                                    <div class="mb-3">
                                        <span class="badge bg-primary me-2">
                                            <i class="fa fa-map-marker me-1"/><t t-esc="content_type.name"/>
                                        </span>
                                        <span t-if="item.category_id" class="badge bg-primary me-2">
                                            <i class="fa fa-tag me-1"/><t t-esc="item.category_id.name"/>
                                        </span>
                                        <span t-if="item.subcategory_id" class="badge bg-info me-2" t-esc="item.subcategory_id.name"/>
                                        <span t-foreach="item.tag_ids" t-as="tag" class="badge bg-secondary fw-normal me-1" t-esc="tag.name"/>
                                        <span t-if="content_type.use_photo_year and item.photo_year" class="badge bg-dark">
                                            <i class="fa fa-camera me-1"/><t t-esc="item.photo_year"/>
                                        </span>
                                    </div>
                                    <p t-if="item.description" class="lead text-muted" t-esc="item.description"/>
                                    <div t-if="item.body" class="mt-4">
                                        <h5 t-if="content_type.use_photo_year">Story</h5>
                                        <h5 t-else="">Description</h5>
                                        <div t-field="item.body"/>
                                    </div>
                                    <div t-if="item.address or item.city" class="mt-4">
                                        <h5><i class="fa fa-map-marker text-primary me-2"/>Location</h5>
                                        <p class="mb-0">
                                            <t t-if="item.address" t-esc="item.address"/>
                                            <t t-if="item.city"><t t-if="item.address"> · </t><t t-esc="item.city"/></t>
                                            <t t-if="item.district"> · <t t-esc="item.district"/></t>
                                        </p>
                                    </div>
                                    <div t-if="item.opening_hours" class="mt-4">
                                        <h5><i class="fa fa-clock-o text-primary me-2"/>Opening Hours</h5>
                                        <p class="mb-0 wlc-pre-line" t-esc="item.opening_hours"/>
                                    </div>
                                    <ul t-if="item.phone or item.whatsapp or item.instagram or item.tiktok or item.external_website"
                                        class="list-unstyled mt-4 mb-0 wlc-detail-meta">
                                        <li t-if="item.phone"><i class="fa fa-phone me-2"/><a t-attf-href="tel:{{ item.phone }}" t-esc="item.phone"/></li>
                                        <li t-if="item.whatsapp"><i class="fa fa-whatsapp me-2"/><t t-esc="item.whatsapp"/></li>
                                        <li t-if="item.instagram"><i class="fa fa-instagram me-2"/><t t-esc="item.instagram"/></li>
                                        <li t-if="item.tiktok"><i class="fa fa-music me-2"/><t t-esc="item.tiktok"/></li>
                                        <li t-if="item.external_website">
                                            <i class="fa fa-globe me-2"/>
                                            <a t-att-href="item.get_external_website_url()" target="_blank" rel="noopener nofollow" t-esc="item.external_website"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <!-- Gallery card -->
                            <div t-if="item.image_ids" class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fa fa-images me-2 text-primary"/>Gallery</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <t t-foreach="item.image_ids" t-as="gallery_image">
                                            <div class="col-6 col-md-4">
                                                <a t-attf-href="{{ index_url }}/img/{{ item.id }}/{{ gallery_image.id }}"
                                                   target="_blank" rel="noopener">
                                                    <img t-attf-src="{{ index_url }}/img/{{ item.id }}/{{ gallery_image.id }}?size=512"
                                                         class="img-fluid rounded shadow-sm wlc-gallery-thumb"
                                                         t-att-alt="gallery_image.name or item.name"
                                                         loading="lazy"/>
                                                </a>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <!-- Reviews (read-only, migrated legacy ratings) -->
                            <section t-if="reviews" id="wlc_reviews" class="wlc-reviews mb-4">
                                <h3 class="mb-3">
                                    Reviews
                                    <span class="badge text-bg-secondary align-middle" t-esc="len(reviews)"/>
                                </h3>
                                <t t-foreach="reviews" t-as="review">
                                    <div class="card border-0 shadow-sm mb-3 wlc-review-card">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <strong t-esc="item.get_rating_author_name(review)"/>
                                                <small class="text-muted" t-esc="review.write_date.strftime('%d/%m/%Y')"/>
                                            </div>
                                            <t t-call="website_local_content.content_rating_stars">
                                                <t t-set="stars" t-value="round(review.rating)"/>
                                            </t>
                                            <p class="mb-0 mt-2" t-if="review.feedback" t-esc="review.feedback"/>
                                        </div>
                                    </div>
                                </t>
                            </section>
                        </div>
                        <!-- Sidebar -->
                        <div class="col-lg-4">
                            <a t-att-href="index_url" class="btn btn-outline-primary w-100 mb-3">
                                <i class="fa fa-arrow-left me-2"/>Back to <t t-esc="content_type.name"/>
                            </a>
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fa fa-user me-2"/>Information</h5>
                                </div>
                                <div class="card-body">
                                    <p class="mb-1">
                                        <strong>Shared by:</strong>
                                        <!-- First name only, as in the legacy pages (privacy). -->
                                        <t t-set="submitter_parts" t-value="(item.submitter_name or '').split()"/>
                                        <span t-if="submitter_parts" t-esc="submitter_parts[0]"/>
                                        <span t-else="">Anonymous</span>
                                    </p>
                                    <p class="mb-1 text-muted small">
                                        <i class="fa fa-calendar me-1"/>
                                        <t t-esc="item.create_date.strftime('%d/%m/%Y') if item.create_date else '-'"/>
                                    </p>
                                    <p class="mb-0">
                                        <i class="fa fa-heart text-danger me-1"/>
                                        <span t-esc="item.like_count"/> likes
                                    </p>
                                </div>
                            </div>
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fa fa-star me-2 text-warning"/>Rating</h5>
                                </div>
                                <div class="card-body text-center">
                                    <div class="mb-2">
                                        <span class="display-4 fw-bold text-primary" t-esc="'%.1f' % (item.rating_avg or 0)"/>
                                        <small class="text-muted">/5</small>
                                    </div>
                                    <div class="mb-2">
                                        <t t-set="full_stars" t-value="int(item.rating_avg or 0)"/>
                                        <t t-set="has_half_star" t-value="(item.rating_avg or 0) - full_stars &gt;= 0.5"/>
                                        <t t-foreach="range(5)" t-as="star_index">
                                            <i t-if="star_index &lt; full_stars" class="fa fa-star text-warning fs-5"/>
                                            <i t-elif="star_index == full_stars and has_half_star" class="fa fa-star-half-o text-warning fs-5"/>
                                            <i t-else="" class="fa fa-star-o text-muted fs-5"/>
                                        </t>
                                    </div>
                                    <p class="text-muted small mb-0">
                                        <t t-esc="item.rating_count or 0"/> ratings
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <t t-call="website_local_content.content_sponsor_band"/>
            </div>
        </t>
    </template>

</odoo>
