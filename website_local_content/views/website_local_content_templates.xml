<odoo>

    <!-- Like button: a plain server-rendered form POST, no JavaScript.
         Expects `item`, `content_type`, `already_liked` and optionally
         `redirect_url` in the rendering context. -->
    <template id="content_like_button" name="Local Content Like Button">
        <form t-if="not already_liked"
              t-attf-action="/explora/{{ content_type.url_slug }}/like/{{ item.id }}"
              method="post" class="d-inline">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="redirect" t-att-value="redirect_url or item.website_url"/>
            <button type="submit" class="btn btn-outline-danger btn-sm wlc-like-btn">
                <i class="fa fa-heart-o me-1"/><t t-esc="item.like_count"/>
            </button>
        </form>
        <span t-else="" class="btn btn-danger btn-sm disabled wlc-like-btn">
            <i class="fa fa-heart me-1"/><t t-esc="item.like_count"/>
        </span>
    </template>

    <!-- One grid card. Expects `item`, `content_type`, `liked_item_ids`. -->
    <template id="content_item_card" name="Local Content Item Card">
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card h-100 border-0 shadow-sm wlc-card">
                <a t-att-href="item.website_url" class="text-decoration-none">
                    <div class="wlc-card-img-wrap">
                        <img t-att-src="item.get_image_url()" class="card-img-top wlc-card-img" t-att-alt="item.name" loading="lazy"/>
                        <span t-if="content_type.use_photo_year and item.photo_year" class="badge text-bg-dark wlc-year-badge" t-esc="item.photo_year"/>
                    </div>
                </a>
                <div class="card-body">
                    <h5 class="card-title fs-6 mb-1">
                        <a t-att-href="item.website_url" class="text-decoration-none text-body" t-esc="item.name"/>
                    </h5>
                    <p t-if="item.description" class="card-text text-muted small mb-2 wlc-card-teaser" t-esc="item.description"/>
                    <span t-if="item.category_id" class="badge text-bg-primary fw-normal me-1" t-esc="item.category_id.name"/>
                    <span t-if="item.subcategory_id" class="badge text-bg-info fw-normal" t-esc="item.subcategory_id.name"/>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0 pb-3 d-flex justify-content-between align-items-center">
                    <t t-call="website_local_content.content_like_button">
                        <t t-set="already_liked" t-value="item.id in liked_item_ids"/>
                        <t t-set="redirect_url" t-value="request.httprequest.full_path"/>
                    </t>
                    <a t-att-href="item.website_url" class="btn btn-link btn-sm">View</a>
                </div>
            </div>
        </div>
    </template>

    <!-- Index page: hero + sidebar filters + grid + pager. -->
    <template id="content_index" name="Local Content Index">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="wlc-hero py-5 text-center text-white">
                    <div class="container">
                        <h1 t-esc="content_type.name"/>
                        <p t-if="content_type.description" class="lead mb-0" t-esc="content_type.description"/>
                    </div>
                </section>
                <div class="container py-4">
                    <div class="row">
                        <!-- Sidebar filters -->
                        <aside class="col-12 col-lg-3 mb-4">
                            <form t-att-action="base_url" method="get" class="mb-3" role="search">
                                <div class="input-group">
                                    <input type="text" name="search" class="form-control" placeholder="Search..." t-att-value="search"/>
                                    <button class="btn btn-primary" type="submit"><i class="fa fa-search"/></button>
                                </div>
                            </form>
                            <div class="list-group mb-3">
                                <a t-att-href="index_url" t-attf-class="list-group-item list-group-item-action {{ '' if category_id else 'active' }}">
                                    All categories
                                </a>
                                <t t-foreach="categories" t-as="category">
                                    <a t-attf-href="{{ index_url }}/categoria/{{ category['id'] }}"
                                       t-attf-class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ 'active' if category_id == category['id'] else '' }}">
                                        <span t-esc="category['name']"/>
                                        <span class="badge text-bg-secondary rounded-pill" t-esc="category['count']"/>
                                    </a>
                                    <t t-if="category_id == category['id'] and category['subcategories']">
                                        <t t-foreach="category['subcategories']" t-as="subcategory">
                                            <a t-attf-href="{{ base_url }}?subcategory={{ subcategory['id'] }}"
                                               t-attf-class="list-group-item list-group-item-action ps-4 small {{ 'active' if subcategory_id == subcategory['id'] else '' }}"
                                               t-esc="subcategory['name']"/>
                                        </t>
                                    </t>
                                </t>
                            </div>
                            <div t-if="decades" class="mb-3">
                                <h6>Decade</h6>
                                <div class="d-flex flex-wrap gap-1">
                                    <a t-att-href="base_url" t-attf-class="badge text-decoration-none {{ 'text-bg-dark' if not decade else 'text-bg-light' }}">All</a>
                                    <t t-foreach="decades" t-as="decade_option">
                                        <a t-attf-href="{{ base_url }}?decade={{ decade_option }}"
                                           t-attf-class="badge text-decoration-none {{ 'text-bg-dark' if decade == decade_option else 'text-bg-light' }}">
                                            <t t-esc="decade_option"/>s
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </aside>
                        <!-- Results -->
                        <div class="col-12 col-lg-9">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted">
                                    <t t-esc="items_count"/> results
                                </span>
                                <form t-att-action="base_url" method="get">
                                    <input t-if="search" type="hidden" name="search" t-att-value="search"/>
                                    <select name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
                                        <option value="newest" t-att-selected="sort == 'newest'">Newest first</option>
                                        <option value="oldest" t-att-selected="sort == 'oldest'">Oldest first</option>
                                        <option value="likes" t-att-selected="sort == 'likes'">Most liked</option>
                                        <t t-if="content_type.use_photo_year">
                                            <option value="year_asc" t-att-selected="sort == 'year_asc'">Photo year (oldest)</option>
                                            <option value="year_desc" t-att-selected="sort == 'year_desc'">Photo year (newest)</option>
                                        </t>
                                    </select>
                                </form>
                            </div>
                            <div t-if="items" id="entries_grid" class="row g-3">
                                <t t-foreach="items" t-as="item">
                                    <t t-call="website_local_content.content_item_card"/>
                                </t>
                            </div>
                            <div t-else="" class="alert alert-info">
                                No content matches your filters.
                            </div>
                            <div class="d-flex justify-content-center mt-4">
                                <t t-call="website.pager"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Detail page. -->
    <template id="content_detail" name="Local Content Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-4">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a t-att-href="index_url" t-esc="content_type.name"/>
                            </li>
                            <li t-if="item.category_id" class="breadcrumb-item">
                                <a t-attf-href="{{ index_url }}/categoria/{{ item.category_id.id }}" t-esc="item.category_id.name"/>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page" t-esc="item.name"/>
                        </ol>
                    </nav>
                    <div class="row g-4">
                        <div class="col-12 col-lg-7">
                            <img t-att-src="item.get_image_url()" class="img-fluid rounded shadow-sm w-100 wlc-detail-img" t-att-alt="item.name"/>
                            <div t-if="item.image_ids" class="row g-2 mt-1">
                                <t t-foreach="item.image_ids" t-as="gallery_image">
                                    <div class="col-3">
                                        <img t-attf-src="{{ index_url }}/img/{{ item.id }}/{{ gallery_image.id }}"
                                             class="img-fluid rounded wlc-gallery-thumb"
                                             t-att-alt="gallery_image.name or item.name"
                                             loading="lazy"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="d-flex align-items-start justify-content-between">
                                <h1 class="h2" t-esc="item.name"/>
                                <t t-call="website_local_content.content_like_button"/>
                            </div>
                            <div class="mb-3">
                                <span t-if="item.category_id" class="badge text-bg-primary me-1" t-esc="item.category_id.name"/>
                                <span t-if="item.subcategory_id" class="badge text-bg-info me-1" t-esc="item.subcategory_id.name"/>
                                <span t-if="content_type.use_photo_year and item.photo_year" class="badge text-bg-dark">
                                    <i class="fa fa-camera me-1"/><t t-esc="item.photo_year"/>
                                </span>
                            </div>
                            <p t-if="item.description" class="lead" t-esc="item.description"/>
                            <ul class="list-unstyled wlc-detail-meta">
                                <li t-if="item.address"><i class="fa fa-map-marker me-2"/><t t-esc="item.address"/></li>
                                <li t-if="item.city"><i class="fa fa-building-o me-2"/><t t-esc="item.city"/><t t-if="item.district"> · <t t-esc="item.district"/></t></li>
                                <li t-if="item.phone"><i class="fa fa-phone me-2"/><a t-attf-href="tel:{{ item.phone }}" t-esc="item.phone"/></li>
                                <li t-if="item.whatsapp"><i class="fa fa-whatsapp me-2"/><t t-esc="item.whatsapp"/></li>
                                <li t-if="item.instagram"><i class="fa fa-instagram me-2"/><t t-esc="item.instagram"/></li>
                                <li t-if="item.tiktok"><i class="fa fa-music me-2"/><t t-esc="item.tiktok"/></li>
                                <li t-if="item.external_website">
                                    <i class="fa fa-globe me-2"/>
                                    <a t-att-href="item.external_website" target="_blank" rel="noopener" t-esc="item.external_website"/>
                                </li>
                                <li t-if="item.opening_hours"><i class="fa fa-clock-o me-2"/><span class="wlc-pre-line" t-esc="item.opening_hours"/></li>
                            </ul>
                            <p t-if="item.submitter_name" class="text-muted small">
                                Shared by <t t-esc="item.submitter_name"/>
                            </p>
                        </div>
                    </div>
                    <div t-if="item.body" class="row mt-4">
                        <div class="col-12 col-lg-9">
                            <div t-field="item.body"/>
                        </div>
                    </div>
                    <a t-att-href="index_url" class="btn btn-outline-secondary mt-4">
                        <i class="fa fa-arrow-left me-1"/>Back to <t t-esc="content_type.name"/>
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>
