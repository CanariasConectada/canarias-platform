<odoo>

    <record id="local_content_item_view_list" model="ir.ui.view">
        <field name="name">website.local.content.item.view.list</field>
        <field name="model">website.local.content.item</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pending'" decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="type_id"/>
                <field name="category_id"/>
                <field name="photo_year" optional="hide"/>
                <field name="like_count"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state == 'pending'"/>
                <field name="is_published"/>
            </list>
        </field>
    </record>

    <record id="local_content_item_view_form" model="ir.ui.view">
        <field name="name">website.local.content.item.view.form</field>
        <field name="model">website.local.content.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_for_approval" string="Submit for Approval" type="object" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state not in ('draft', 'pending')"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'pending'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Title"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="type_id"/>
                            <field name="category_id"/>
                            <field name="subcategory_id"/>
                            <field name="slug"/>
                            <field name="photo_year"/>
                            <field name="decade"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Location">
                            <field name="address"/>
                            <field name="city"/>
                            <field name="district"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <group>
                        <group string="Contact">
                            <field name="phone"/>
                            <field name="whatsapp"/>
                            <field name="instagram"/>
                            <field name="tiktok"/>
                            <field name="external_website"/>
                            <field name="opening_hours"/>
                        </group>
                        <group string="Submission">
                            <field name="submitter_name"/>
                            <field name="submitter_phone"/>
                            <field name="submitter_email"/>
                            <field name="submitter_identity"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="like_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="content" string="Content">
                            <group>
                                <field name="description"/>
                            </group>
                            <field name="body"/>
                        </page>
                        <page name="gallery" string="Gallery">
                            <field name="image_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image_1920" widget="image" options="{'size': [90, 90]}"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page name="likes" string="Likes">
                            <field name="like_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="session_key"/>
                                    <field name="ip_address"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="local_content_item_view_search" model="ir.ui.view">
        <field name="name">website.local.content.item.view.search</field>
        <field name="model">website.local.content.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type_id"/>
                <field name="category_id"/>
                <filter name="filter_pending" string="Pending Approval" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="filter_published" string="Published" domain="[('is_published', '=', True)]"/>
                <separator/>
                    <filter name="group_by_type" string="Content Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="local_content_item_action" model="ir.actions.act_window">
        <field name="name">Items</field>
        <field name="res_model">website.local.content.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_type': 1}</field>
    </record>

</odoo>
