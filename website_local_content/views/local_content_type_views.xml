<odoo>

    <record id="local_content_type_view_list" model="ir.ui.view">
        <field name="name">website.local.content.type.view.list</field>
        <field name="model">website.local.content.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="url_slug"/>
                <field name="use_photo_year"/>
                <field name="item_count"/>
            </list>
        </field>
    </record>

    <record id="local_content_type_view_form" model="ir.ui.view">
        <field name="name">website.local.content.type.view.form</field>
        <field name="model">website.local.content.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="url_slug"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="use_photo_year"/>
                            <field name="website_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group string="Public Page Design">
                        <group>
                            <field name="hero_subtitle"/>
                            <field name="hero_image" widget="image" class="oe_avatar"/>
                        </group>
                        <group>
                            <field name="sponsor_name"/>
                            <field name="sponsor_logo" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="local_content_type_action" model="ir.actions.act_window">
        <field name="name">Content Types</field>
        <field name="res_model">website.local.content.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
