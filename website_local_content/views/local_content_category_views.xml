<odoo>

    <record id="local_content_category_view_list" model="ir.ui.view">
        <field name="name">website.local.content.category.view.list</field>
        <field name="model">website.local.content.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="type_id"/>
                <field name="axis"/>
                <field name="subcategory_count"/>
            </list>
        </field>
    </record>

    <record id="local_content_category_view_form" model="ir.ui.view">
        <field name="name">website.local.content.category.view.form</field>
        <field name="model">website.local.content.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="type_id"/>
                        <field name="axis" widget="radio"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="subcategory_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="active" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="local_content_category_view_search" model="ir.ui.view">
        <field name="name">website.local.content.category.view.search</field>
        <field name="model">website.local.content.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type_id"/>
                <separator/>
                    <filter name="group_by_type" string="Content Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_by_axis" string="Axis" context="{'group_by': 'axis'}"/>
            </search>
        </field>
    </record>

    <record id="local_content_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">website.local.content.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_type': 1}</field>
    </record>

</odoo>
