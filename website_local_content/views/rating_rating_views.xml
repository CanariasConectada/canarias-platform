<odoo>

    <!-- Dedicated views for the local content comments, bound to our
         action only so the rating views of other apps stay untouched. -->
    <record id="rating_rating_view_list_local_content" model="ir.ui.view">
        <field name="name">rating.rating.list.local.content</field>
        <field name="model">rating.rating</field>
        <field name="arch" type="xml">
            <list decoration-warning="feedback_moderation_status == 'pending'" decoration-muted="feedback_moderation_status == 'rejected'" create="0">
                <field name="create_date"/>
                <field name="res_name" string="Item"/>
                <field name="partner_id" string="Author"/>
                <field name="rating" string="Stars"/>
                <field name="feedback" string="Comment"/>
                <field name="feedback_moderation_status" widget="badge" decoration-success="feedback_moderation_status == 'approved'" decoration-warning="feedback_moderation_status == 'pending'" decoration-danger="feedback_moderation_status == 'rejected'"/>
                <button name="action_approve_feedback" type="object" string="Approve" icon="fa-check" invisible="feedback_moderation_status == 'approved'"/>
                <button name="action_reject_feedback" type="object" string="Reject" icon="fa-times" invisible="feedback_moderation_status == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="rating_rating_view_form_local_content" model="ir.ui.view">
        <field name="name">rating.rating.form.local.content</field>
        <field name="model">rating.rating</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_approve_feedback" type="object" string="Approve" class="btn-primary" invisible="feedback_moderation_status == 'approved'"/>
                    <button name="action_reject_feedback" type="object" string="Reject" invisible="feedback_moderation_status == 'rejected'"/>
                    <field name="feedback_moderation_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="res_name" string="Item"/>
                            <field name="partner_id" string="Author" readonly="1"/>
                            <field name="rating" string="Stars" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="feedback" string="Comment" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rating_rating_view_search_local_content" model="ir.ui.view">
        <field name="name">rating.rating.search.local.content</field>
        <field name="model">rating.rating</field>
        <field name="arch" type="xml">
            <search>
                <field name="res_name" string="Item"/>
                <field name="partner_id" string="Author"/>
                <field name="feedback" string="Comment"/>
                <filter name="filter_pending" string="Pending Review" domain="[('feedback_moderation_status', '=', 'pending')]"/>
                <filter name="filter_approved" string="Published" domain="[('feedback_moderation_status', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('feedback_moderation_status', '=', 'rejected')]"/>
                <group>
                    <filter name="group_by_item" string="Item" context="{'group_by': 'res_id'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'feedback_moderation_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_local_content_comment" model="ir.actions.act_window">
        <field name="name">Local Content Comments</field>
        <field name="res_model">rating.rating</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'website.local.content.item'), ('consumed', '=', True)]</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="view_id" ref="rating_rating_view_list_local_content"/>
        <field name="search_view_id" ref="rating_rating_view_search_local_content"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No comments to review
            </p>
            <p>
                Rating comments that contain a forbidden word wait here for
                a manual check. Their stars are already published.
            </p>
        </field>
    </record>

    <record id="action_local_content_comment_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="rating_rating_view_list_local_content"/>
        <field name="act_window_id" ref="action_local_content_comment"/>
    </record>

    <record id="action_local_content_comment_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="rating_rating_view_form_local_content"/>
        <field name="act_window_id" ref="action_local_content_comment"/>
    </record>

</odoo>
