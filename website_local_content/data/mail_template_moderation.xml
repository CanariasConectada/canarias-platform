<odoo>

    <record id="mail_template_comment_moderation" model="mail.template">
        <field name="name">Local Content: Comment Pending Review</field>
        <field name="model_id" ref="rating.model_rating_rating"/>
        <field name="subject">Comment pending review on {{ object.res_name }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
                <h2 style="color: #d9534f;">Comment pending review</h2>
                <p>A new rating comment contains words that require a manual check. The stars are already published; only the comment is on hold.</p>
                <div style="background: #f5f5f5; padding: 15px; border-radius: 5px; margin: 15px 0;">
                    <p><strong>Author:</strong> <t t-out="object.partner_id.name or 'Visitor'"/></p>
                    <p><strong>Item:</strong> <t t-out="object.res_name"/></p>
                    <p><strong>Rating:</strong> <t t-out="int(object.rating)"/>/5</p>
                    <p><strong>Comment:</strong></p>
                    <p style="font-style: italic;"><t t-out="object.feedback or ''"/></p>
                </div>
                <p>
                    <a t-attf-href="{{ object.get_base_url() }}/odoo/action-website_local_content.action_local_content_comment" style="color: #875A7B;">Open the comments pending review</a>
                </p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
