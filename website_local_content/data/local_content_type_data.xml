<odoo>
    <data noupdate="1">

        <!-- The two legacy verticals, seeded as data records. -->
        <record id="content_type_living_memory" model="website.local.content.type">
            <field name="name">Living Memory</field>
            <field name="code">living_memory</field>
            <field name="url_slug">memoria-viva</field>
            <field name="sequence">10</field>
            <field name="use_photo_year" eval="True"/>
            <field name="description">Historical photographs and stories of the neighbourhood, shared by its people.</field>
        </record>

        <record id="content_type_places_of_interest" model="website.local.content.type">
            <field name="name">Places of Interest</field>
            <field name="code">places_of_interest</field>
            <field name="url_slug">lugares-de-interes</field>
            <field name="sequence">20</field>
            <field name="use_photo_year" eval="False"/>
            <field name="description">Places worth visiting in the area: culture, leisure, nature and more.</field>
        </record>

    </data>
</odoo>
