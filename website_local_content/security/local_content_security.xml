<odoo>
    <data noupdate="0">

        <!-- One category / one privilege / one group: the legacy per-module
             approver and moderator groups are fused into a single manager
             role (comments and ads moderation were dropped with their
             features). -->
        <record id="category_local_content" model="ir.module.category">
            <field name="name">Local Content</field>
            <field name="description">Management of the public local content galleries (places of interest, living memory, ...).</field>
            <field name="sequence">50</field>
        </record>

        <record id="privilege_local_content" model="res.groups.privilege">
            <field name="name">Content</field>
            <field name="category_id" ref="category_local_content"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_local_content_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_local_content"/>
            <field name="comment">Full management of content types, taxonomy and items, including approval of submitted entries.</field>
        </record>

    </data>
</odoo>
