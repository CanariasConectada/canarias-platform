<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Template: Reintento disponible (3 meses después de no aprobar) -->
        <record id="mail_template_silver_retry_available" model="mail.template">
            <field name="name">Silver Economy: Reintento disponible</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="subject">Puedes volver a realizar tu evaluación Silver Economy</field>
            <field name="email_from">{{ object.survey_id.create_uid.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hola <t t-out="object.partner_id.name"/>,
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Han pasado 3 meses desde tu última evaluación Silver Economy. Ya puedes realizar un nuevo intento para obtener tu sello de certificación.
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <a t-att-href="'/web#action=%s' % env.ref('silver_economy.action_silver_evaluations').id" style="background-color: #875A7B; padding: 10px 20px; color: #ffffff; text-decoration: none; border-radius: 5px;">
                            Ir a Mis Evaluaciones
                        </a>
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        ¡Mucho éxito!<br/>
                        El equipo de Canarias Conectada
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang or '' }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Template: Renovación próxima (1 año) -->
        <record id="mail_template_silver_renewal_due" model="mail.template">
            <field name="name">Silver Economy: Renovación próxima</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="subject">Tu sello Silver Economy vence pronto - Renovación necesaria</field>
            <field name="email_from">{{ object.survey_id.create_uid.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hola <t t-out="object.partner_id.name"/>,
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Tu sello Silver Economy <strong t-out="object.certification_level"/> vence el <strong t-out="object.expiry_date"/>.
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Para mantener tu certificación activa, debes realizar una nueva evaluación antes de esa fecha.
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <a t-att-href="'/web#action=%s' % env.ref('silver_economy.action_silver_evaluations').id" style="background-color: #875A7B; padding: 10px 20px; color: #ffffff; text-decoration: none; border-radius: 5px;">
                            Realizar renovación
                        </a>
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Saludos,<br/>
                        El equipo de Canarias Conectada
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang or '' }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Template: Nuevo sello obtenido -->
        <record id="mail_template_silver_new_badge" model="mail.template">
            <field name="name">Silver Economy: Nuevo sello obtenido</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="subject">¡Felicidades! Has obtenido el sello Silver Economy</field>
            <field name="email_from">{{ object.survey_id.create_uid.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hola <t t-out="object.partner_id.name"/>,
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        ¡Enhorabuena! Tu empresa <strong t-out="object.company_id.name"/> ha obtenido el sello:
                    </p>
                    <div style="text-align: center; padding: 20px; margin: 20px 0; background-color: #f8f9fa; border-radius: 10px;">
                        <h2 style="color: #875A7B; text-transform: uppercase;">
                            <t t-if="object.certification_level == 'bronze'">🥉 Bronce</t>
                            <t t-if="object.certification_level == 'silver'">🥈 Plata</t>
                            <t t-if="object.certification_level == 'gold'">🥇 Oro</t>
                        </h2>
                        <p>Puntuación: <strong t-out="object.scoring_total"/> / 80 puntos</p>
                        <p>Válido hasta: <strong t-out="object.expiry_date"/></p>
                    </div>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        El sello aparecerá automáticamente en tu microsite web.
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Saludos,<br/>
                        El equipo de Canarias Conectada
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang or '' }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Template: Notificación al admin de sellos expirados -->
        <record id="mail_template_silver_admin_expiry_alert" model="mail.template">
            <field name="name">Silver Economy (Admin): Alerta de sellos expirados</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="subject">Alerta: Sellos Silver Economy expirados</field>
            <field name="email_from">{{ object.survey_id.create_uid.email_formatted }}</field>
            <field name="email_to">{{ object.survey_id.create_uid.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Administrador,
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        El sello Silver Economy de la empresa <strong t-out="object.company_id.name"/> ha expirado.
                    </p>
                    <ul>
                        <li>Nivel anterior: <t t-out="object.certification_level"/></li>
                        <li>Fecha de expiración: <t t-out="object.expiry_date"/></li>
                        <li>Usuario: <t t-out="object.partner_id.name"/></li>
                    </ul>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <a t-att-href="'/web#id=%s&amp;model=survey.user_input&amp;view_type=form' % object.id">
                            Ver evaluación
                        </a>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.survey_id.create_uid.lang or '' }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
