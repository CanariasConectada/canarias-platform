#. module: silver_economy
#: model:mail.template,body_html:silver_economy.mail_template_silver_admin_expiry_alert
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Administrador,\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        El sello Silver Economy de la empresa <strong t-out=\"object.company_id.name\"/> ha expirado.\n"
"                    </p>\n"
"                    <ul>\n"
"                        <li>Nivel anterior: <t t-out=\"object.certification_level\"/></li>\n"
"                        <li>Fecha de expiración: <t t-out=\"object.expiry_date\"/></li>\n"
"                        <li>Usuario: <t t-out=\"object.partner_id.name\"/></li>\n"
"                    </ul>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <a t-att-href=\"'/web#id=%s&amp;model=survey.user_input&amp;view_type=form' % object.id\">\n"
"                            Ver evaluación\n"
"                        </a>\n"
"                    </p>\n"
"                </div>\n"
