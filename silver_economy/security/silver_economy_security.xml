<odoo>
    <data noupdate="0">
        <!-- Silver Economy privilege (groups grouping in Settings) -->
        <record model="res.groups.privilege" id="res_groups_privilege_silver_economy">
            <field name="name">Silver Economy</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="base.module_category_marketing" />
        </record>

        <!-- Group: Silver Economy user (internal users allowed to evaluate) -->
        <record id="group_silver_user" model="res.groups">
            <field name="name">Silver Economy User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_silver_economy" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <!-- Group: Silver Economy manager -->
        <record id="group_silver_manager" model="res.groups">
            <field name="name">Silver Economy Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_silver_economy" />
            <field
                name="implied_ids"
                eval="[(4, ref('group_silver_user')), (4, ref('survey.group_survey_user'))]"
            />
            <field
                name="user_ids"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>
    </data>

    <data noupdate="1">
        <!-- Record rules -->

        <!-- Regular user: only sees answers of their own companies -->
        <record id="survey_user_input_rule_silver_user" model="ir.rule">
            <field
                name="name"
            >Silver Economy: user only sees own companies' answers</field>
            <field name="model_id" ref="survey.model_survey_user_input" />
            <field name="domain_force">[
                ('survey_id.is_silver_economy', '=', True),
                ('company_id', 'in', user.company_ids.ids),
                ('test_entry', '=', False),
            ]</field>
            <field name="groups" eval="[(4, ref('group_silver_user'))]" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="0" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="0" />
        </record>

        <!-- Manager: sees every Silver answer -->
        <record id="survey_user_input_rule_silver_manager" model="ir.rule">
            <field name="name">Silver Economy: manager sees all Silver answers</field>
            <field name="model_id" ref="survey.model_survey_user_input" />
            <field
                name="domain_force"
            >[('survey_id.is_silver_economy', '=', True), ('test_entry', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_silver_manager'))]" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>

        <!-- survey.survey: users only see active Silver surveys -->
        <record id="survey_survey_rule_silver_user" model="ir.rule">
            <field name="name">Silver Economy: user sees active Silver surveys</field>
            <field name="model_id" ref="survey.model_survey_survey" />
            <field
                name="domain_force"
            >[('is_silver_economy', '=', True), ('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_silver_user'))]" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="0" />
            <field name="perm_create" eval="0" />
            <field name="perm_unlink" eval="0" />
        </record>
    </data>
</odoo>
