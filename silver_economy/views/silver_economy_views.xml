<odoo>
    <!-- Server action: start a new Silver Economy evaluation -->
    <record id="action_start_silver_evaluation_server" model="ir.actions.server">
        <field name="name">New Silver Economy evaluation</field>
        <field name="model_id" ref="survey.model_survey_user_input" />
        <field name="state">code</field>
        <field name="code">
action = model.action_start_new_silver_evaluation()
        </field>
        <field name="binding_model_id" ref="survey.model_survey_user_input" />
        <field name="binding_type">action</field>
    </record>

    <!-- Window action: Silver Economy evaluations -->
    <record id="action_silver_evaluations" model="ir.actions.act_window">
        <field name="name">Silver Economy Evaluations</field>
        <field name="res_model">survey.user_input</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('survey_id.is_silver_economy', '=', True), ('test_entry', '=', False)]</field>
        <field
            name="context"
        >{'is_silver_economy': True, 'search_default_group_by_survey': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Welcome to Silver Economy
            </p>
            <p>
                You have not taken any evaluation for your company yet.
                Click <b>New</b> to start your first evaluation and find out
                whether your business qualifies for the Silver Economy badge.
            </p>
        </field>
    </record>

    <!-- Window action: Silver Economy questionnaires -->
    <record id="action_silver_surveys" model="ir.actions.act_window">
        <field name="name">Silver Economy Questionnaires</field>
        <field name="res_model">survey.survey</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_silver_economy', '=', True)]</field>
        <field name="context">{'default_is_silver_economy': True}</field>
    </record>

    <!-- Main menu -->
    <menuitem
        id="menu_silver_economy_root"
        name="Silver Economy"
        web_icon="silver_economy,static/description/icon.png"
        groups="silver_economy.group_silver_user"
        sequence="50"
    />

    <menuitem
        id="menu_silver_evaluations"
        name="My Evaluations"
        parent="menu_silver_economy_root"
        action="action_silver_evaluations"
        sequence="10"
    />

    <menuitem
        id="menu_silver_surveys"
        name="Questionnaires"
        parent="menu_silver_economy_root"
        action="action_silver_surveys"
        groups="base.group_system"
        sequence="20"
    />

    <!-- Action: Trainings (public page /silver-economy) -->
    <record id="action_silver_formaciones" model="ir.actions.act_url">
        <field name="name">Trainings</field>
        <field name="type">ir.actions.act_url</field>
        <field name="target">self</field>
        <field name="url">/silver-economy</field>
    </record>

    <menuitem
        id="menu_silver_formaciones"
        name="Trainings"
        parent="menu_silver_economy_root"
        action="action_silver_formaciones"
        sequence="30"
    />

    <!-- Action: Instructions (public page /silver-economy/instructions) -->
    <record id="action_silver_instructions" model="ir.actions.act_url">
        <field name="name">Instructions</field>
        <field name="type">ir.actions.act_url</field>
        <field name="target">self</field>
        <field name="url">/silver-economy/instructions</field>
    </record>

    <menuitem
        id="menu_silver_instructions"
        name="Instructions"
        parent="menu_silver_economy_root"
        action="action_silver_instructions"
        sequence="40"
    />

    <!-- Error / cooldown flow templates (end-user content, kept in Spanish) -->
    <template id="silver_no_company" name="Silver Economy - Sin empresa">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="alert alert-warning">
                    <h4>No tiene empresa asignada</h4>
                    <p>Debe tener una empresa asignada en su perfil de usuario para realizar la evaluación Silver Economy.</p>
                    <a
                        href="javascript:window.close()"
                        class="btn btn-primary"
                    >Volver a Mis Evaluaciones</a>
                </div>
            </div>
        </t>
    </template>

    <template id="silver_cooldown" name="Silver Economy - Cooldown">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="alert alert-info">
                    <h4>Evaluación no disponible</h4>
                    <p>Ya ha realizado una evaluación recientemente.</p>
                    <p>Podrá realizar una nueva evaluación a partir del: <strong
                            t-esc="next_date"
                        /></p>
                    <a
                        href="javascript:window.close()"
                        class="btn btn-primary"
                    >Volver a Mis Evaluaciones</a>
                </div>
            </div>
        </t>
    </template>

    <template id="silver_error" name="Silver Economy - Error">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="alert alert-danger">
                    <h4>Error al iniciar evaluación</h4>
                    <p t-esc="error" />
                    <a
                        href="javascript:window.close()"
                        class="btn btn-primary"
                    >Volver a Mis Evaluaciones</a>
                </div>
            </div>
        </t>
    </template>

    <!--
        Hide the native 'Retake' button on certification surveys.
        Both certification modules (silver_economy / sustainability) rewrite
        the SAME attribute with the SAME generic condition based on
        is_certification_survey, so the last applied inheritance still yields
        the correct behaviour for both survey types.
    -->
    <template
        id="survey_button_retake_inherit_silver"
        inherit_id="survey.survey_button_retake"
    >
        <xpath expr="//div[@class='d-print-none']" position="attributes">
            <attribute
                name="t-if"
            >not survey.is_certification_survey and not answer.is_session_answer and not (survey.certification and answer.scoring_success)</attribute>
        </xpath>
    </template>

    <!-- Completion page: show the awarded Silver badge -->
    <template
        id="survey_fill_form_done_inherit_silver"
        inherit_id="survey.survey_fill_form_done"
    >
        <xpath expr="//div[@class='o_survey_finished mt32 mb32']" position="inside">
            <t t-if="survey.is_silver_economy and answer.certification_level != 'none'">
                <div class="alert alert-success mt-3 text-center">
                    <h3
                        class="mb-3"
                    >🎉 ¡Felicidades! Tu empresa ha obtenido el sello Silver Economy</h3>
                    <div class="d-flex justify-content-center align-items-center gap-3">
                        <div
                            t-if="answer.certification_level == 'bronze'"
                            class="badge bg-warning text-dark p-3 fs-4"
                        >🥉 BRONCE</div>
                        <div
                            t-if="answer.certification_level == 'silver'"
                            class="badge bg-secondary p-3 fs-4"
                        >🥈 PLATA</div>
                        <div
                            t-if="answer.certification_level == 'gold'"
                            class="badge bg-warning p-3 fs-4"
                        >🥇 ORO</div>
                    </div>
                    <p class="mt-3">
                        Puntuación: <strong t-esc="answer.scoring_total" /> / <t
                            t-esc="survey.silver_max_score or 80"
                        /> puntos
                        (<t t-esc="answer.scoring_percentage" />%)
                    </p>
                    <p class="text-muted">
                        El sello es válido hasta: <strong t-esc="answer.expiry_date" />
                    </p>
                </div>
            </t>
            <t t-if="survey.is_silver_economy and answer.certification_level == 'none'">
                <div class="alert alert-info mt-3 text-center">
                    <h4>Resultado de la evaluación</h4>
                    <p>
                        Puntuación: <strong t-esc="answer.scoring_total" /> / <t
                            t-esc="survey.silver_max_score or 80"
                        /> puntos
                        (<t t-esc="answer.scoring_percentage" />%)
                    </p>
                    <p>En esta ocasión no has alcanzado el nivel mínimo para obtener el sello Silver Economy.</p>
                    <p class="text-muted">Podrás volver a intentarlo a partir del: <strong
                            t-esc="answer.next_attempt_date"
                        /></p>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Timing / threshold fields on the survey form -->
    <record id="survey_survey_view_form_silver_timing" model="ir.ui.view">
        <field name="name">survey.survey.form.silver.timing</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    string="Silver Economy"
                    name="silver_economy"
                    invisible="not is_silver_economy"
                    groups="base.group_system"
                >
                    <group>
                        <group string="Configuration">
                            <field name="is_silver_economy" />
                        </group>
                        <group string="Score thresholds">
                            <field name="silver_max_score" />
                            <field name="silver_bronze_min" />
                            <field name="silver_silver_min" />
                            <field name="silver_gold_min" />
                        </group>
                        <group string="Timing">
                            <field name="silver_cooldown_months" />
                            <field name="silver_validity_years" />
                            <field name="silver_renewal_reminder_days" />
                        </group>
                    </group>
                    <separator string="Microsite positive items" />
                    <field
                        name="positive_item_ids"
                        nolabel="1"
                        context="{'default_survey_id': id}"
                    />
                </page>
            </xpath>
        </field>
    </record>

    <!-- Editable list for silver.positive.item -->
    <record id="view_silver_positive_item_tree" model="ir.ui.view">
        <field name="name">silver.positive.item.list</field>
        <field name="model">silver.positive.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="survey_id" column_invisible="True" />
                <field
                    name="question_id"
                    options="{'no_create': True}"
                    domain="[('survey_id', '=', survey_id), ('is_page', '=', False)]"
                />
                <field name="min_score" />
                <field name="label" />
                <field name="icon" />
            </list>
        </field>
    </record>

    <!--
        Show the question recommendation as fixed text on certification
        surveys instead of the native comment textarea. Both certification
        modules replace the SAME node with the SAME generic markup based on
        is_certification_survey, so the last applied inheritance wins without
        breaking the sibling module.
    -->
    <template
        id="question_simple_choice_silver_print"
        inherit_id="survey.question_simple_choice"
    >
        <xpath
            expr="//div[@t-if='question.comments_allowed and not question.comment_count_as_answer']"
            position="replace"
        >
            <div
                t-if="question.comments_allowed and not question.comment_count_as_answer"
                class="mb-2 o_survey_comment_container mt-3"
            >
                <!-- Certification surveys: recommendation as visible text -->
                <t t-if="survey.is_certification_survey and not answer.test_entry">
                    <div class="alert alert-light border mt-2 p-2">
                        <i class="fa fa-lightbulb-o text-warning me-2" />
                        <strong>Recomendación:</strong>
                        <span t-out="question.comments_message" />
                    </div>
                </t>
                <!-- Native behaviour for backend preview and other surveys -->
                <t t-else="">
                    <textarea
                        type="text"
                        class="col form-control o_survey_comment o_survey_question_text_box bg-transparent rounded-0 p-0"
                        t-att-placeholder="question.comments_message or default_comments_message if not survey_form_readonly else ''"
                    ><t t-esc="comment_line.value_char_box if comment_line else ''" /></textarea>
                </t>
            </div>
        </xpath>
    </template>

    <template
        id="question_multiple_choice_silver_print"
        inherit_id="survey.question_multiple_choice"
    >
        <xpath
            expr="//div[@t-if='question.comments_allowed and not question.comment_count_as_answer']"
            position="replace"
        >
            <div
                t-if="question.comments_allowed and not question.comment_count_as_answer"
                class="mb-2 o_survey_comment_container mt-3"
            >
                <!-- Certification surveys: recommendation as visible text -->
                <t t-if="survey.is_certification_survey and not answer.test_entry">
                    <div class="alert alert-light border mt-2 p-2">
                        <i class="fa fa-lightbulb-o text-warning me-2" />
                        <strong>Recomendación:</strong>
                        <span t-out="question.comments_message" />
                    </div>
                </t>
                <!-- Native behaviour for backend preview and other surveys -->
                <t t-else="">
                    <textarea
                        type="text"
                        class="col form-control o_survey_comment o_survey_question_text_box bg-transparent rounded-0 p-0"
                        t-att-placeholder="question.comments_message or default_comments_message if not survey_form_readonly else ''"
                    ><t t-esc="comment_line.value_char_box if comment_line else ''" /></textarea>
                </t>
            </div>
        </xpath>
    </template>

    <!-- Completion page: recommendations summary -->
    <template
        id="survey_fill_form_done_silver_recommendations"
        inherit_id="survey.survey_fill_form_done"
    >
        <xpath expr="//div[@class='o_survey_finished mt32 mb32']" position="inside">
            <t t-if="survey.is_silver_economy and answer">
                <t
                    t-set="weak_lines"
                    t-value="answer.user_input_line_ids.filtered(lambda l: l.question_id.comments_allowed and l.answer_score &lt; 2 and l.question_id.comments_message)"
                />
                <t t-if="weak_lines">
                    <div class="alert alert-info mt-4">
                        <h4 class="alert-heading">
                            <i class="fa fa-lightbulb-o text-warning me-2" />
                            Recomendaciones para mejorar
                        </h4>
                        <p
                            class="mb-3"
                        >Basado en tus respuestas, estas son las áreas donde puedes enfocarte:</p>
                        <div class="row">
                            <t t-foreach="weak_lines" t-as="line">
                                <div class="col-12 col-md-6 mb-3">
                                    <div
                                        class="card h-100 border-start border-warning border-3"
                                    >
                                        <div class="card-body">
                                            <h6 class="card-title text-muted mb-2">
                                                <t t-esc="line.question_id.title" />
                                            </h6>
                                            <p class="card-text small mb-1">
                                                <strong>Tu respuesta:</strong>
                                                <t
                                                    t-if="line.answer_score == 0"
                                                >No</t>
                                                <t
                                                    t-if="line.answer_score == 1"
                                                >Parcialmente</t>
                                            </p>
                                            <p
                                                class="card-text small text-secondary fst-italic"
                                            >
                                                <i
                                                    class="fa fa-arrow-right text-warning me-1"
                                                />
                                                <t
                                                    t-esc="line.question_id.comments_message"
                                                />
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
    </template>

    <!-- Completion page: Close button (own surveys only) -->
    <template
        id="survey_fill_form_done_silver_close"
        inherit_id="survey.survey_fill_form_done"
    >
        <xpath
            expr="//div[contains(@class, 'o_survey_finished')]//div[contains(@class, 'd-flex') and contains(@class, 'gap-3')]"
            position="inside"
        >
            <t t-if="survey.is_silver_economy">
                <a
                    role="button"
                    class="btn btn-outline-secondary btn-lg"
                    href="javascript:window.close()"
                >
                    <i class="fa fa-times" /> Cerrar
                </a>
            </t>
        </xpath>
    </template>
</odoo>
