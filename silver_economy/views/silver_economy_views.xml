<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action Server: Iniciar nueva evaluación Silver Economy -->
    <record id="action_start_silver_evaluation_server" model="ir.actions.server">
        <field name="name">Nueva evaluación Silver Economy</field>
        <field name="model_id" ref="survey.model_survey_user_input"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_start_new_silver_evaluation()
        </field>
        <field name="binding_model_id" ref="survey.model_survey_user_input"/>
        <field name="binding_type">action</field>
    </record>

    <!-- Acción para abrir evaluaciones Silver Economy -->
    <record id="action_silver_evaluations" model="ir.actions.act_window">
        <field name="name">Evaluaciones Silver Economy</field>
        <field name="res_model">survey.user_input</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('survey_id.is_silver_economy', '=', True), ('test_entry', '=', False)]</field>
        <field name="context">{'is_silver_economy': True, 'certification_display': True, 'search_default_group_by_survey': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bienvenido a Silver Economy
            </p>
            <p>
                Aún no has realizado ninguna evaluación para tu empresa.
                Haz clic en <b>Nuevo</b> para iniciar tu primera evaluación
                y descubrir si tu comercio califica para el sello Silver Economy.
            </p>
        </field>
    </record>

    <!-- Acción para abrir encuestas Silver Economy -->
    <record id="action_silver_surveys" model="ir.actions.act_window">
        <field name="name">Cuestionarios Silver Economy</field>
        <field name="res_model">survey.survey</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_silver_economy', '=', True)]</field>
        <field name="context">{'default_is_silver_economy': True}</field>
    </record>

    <!-- Menú principal. Cuelga de Certificaciones: los dos sellos comparten
         contenedor en vez de ocupar cada uno un icono propio en el menú de
         aplicaciones, que es donde el administrador los veía duplicados. -->
    <menuitem id="menu_silver_economy_root"
              name="Silver Economy"
              parent="company_certification.menu_certification_root"
              groups="silver_economy.group_silver_user"
              sequence="40"/>

    <!-- El contenedor pertenece a company_certification, que se carga antes
         que este módulo y por eso no puede nombrar este grupo. La concesión
         viaja en el sentido de la dependencia: quien tiene el sello abre la
         puerta al menú que lo contiene. -->
    <record id="company_certification.menu_certification_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('silver_economy.group_silver_user'))]"/>
    </record>

    <menuitem id="menu_silver_evaluations"
              name="Mis Evaluaciones"
              parent="menu_silver_economy_root"
              action="action_silver_evaluations"
              sequence="10"/>

    <menuitem id="menu_silver_surveys"
              name="Cuestionarios"
              parent="menu_silver_economy_root"
              action="action_silver_surveys"
              groups="base.group_system"
              sequence="20"/>

    <!-- Action: Formaciones (página pública /silver-economy) -->
    <record id="action_silver_formaciones" model="ir.actions.act_url">
        <field name="name">Formaciones</field>
        <field name="type">ir.actions.act_url</field>
        <field name="target">self</field>
        <field name="url">/silver-economy</field>
    </record>

    <menuitem id="menu_silver_formaciones"
              name="Formaciones"
              parent="menu_silver_economy_root"
              action="action_silver_formaciones"
              sequence="30"/>

    <!-- Action: Instrucciones (página pública /silver-economy/instructions) -->
    <record id="action_silver_instructions" model="ir.actions.act_url">
        <field name="name">Instrucciones</field>
        <field name="type">ir.actions.act_url</field>
        <field name="target">self</field>
        <field name="url">/silver-economy/instructions</field>
    </record>

    <menuitem id="menu_silver_instructions"
              name="Instrucciones"
              parent="menu_silver_economy_root"
              action="action_silver_instructions"
              sequence="40"/>

    <!-- Plantillas de mensajes de error/cooldown -->
    <template id="silver_no_company" name="Silver Economy - Sin empresa">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="alert alert-warning">
                    <h4>No tiene empresa asignada</h4>
                    <p>Debe tener una empresa asignada en su perfil de usuario para realizar la evaluación Silver Economy.</p>
                    <a href="javascript:window.close()" class="btn btn-primary">Volver a Mis Evaluaciones</a>
                </div>
            </div>
        </t>
    </template>

    <template id="silver_cooldown" name="Silver Economy - Cooldown">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="alert alert-info">
                    <h4>Evaluación no disponible</h4>
                    <p>Ya ha realizado una evaluación recientemente.</p>
                    <p>Podrá realizar una nueva evaluación a partir del: <strong t-esc="next_date"/></p>
                    <a href="javascript:window.close()" class="btn btn-primary">Volver a Mis Evaluaciones</a>
                </div>
            </div>
        </t>
    </template>

    <template id="silver_error" name="Silver Economy - Error">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="alert alert-danger">
                    <h4>Error al iniciar evaluación</h4>
                    <p t-esc="error"/>
                    <a href="javascript:window.close()" class="btn btn-primary">Volver a Mis Evaluaciones</a>
                </div>
            </div>
        </t>
    </template>

    <!-- Ocultar botón 'Volver a hacer / Retry' en encuestas Silver Economy -->
    <template id="survey_button_retake_inherit_silver" inherit_id="survey.survey_button_retake">
        <xpath expr="//div[@class='d-print-none']" position="attributes">
            <attribute name="t-if">not survey.is_silver_economy and not answer.is_session_answer and not (survey.certification and answer.scoring_success)</attribute>
        </xpath>
    </template>

    <!-- El sello Silver ahora lo renderiza company_certification (base), una
         sola vez y en español, keyed por certification_type_id. Este módulo ya
         no duplica el panel: mantenerlo aquí doblaba el sello y los botones. -->

    <!-- ============================================ -->
    <!-- F: Recomendaciones visibles en impresión web -->
    <!-- ============================================ -->

    <!-- ============================================ -->
    <!-- F: Campos de timing en formulario de survey -->
    <!-- ============================================ -->

    <record id="survey_survey_view_form_silver_timing" model="ir.ui.view">
        <field name="name">survey.survey.form.silver.timing</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Silver Economy" name="silver_economy" invisible="not is_silver_economy" groups="base.group_system">
                    <group>
                        <group string="Configuración">
                            <field name="is_silver_economy"/>
                        </group>
                        <group string="Umbrales de puntuación">
                            <field name="silver_max_score"/>
                            <field name="silver_bronze_min"/>
                            <field name="silver_silver_min"/>
                            <field name="silver_gold_min"/>
                        </group>
                        <group string="Tiempos">
                            <field name="silver_cooldown_months"/>
                            <field name="silver_validity_years"/>
                            <field name="silver_renewal_reminder_days"/>
                        </group>
                    </group>
                    <separator string="Items positivos del microsite"/>
                    <field name="silver_positive_item_ids" nolabel="1" context="{'default_survey_id': id}"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Vista list para silver.positive.item (editable) -->
    <record id="view_silver_positive_item_tree" model="ir.ui.view">
        <field name="name">silver.positive.item.list</field>
        <field name="model">silver.positive.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="survey_id" invisible="1"/>
                <field name="question_id" options="{'no_create': True}" domain="[('survey_id', '=', survey_id), ('is_page', '=', False)]"/>
                <field name="min_score"/>
                <field name="label"/>
                <field name="icon"/>
            </list>
        </field>
    </record>

    <!-- Herencia para simple_choice: mostrar recomendación como texto fijo en modo print/readonly -->
    <template id="question_simple_choice_silver_print" inherit_id="survey.question_simple_choice">
        <xpath expr="//div[@t-if='question.comments_allowed and not question.comment_count_as_answer']" position="replace">
            <div t-if="question.comments_allowed and not question.comment_count_as_answer"
                 class="mb-2 o_survey_comment_container mt-3">
                <!-- Frontend público Silver Economy: recomendación como texto visible -->
                <!-- En backend preview (test_entry=True) se conserva el textarea nativo -->
                <t t-if="survey.is_silver_economy and not answer.test_entry">
                    <div class="alert alert-light border mt-2 p-2">
                        <i class="fa fa-lightbulb-o text-warning me-2"/>
                        <strong>Recomendación:</strong>
                        <span t-out="question.comments_message"/>
                    </div>
                </t>
                <!-- Comportamiento nativo para backend preview u otras encuestas -->
                <t t-else="">
                    <textarea type="text" class="col form-control o_survey_comment o_survey_question_text_box bg-transparent rounded-0 p-0"
                        t-att-placeholder="question.comments_message or default_comments_message if not survey_form_readonly else ''"><t t-esc="comment_line.value_char_box if comment_line else ''"/></textarea>
                </t>
            </div>
        </xpath>
    </template>

    <!-- Herencia para multiple_choice: mismo tratamiento -->
    <template id="question_multiple_choice_silver_print" inherit_id="survey.question_multiple_choice">
        <xpath expr="//div[@t-if='question.comments_allowed and not question.comment_count_as_answer']" position="replace">
            <div t-if="question.comments_allowed and not question.comment_count_as_answer"
                 class="mb-2 o_survey_comment_container mt-3">
                <!-- Frontend público Silver Economy: recomendación como texto visible -->
                <!-- En backend preview (test_entry=True) se conserva el textarea nativo -->
                <t t-if="survey.is_silver_economy and not answer.test_entry">
                    <div class="alert alert-light border mt-2 p-2">
                        <i class="fa fa-lightbulb-o text-warning me-2"/>
                        <strong>Recomendación:</strong>
                        <span t-out="question.comments_message"/>
                    </div>
                </t>
                <!-- Comportamiento nativo para backend preview u otras encuestas -->
                <t t-else="">
                    <textarea type="text" class="col form-control o_survey_comment o_survey_question_text_box bg-transparent rounded-0 p-0"
                        t-att-placeholder="question.comments_message or default_comments_message if not survey_form_readonly else ''"><t t-esc="comment_line.value_char_box if comment_line else ''"/></textarea>
                </t>
            </div>
        </xpath>
    </template>

    <!-- ============================================ -->
    <!-- F: Resumen de recomendaciones en pantalla de finalización -->
    <!-- ============================================ -->

    <template id="survey_fill_form_done_silver_recommendations" inherit_id="survey.survey_fill_form_done">
        <xpath expr="//div[@class='o_survey_finished mt32 mb32']" position="inside">
            <t t-if="survey.is_silver_economy and answer">
                <t t-set="weak_lines" t-value="answer.user_input_line_ids.filtered(lambda l: l.question_id.comments_allowed and l.answer_score &lt; 2 and l.question_id.comments_message)"/>
                <t t-if="weak_lines">
                    <div class="alert alert-info mt-4">
                        <h4 class="alert-heading">
                            <i class="fa fa-lightbulb-o text-warning me-2"/>
                            Recomendaciones para mejorar
                        </h4>
                        <p class="mb-3">Basado en tus respuestas, estas son las áreas donde puedes enfocarte:</p>
                        <div class="row">
                            <t t-foreach="weak_lines" t-as="line">
                                <div class="col-12 col-md-6 mb-3">
                                    <div class="card h-100 border-start border-warning border-3">
                                        <div class="card-body">
                                            <h6 class="card-title text-muted mb-2">
                                                <t t-esc="line.question_id.title"/>
                                            </h6>
                                            <p class="card-text small mb-1">
                                                <strong>Tu respuesta:</strong>
                                                <t t-if="line.answer_score == 0">No</t>
                                                <t t-if="line.answer_score == 1">Parcialmente</t>
                                            </p>
                                            <p class="card-text small text-secondary fst-italic">
                                                <i class="fa fa-arrow-right text-warning me-1"/>
                                                <t t-esc="line.question_id.comments_message"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
    </template>

    <!-- El botón «Cerrar» lo pone company_certification (base), una sola vez. -->
</odoo>
