<odoo>
    <!-- survey.user_input list: certification columns (Silver context only) -->
    <record id="view_survey_user_input_tree_inherit_silver" model="ir.ui.view">
        <field name="name">survey.user_input.list.inherit.silver</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">1</attribute>
                <attribute name="decoration-muted">test_entry == True</attribute>
                <attribute
                    name="decoration-info"
                >certification_level == 'bronze'</attribute>
                <attribute
                    name="decoration-primary"
                >certification_level == 'silver'</attribute>
                <attribute
                    name="decoration-warning"
                >certification_level == 'gold'</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <button
                    name="action_continue_silver_evaluation"
                    type="object"
                    icon="fa-play"
                    title="Continue evaluation"
                    column_invisible="not context.get('is_silver_economy')"
                    invisible="state != 'in_progress'"
                />
            </xpath>
            <xpath expr="//field[@name='survey_id']" position="after">
                <field
                    name="company_id"
                    optional="show"
                    column_invisible="not context.get('is_silver_economy')"
                />
                <field
                    name="certification_level"
                    optional="show"
                    widget="badge"
                    decoration-muted="certification_level == 'none'"
                    decoration-info="certification_level == 'bronze'"
                    decoration-primary="certification_level == 'silver'"
                    decoration-warning="certification_level == 'gold'"
                    column_invisible="not context.get('is_silver_economy')"
                />
                <field
                    name="next_attempt_date"
                    optional="show"
                    column_invisible="not context.get('is_silver_economy')"
                />
                <field
                    name="expiry_date"
                    optional="show"
                    column_invisible="not context.get('is_silver_economy')"
                />
                <field
                    name="is_manually_overridden"
                    optional="hide"
                    column_invisible="not context.get('is_silver_economy')"
                />
            </xpath>
        </field>
    </record>

    <!-- survey.user_input form: manual override audit page -->
    <record id="view_survey_user_input_form_inherit_silver" model="ir.ui.view">
        <field name="name">survey.user_input.form.inherit.silver</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Audit" name="audit" invisible="not is_manually_overridden">
                    <group>
                        <field name="is_manually_overridden" />
                        <field name="original_scoring_total" />
                        <field name="override_scoring_total" />
                        <field name="override_user_id" />
                        <field name="override_date" />
                        <field name="override_reason" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!--
        Intercept the native 'New' button in My Evaluations: instead of the
        raw survey.user_input form, show a clean panel with a single button
        that validates the cooldown and opens the questionnaire.
        The sheet visibility condition names BOTH certification context keys
        (plain dict lookups, safe even when the sibling module is not
        installed) so the last applied inheritance is identical in both
        modules.
    -->
    <record id="view_survey_user_input_form_silver_start" model="ir.ui.view">
        <field name="name">survey.user_input.form.silver.start</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form" />
        <field name="mode">extension</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div
                    class="alert alert-info text-center p-5 mb-0"
                    invisible="not context.get('is_silver_economy') or id"
                >
                    <h3 class="mb-3">📝 Nueva evaluación Silver Economy</h3>
                    <p class="lead">
                        Inicie una nueva evaluación para su empresa.
                    </p>
                    <p class="text-muted">
                        Al hacer clic en el botón se validarán los plazos de espera
                        y se iniciará el cuestionario en una nueva pestaña.
                    </p>
                    <button
                        name="action_start_silver_from_form"
                        type="object"
                        string="Iniciar evaluación"
                        class="btn btn-primary btn-lg mt-3"
                    />
                </div>
            </xpath>
            <xpath expr="//sheet" position="attributes">
                <attribute
                    name="invisible"
                >(context.get('is_silver_economy') or context.get('is_sustainability')) and not id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
