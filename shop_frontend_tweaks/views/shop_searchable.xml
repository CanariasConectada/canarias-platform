<?xml version="1.0" encoding="UTF-8"?>
<!--
SHOP SEARCHABLE CATEGORIES
- Replaces the categories <ul> list with a searchable <select>
- Vanilla JavaScript, no external dependencies
- #714B67 for the active selection
-->
<odoo>

    <!-- SEARCHABLE CATEGORY SELECT (Sidebar) -->
    <template id="shop_searchable_categories" inherit_id="website_sale.products_categories_list"
              name="Shop Searchable Categories" priority="97">
        <xpath expr="//ul[hasclass('nav', 'd-flex', 'flex-column', 'mb-3')]" position="replace">
            <form action="/shop" method="get" class="mb-3">
                <label class="form-label small text-muted mb-2">
                    <i class="fa fa-filter me-1"/> Filtrar por categoría
                </label>
                <select name="category" class="form-select microsite-cat-select" id="micrositeCategorySelect">
                    <option value="" t-att-selected="not category">
                        <t t-if="search">Todas las categorías</t>
                        <t t-else="">Todas las categorías</t>
                    </option>
                    <t t-foreach="categories" t-as="c">
                        <option t-att-value="c.id" t-att-selected="category and category.id == c.id">
                            <t t-out="c.name"/>
                        </option>
                    </t>
                </select>
            </form>
        </xpath>
    </template>

    <!-- The dropdown's styles and script live in
         static/src/css/searchable_categories.css and
         static/src/js/searchable_categories.js (web.assets_frontend):
         injected at the template root they rendered after the closing
         html tag and the script was re-parsed on every page load. -->

</odoo>
