<?xml version="1.0" encoding="UTF-8"?>
<!--
SHOP TOOLBAR
- Product counter
- Grid/List toggle
- 12/24/48 products-per-page selector
- View mode persisted in localStorage
-->
<odoo>

    <!-- The toolbar script and styles live in static/src/js/shop_toolbar.js,
         static/src/css/shop_toolbar.css and static/src/css/shop_layout.css
         (web.assets_frontend): injected at the template root they rendered
         after the closing html tag and the script was re-parsed on every
         page load. -->

    <!-- TOOLBAR HTML -->
    <template id="shop_toolbar" inherit_id="website_sale.products"
              name="Shop Toolbar" priority="94">
        <xpath expr="//div[hasclass('o_wsale_products_main_row')]" position="before">
            <div id="shop-directory-toolbar" class="mb-3">
                <div class="d-flex align-items-center justify-content-between bg-light rounded p-3">
                    <!-- Product counter -->
                    <div class="products-count">
                        <strong t-out="search_count or len(products) or 0"/>
                        <span class="text-muted ms-1">productos</span>
                    </div>
                    <!-- Controls -->
                    <div class="d-flex align-items-center gap-3">
                        <!-- Grid/List toggle -->
                        <div class="btn-group view-mode-toggle" role="group">
                            <button type="button" class="btn btn-outline-secondary btn-sm active"
                                    data-view="grid" onclick="setViewMode('grid')" title="Vista de cuadrícula">
                                <i class="fa fa-th"/>
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    data-view="list" onclick="setViewMode('list')" title="Vista de lista">
                                <i class="fa fa-list"/>
                            </button>
                        </div>
                        <!-- PPG selector -->
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small">Mostrar:</span>
                            <div class="btn-group" role="group">
                                <t t-set="current_ppg" t-value="(request.httprequest.args.get('ppg') or '').isdecimal() and int(request.httprequest.args.get('ppg')) or 12"/>
                                <a t-att-href="keep(ppg=12, page=1)"
                                   t-attf-class="btn btn-sm {{current_ppg == 12 and 'btn-primary' or 'btn-outline-secondary'}}"
                                   t-attf-style="{{current_ppg == 12 and 'background-color:#714B67;border-color:#714B67;' or ''}}">12</a>
                                <a t-att-href="keep(ppg=24, page=1)"
                                   t-attf-class="btn btn-sm {{current_ppg == 24 and 'btn-primary' or 'btn-outline-secondary'}}"
                                   t-attf-style="{{current_ppg == 24 and 'background-color:#714B67;border-color:#714B67;' or ''}}">24</a>
                                <a t-att-href="keep(ppg=48, page=1)"
                                   t-attf-class="btn btn-sm {{current_ppg == 48 and 'btn-primary' or 'btn-outline-secondary'}}"
                                   t-attf-style="{{current_ppg == 48 and 'background-color:#714B67;border-color:#714B67;' or ''}}">48</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
