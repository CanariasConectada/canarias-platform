<odoo>
    <!-- res.company form: badge fields and evaluations stat button -->
    <record id="view_company_form_inherit_sustainability" model="ir.ui.view">
        <field name="name">res.company.form.inherit.sustainability</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_sustainability_evaluations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-leaf"
                >
                    <field
                        name="sustain_evaluation_count"
                        widget="statinfo"
                        string="Sustainability Evaluations"
                    />
                </button>
            </xpath>
            <xpath expr="//group[@name='social_media']" position="after">
                <group string="Sustainability" name="sustainability">
                    <field name="sustain_certification_level" readonly="1" />
                    <field name="sustain_certification_date" readonly="1" />
                    <field name="sustain_expiry_date" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>

    <!-- res.company list: badge column -->
    <record id="view_company_tree_inherit_sustainability" model="ir.ui.view">
        <field name="name">res.company.list.inherit.sustainability</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="sustain_certification_level" optional="show" />
                <field name="sustain_expiry_date" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
