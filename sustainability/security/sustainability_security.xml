<odoo>
    <data noupdate="0">
        <!-- Sustainability privilege (groups grouping in Settings) -->
        <record model="res.groups.privilege" id="res_groups_privilege_sustainability">
            <field name="name">Sustainability</field>
            <field name="sequence">26</field>
            <field name="category_id" ref="base.module_category_marketing" />
        </record>

        <!-- Group: Sustainability user (internal users allowed to evaluate) -->
        <record id="group_sustainability_user" model="res.groups">
            <field name="name">Sustainability User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_sustainability" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <!-- Group: Sustainability manager -->
        <record id="group_sustainability_manager" model="res.groups">
            <field name="name">Sustainability Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_sustainability" />
            <field
                name="implied_ids"
                eval="[(4, ref('group_sustainability_user')), (4, ref('survey.group_survey_user'))]"
            />
            <field
                name="user_ids"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>
    </data>

    <data noupdate="1">
        <!-- Record rules -->

        <!-- Regular user: only sees answers of their own companies -->
        <record id="survey_user_input_rule_sust_user" model="ir.rule">
            <field
                name="name"
            >Sustainability: user only sees own companies' answers</field>
            <field name="model_id" ref="survey.model_survey_user_input" />
            <field name="domain_force">[
                ('survey_id.is_sustainability', '=', True),
                ('company_id', 'in', user.company_ids.ids),
                ('test_entry', '=', False),
            ]</field>
            <field name="groups" eval="[(4, ref('group_sustainability_user'))]" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="0" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="0" />
        </record>

        <!-- Manager: sees every Sustainability answer -->
        <record id="survey_user_input_rule_sust_manager" model="ir.rule">
            <field
                name="name"
            >Sustainability: manager sees all Sustainability answers</field>
            <field name="model_id" ref="survey.model_survey_user_input" />
            <field
                name="domain_force"
            >[('survey_id.is_sustainability', '=', True), ('test_entry', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_sustainability_manager'))]" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>

        <!-- survey.survey: users only see active Sustainability surveys -->
        <record id="survey_survey_rule_sust_user" model="ir.rule">
            <field
                name="name"
            >Sustainability: user sees active Sustainability surveys</field>
            <field name="model_id" ref="survey.model_survey_survey" />
            <field
                name="domain_force"
            >[('is_sustainability', '=', True), ('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_sustainability_user'))]" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="0" />
            <field name="perm_create" eval="0" />
            <field name="perm_unlink" eval="0" />
        </record>
    </data>
</odoo>
