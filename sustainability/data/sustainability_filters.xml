<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Filtros predefinidos para res.company en Ajustes > Compañías -->
        <record id="filter_company_sust_bronze" model="ir.filters">
            <field name="name">Sostenibilidad - Bronce</field>
            <field name="model_id">res.company</field>
            <field name="domain">[('sustain_certification_level', '=', 'bronze')]</field>
            <field name="user_ids" eval="False"/>
        </record>

        <record id="filter_company_sust_silver" model="ir.filters">
            <field name="name">Sostenibilidad - Plata</field>
            <field name="model_id">res.company</field>
            <field name="domain">[('sustain_certification_level', '=', 'silver')]</field>
            <field name="user_ids" eval="False"/>
        </record>

        <record id="filter_company_sust_gold" model="ir.filters">
            <field name="name">Sostenibilidad - Oro</field>
            <field name="model_id">res.company</field>
            <field name="domain">[('sustain_certification_level', '=', 'gold')]</field>
            <field name="user_ids" eval="False"/>
        </record>

        <record id="filter_company_sust_none" model="ir.filters">
            <field name="name">Sin sello Sostenibilidad</field>
            <field name="model_id">res.company</field>
            <field name="domain">[('sustain_certification_level', '=', 'none')]</field>
            <field name="user_ids" eval="False"/>
        </record>

        <record id="filter_company_sust_expired" model="ir.filters">
            <field name="name">Sello Silver expirado</field>
            <field name="model_id">res.company</field>
            <field name="domain">[('sustain_expiry_date', '&lt;', context_today().strftime('%Y-%m-%d'))]</field>
            <field name="user_ids" eval="False"/>
        </record>
    </data>
</odoo>
