#. module: sustainability
#: model:mail.template,body_html:sustainability.mail_template_sust_admin_expiry_alert
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Administrador,\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        El sello Sostenibilidad de la empresa <strong t-out=\"object.company_id.name\"/> ha expirado.\n"
"                    </p>\n"
"                    <ul>\n"
"                        <li>Nivel anterior: <t t-out=\"object.certification_level\"/></li>\n"
"                        <li>Fecha de expiración: <t t-out=\"object.expiry_date\"/></li>\n"
"                        <li>Usuario: <t t-out=\"object.partner_id.name\"/></li>\n"
"                    </ul>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <a t-att-href=\"'/web#id=%s&amp;model=survey.user_input&amp;view_type=form' % object.id\">\n"
"                            Ver evaluación\n"
"                        </a>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: sustainability
#: model:mail.template,body_html:sustainability.mail_template_sust_retry_available
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Hola <t t-out=\"object.partner_id.name\"/>,\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        El plazo de espera desde tu última evaluación de Sostenibilidad ha terminado. Ya puedes realizar un nuevo intento para obtener tu sello de certificación.\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <a t-att-href=\"'/web#action=%s' % env.ref('sustainability.action_sust_evaluations').id\" style=\"background-color: #875A7B; padding: 10px 20px; color: #ffffff; text-decoration: none; border-radius: 5px;\">\n"
"                            Ir a Mis Evaluaciones\n"
"                        </a>\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        ¡Mucho éxito!<br/>\n"
"                        El equipo de Canarias Conectada\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: sustainability
#: model:mail.template,body_html:sustainability.mail_template_sust_renewal_due
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Hola <t t-out=\"object.partner_id.name\"/>,\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Tu sello Sostenibilidad <strong t-out=\"object.certification_level\"/> vence el <strong t-out=\"object.expiry_date\"/>.\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Para mantener tu certificación activa, debes realizar una nueva evaluación antes de esa fecha.\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <a t-att-href=\"'/web#action=%s' % env.ref('sustainability.action_sust_evaluations').id\" style=\"background-color: #875A7B; padding: 10px 20px; color: #ffffff; text-decoration: none; border-radius: 5px;\">\n"
"                            Realizar renovación\n"
"                        </a>\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Saludos,<br/>\n"
"                        El equipo de Canarias Conectada\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: sustainability
#: model:mail.template,body_html:sustainability.mail_template_sust_new_badge
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Hola <t t-out=\"object.partner_id.name\"/>,\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        ¡Enhorabuena! Tu empresa <strong t-out=\"object.company_id.name\"/> ha obtenido el sello:\n"
"                    </p>\n"
"                    <div style=\"text-align: center; padding: 20px; margin: 20px 0; background-color: #f8f9fa; border-radius: 10px;\">\n"
"                        <h2 style=\"color: #875A7B; text-transform: uppercase;\">\n"
"                            <t t-if=\"object.certification_level == 'bronze'\">🥉 Bronce</t>\n"
"                            <t t-if=\"object.certification_level == 'silver'\">🥈 Plata</t>\n"
"                            <t t-if=\"object.certification_level == 'gold'\">🥇 Oro</t>\n"
"                        </h2>\n"
"                        <p>Puntuación: <strong t-out=\"object.scoring_total\"/> / <t t-out=\"object.survey_id.sustain_max_score\"/> puntos</p>\n"
"                        <p>Válido hasta: <strong t-out=\"object.expiry_date\"/></p>\n"
"                    </div>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        El sello aparecerá automáticamente en tu microsite web.\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Saludos,<br/>\n"
"                        El equipo de Canarias Conectada\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

