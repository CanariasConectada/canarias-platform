<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- CONFIGURACIÓN DEL MENÚ PARA CADA MICROSITE -->
    <!-- Solo Inicio y Tienda -->
    <!-- Sin Servicios, Sin Contáctanos -->
    <!-- Con Carrito, Búsqueda, Login (sin registro) -->
    <!-- ============================================ -->

    <!-- Menú Inicio - Creado para el main_menu -->
    <record id="menu_inicio" model="website.menu">
        <field name="name">Inicio</field>
        <field name="url">/</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">10</field>
    </record>

    <!-- Menú Tienda -->
    <record id="menu_tienda" model="website.menu">
        <field name="name">Tienda</field>
        <field name="url">/shop</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">20</field>
    </record>

    <!-- NOTA: Elementos que deben estar visibles en el header (gestionados por Odoo):
         - Carrito (website_sale)
         - Búsqueda (website)
         - Login (portal)

         Elementos ELIMINADOS/OCULTOS:
         - Servicios (no se crea)
         - Contáctanos (no se crea)
         - Teléfono en header (oculto via CSS/template)
         - Registro de usuarios (desactivado)
    -->
</odoo>
