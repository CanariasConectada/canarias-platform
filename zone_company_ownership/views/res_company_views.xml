<odoo>
    <record id="res_company_form_zone_company" model="ir.ui.view">
        <field name="name">res.company.form.zone.company</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <!-- Only the three zone companies carry this. It is the
                     answer to "which company IS Guanarteme", which nothing
                     else in the database records. -->
                <field name="zone_company_key"
                       groups="base.group_system"/>
            </field>
        </field>
    </record>
</odoo>
