<odoo>

    <!-- The filter panel, in the sidebar hook the directory publishes for
         bridges. Grouped by subdivision and in catalogue order, so a visitor
         who read "Instalaciones y servicios" on a shop's page meets the same
         headings and the same wording here.

         Every chip is a plain link whose address the controller built: no
         JavaScript, so the filter survives a shared URL, a bookmark and a
         browser with scripting turned off, and every combination is a real
         page the search engines can reach. -->
    <template id="directory_sidebar_facilities"
              inherit_id="website_directory.directory_sidebar_extra"
              name="Directory filter: facilities and services">
        <xpath expr="//div[@id='o_wd_sidebar_extra']" position="inside">
            <div t-if="facility_filter_groups" class="card border-0 shadow-sm mb-3 o_wdcf_filter">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="card-title fw-bold mb-0">
                            <i class="fa fa-list-ul me-2"/>Instalaciones y servicios
                        </h6>
                        <a t-if="selected_facility_ids"
                           t-att-href="facility_filter_clear_url"
                           class="small text-decoration-none">Quitar</a>
                    </div>
                    <t t-foreach="facility_filter_groups" t-as="group">
                        <div class="mb-3">
                            <div class="text-muted small text-uppercase fw-semibold mb-2">
                                <i t-if="group['icon']"
                                   t-attf-class="fa #{group['icon']} me-1"/>
                                <t t-out="group['name']"/>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <t t-foreach="group['facilities']" t-as="facility">
                                    <a t-att-href="facility['url']"
                                       t-attf-class="btn btn-sm #{'btn-primary' if facility['selected'] else 'btn-outline-secondary'}"
                                       t-att-aria-pressed="'true' if facility['selected'] else 'false'">
                                        <i t-attf-class="fa #{facility['icon']} me-1"/>
                                        <t t-out="facility['name']"/>
                                    </a>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
