<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_memoria_viva_historia_public" model="ir.rule">
            <field name="name">Memoria Viva: público solo historias aprobadas publicadas</field>
            <field name="model_id" ref="model_memoria_viva_historia"/>
            <field name="domain_force">[('state','=','aprobado')]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_memoria_viva_historia_internal" model="ir.rule">
            <field name="name">Memoria Viva: aprobadores y admins ven todo</field>
            <field name="model_id" ref="model_memoria_viva_historia"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_memoria_viva_approver')), (4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
