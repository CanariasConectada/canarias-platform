<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuración de Memoria Viva integrada en Ajustes > Website.
         Sustituye al antiguo formulario sobre el modelo singleton
         memoria.viva.settings (que abría en modo creación y no guardaba). -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.memoria.viva</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']//block[@id='website_info_settings']" position="after">
                <block title="Memoria Viva" name="memoria_viva_settings" invisible="not website_id">
                    <setting string="Disponibilidad del sitio"
                             help="Solo los sitios web/microsites marcados muestran la página pública /memoria-viva. El resto devuelven 404.">
                        <field name="memoria_viva_enabled"/>
                    </setting>
                    <!-- El resto de la configuración SOLO es relevante si el sitio
                         tiene Memoria Viva habilitada; si no, se oculta porque de
                         memoria_viva_enabled depende todo lo demás (la página ni
                         siquiera se publica). Cada campo va en su propio <setting>
                         para que el checkbox muestre su etiqueta. -->
                    <setting string="Mostrar Tipo"
                             invisible="not memoria_viva_enabled"
                             help="Muestra el selector de Tipo en el formulario público de envío.">
                        <field name="memoria_viva_show_tipo"/>
                    </setting>
                    <setting string="Mostrar Categoría"
                             invisible="not memoria_viva_enabled"
                             help="Muestra el selector de Categoría en el formulario público de envío.">
                        <field name="memoria_viva_show_categoria"/>
                    </setting>
                    <setting string="Mostrar Subcategoría"
                             invisible="not memoria_viva_enabled"
                             help="Muestra el selector de Subcategoría en el formulario público de envío.">
                        <field name="memoria_viva_show_subcategoria"/>
                    </setting>
                    <setting string="Mostrar Historia completa"
                             invisible="not memoria_viva_enabled"
                             help="Muestra el campo de descripción larga (historia completa) en el formulario.">
                        <field name="memoria_viva_show_descripcion_larga"/>
                    </setting>
                    <setting string="Mostrar Coordenadas"
                             invisible="not memoria_viva_enabled"
                             help="Permite introducir coordenadas (latitud/longitud) en el formulario.">
                        <field name="memoria_viva_show_coordenadas"/>
                    </setting>
                    <setting string="Mostrar Mapa en listado"
                             invisible="not memoria_viva_enabled"
                             help="Muestra el mapa con las ubicaciones en la página de listado.">
                        <field name="memoria_viva_show_mapa"/>
                    </setting>
                    <setting string="Mostrar nombre del publicador"
                             invisible="not memoria_viva_enabled"
                             help="Muestra el nombre de quien publicó cada historia.">
                        <field name="memoria_viva_show_nombre_publicador"/>
                    </setting>
                    <setting string="Mostrar solo primer nombre"
                             invisible="not memoria_viva_enabled"
                             help="Si está activo, solo se muestra el primer nombre del publicador (privacidad).">
                        <field name="memoria_viva_show_only_firstname"/>
                    </setting>
                    <setting string="Anuncio promocional"
                             invisible="not memoria_viva_enabled"
                             help="Banner que aparece bajo el hero en /memoria-viva">
                        <field name="memoria_viva_anuncio_activo"/>
                        <div class="content-group mt-2" invisible="not memoria_viva_anuncio_activo">
                            <div class="row">
                                <label string="Título" for="memoria_viva_anuncio_titulo" class="col-lg-3"/>
                                <field name="memoria_viva_anuncio_titulo"/>
                            </div>
                            <div class="row">
                                <label string="Texto" for="memoria_viva_anuncio_texto" class="col-lg-3"/>
                                <field name="memoria_viva_anuncio_texto"/>
                            </div>
                            <div class="row">
                                <label string="Color" for="memoria_viva_anuncio_color" class="col-lg-3"/>
                                <field name="memoria_viva_anuncio_color"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Sistema de likes"
                             invisible="not memoria_viva_enabled"
                             help="Duración de la cookie que evita likes repetidos">
                        <field name="memoria_viva_likes_cookie_days"/>
                    </setting>
                    <setting string="Filtros del sidebar"
                             invisible="not memoria_viva_enabled">
                        <field name="memoria_viva_show_reset_filters"/>
                    </setting>
                    <setting string="Comentarios"
                             invisible="not memoria_viva_enabled">
                        <field name="memoria_viva_permitir_comentarios"/>
                        <div class="content-group mt-2" invisible="not memoria_viva_permitir_comentarios">
                            <div class="row">
                                <field name="memoria_viva_comentarios_publicos"/>
                                <label string="Comentarios visibles públicamente" for="memoria_viva_comentarios_publicos"/>
                            </div>
                            <div class="row">
                                <label string="Comentarios por página" for="memoria_viva_comentarios_por_pagina" class="col-lg-4"/>
                                <field name="memoria_viva_comentarios_por_pagina"/>
                            </div>
                            <div class="mt-2">
                                <button name="%(action_memoria_viva_palabra_prohibida)d"
                                        type="action"
                                        string="Gestionar palabras prohibidas"
                                        class="btn btn-link"
                                        icon="fa-arrow-right"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <!-- Acción del menú: abre Ajustes desplazado a la sección Website -->
    <record id="action_memoria_viva_settings" model="ir.actions.act_window">
        <field name="name">Configuración Memoria Viva</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'website', 'bin_size': False}</field>
    </record>
</odoo>
