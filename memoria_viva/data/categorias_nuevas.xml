<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Desactivar categorías viejas (las desactivamos, no las eliminamos para no perder datos) -->
        <!-- Esto se hará vía código para poder mapear correctamente -->
        
        <!-- Nuevas categorías (7 categorías planas, sin jerarquía de tipos) -->
        <!-- Usamos un tipo genérico para todas -->
        
        <record id="tipo_generico" model="memoria.viva.tipo">
            <field name="name">General</field>
        </record>
        
        <record id="cat_historia" model="memoria.viva.categoria">
            <field name="name">Historia</field>
            <field name="tipo_id" ref="tipo_generico"/>
            <field name="sequence">10</field>
        </record>
        
        <record id="cat_costumbres" model="memoria.viva.categoria">
            <field name="name">Costumbres</field>
            <field name="tipo_id" ref="tipo_generico"/>
            <field name="sequence">20</field>
        </record>
        
        <record id="cat_edificios" model="memoria.viva.categoria">
            <field name="name">Edificios y casas</field>
            <field name="tipo_id" ref="tipo_generico"/>
            <field name="sequence">30</field>
        </record>
        
        <record id="cat_gente" model="memoria.viva.categoria">
            <field name="name">Gente</field>
            <field name="tipo_id" ref="tipo_generico"/>
            <field name="sequence">40</field>
        </record>
        
        <record id="cat_fiestas" model="memoria.viva.categoria">
            <field name="name">Fiestas</field>
            <field name="tipo_id" ref="tipo_generico"/>
            <field name="sequence">50</field>
        </record>
        
        <record id="cat_actividades" model="memoria.viva.categoria">
            <field name="name">Actividades</field>
            <field name="tipo_id" ref="tipo_generico"/>
            <field name="sequence">60</field>
        </record>
        
        <record id="cat_otros" model="memoria.viva.categoria">
            <field name="name">Otros</field>
            <field name="tipo_id" ref="tipo_generico"/>
            <field name="sequence">70</field>
        </record>
    </data>
</odoo>
