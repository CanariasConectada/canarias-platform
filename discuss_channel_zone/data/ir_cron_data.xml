<odoo>
    <!--
        noupdate="1" so an administrator can move the hour, widen the interval
        or switch the job off without an update putting it back.
    -->
    <data noupdate="1">

        <record id="cron_sync_zone_channels" model="ir.cron">
            <field name="name">Discuss Channel Zone: reconcile channel membership</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_zone_channels()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- 03:15 UTC: after the nightly imports, before anybody reads. -->
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=15, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
