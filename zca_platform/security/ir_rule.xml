<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
<!--
    ZCA Platform — Reglas de acceso por empresa activa.

    ARQUITECTURA DE SEGURIDAD (dos capas):
    1. ir.rule (este fichero): frontera ORM estándar por grupo.
       - Solo cubre grupos ZCA (Gestor y Básico).
       - Admin (group_system) bypasea ir.rules por diseño Odoo → cubierto por _search.
    2. zca_security.py (_search ORM override): filtro adicional dinámico.
       - Admin: filtra por empresa activa.
       - ZCA: excluye partners/users de administradores.

    DOMINIOS: estáticos (sin llamadas ORM en expresión) para evitar recursión.
    noupdate="0": las reglas se actualizan en cada upgrade.
-->

    <!-- ══════════════════════════════════════════════
         RES.PARTNER
         Gestor: lectura/escritura de contactos propios
         Básico: solo lectura
    ══════════════════════════════════════════════ -->

    <record id="rule_partner_by_company" model="ir.rule">
        <field name="name">Gestor: contactos de la empresa activa</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('zca_platform.group_zca_comercio_manager'))]"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_partner_self" model="ir.rule">
        <field name="name">Gestor: su propio partner de usuario</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('zca_platform.group_zca_comercio_manager'))]"/>
        <field name="domain_force">[('id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_basic_partner_by_company" model="ir.rule">
