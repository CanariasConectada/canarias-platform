        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_basic_partner_self" model="ir.rule">
        <field name="name">Básico: su propio partner de usuario</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('zca_platform.group_zca_comercio_basic'))]"/>
