<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         NIVEL 3 — GESTOR DE COMERCIO
         Mismos permisos que Administrador pero solo en sus empresas.
         Los ir.rules se encargan del aislamiento por empresa.
         ══════════════════════════════════════════════════════════════ -->
    <record id="group_zca_comercio_manager" model="res.groups">
        <field name="name">Gestor de Comercio ZCA</field>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('base.group_erp_manager')),
            (4, ref('base.group_partner_manager')),
            (4, ref('stock.group_stock_manager')),
            (4, ref('website.group_website_designer')),
            (4, ref('sales_team.group_sale_manager')),
            (4, ref('purchase.group_purchase_manager')),
            (4, ref('account.group_account_manager')),
        ]"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         NIVEL 4 — USUARIO BÁSICO ZCA
         Mismas reglas de visibilidad que el Gestor (ir.rules),
         pero sin acceso a módulos de gestión por defecto.
         El Gestor puede asignarle grupos adicionales desde Ajustes > Usuarios.
         ══════════════════════════════════════════════════════════════ -->
    <record id="group_zca_comercio_basic" model="res.groups">
        <field name="name">Usuario Básico ZCA</field>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
        ]"/>
    </record>

</odoo>
