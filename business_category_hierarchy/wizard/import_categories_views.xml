<odoo>

    <record id="business_category_import_view_form" model="ir.ui.view">
        <field name="name">business.category.import.form</field>
        <field name="model">business.category.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="import_data"
                           placeholder="Paste the category list here (see the field help for the expected format)..."/>
                </group>
                <footer>
                    <button name="action_import"
                            string="Import"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="business_category_import_action" model="ir.actions.act_window">
        <field name="name">Import Categories</field>
        <field name="res_model">business.category.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_business_category_import"
              name="Import Categories"
              parent="contacts.res_partner_menu_config"
              action="business_category_import_action"
              sequence="11"/>

</odoo>
