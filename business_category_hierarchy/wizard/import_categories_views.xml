<odoo>

    <!-- Form View for Import Wizard -->
    <record id="business_category_import_view_form" model="ir.ui.view">
        <field name="name">business.category.import.form</field>
        <field name="model">business.category.import</field>
        <field name="arch" type="xml">
            <form string="Importar Categorías de Comercio">
                <group>
                    <field name="import_data"
                           placeholder="Pegue aquí la lista de categorías...

Ejemplo de formato:
  Alimentación
Panadería
Frutería
Carnicería
  Comercio
Ferretería
Papelería"/>
                </group>
                <footer>
                    <button name="action_import"
                            string="Importar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Import Wizard -->
    <record id="business_category_import_action" model="ir.actions.act_window">
        <field name="name">Importar Categorías</field>
        <field name="res_model">business.category.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item for Import Wizard -->
    <menuitem id="menu_business_category_import"
              name="Importar Categorías"
              parent="contacts.res_partner_menu_config"
              action="business_category_import_action"
              sequence="11"/>

</odoo>
