<odoo>

    <record id="business_category_view_search" model="ir.ui.view">
        <field name="name">business.category.search</field>
        <field name="model">business.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="complete_name"/>
                <field name="parent_id"/>
                <separator/>
                <filter name="filter_root"
                        string="Root Categories"
                        domain="[('parent_id', '=', False)]"/>
                <filter name="filter_level2"
                        string="Subcategories (level 2)"
                        domain="[('hierarchy_level', '=', 2)]"/>
                <filter name="filter_level3"
                        string="Specialties (level 3)"
                        domain="[('hierarchy_level', '=', 3)]"/>
                <separator/>
                <filter name="filter_inactive"
                        string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_parent"
                            string="Parent Category"
                            context="{'group_by': 'parent_id'}"/>
                    <filter name="group_level"
                            string="Level"
                            context="{'group_by': 'hierarchy_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="business_category_view_list" model="ir.ui.view">
        <field name="name">business.category.list</field>
        <field name="model">business.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="hierarchy_level" optional="show"/>
                <field name="parent_id" optional="show"/>
                <field name="company_count" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="business_category_view_form" model="ir.ui.view">
        <field name="name">business.category.form</field>
        <field name="model">business.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Category name"/>
                        </h1>
                        <h2 class="oe_read_only">
                            <field name="complete_name"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"
                                   placeholder="Pick a parent or type a new name (empty for a root category)"/>
                            <field name="hierarchy_level"/>
                        </group>
                        <group>
                            <field name="company_count"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subcategories"
                              name="subcategories"
                              invisible="not child_ids">
                            <field name="child_ids" mode="list">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="complete_name"/>
                                    <field name="company_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Companies"
                              name="companies"
                              invisible="company_count == 0">
                            <field name="company_ids">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="business_category_action" model="ir.actions.act_window">
        <field name="name">Business Categories</field>
        <field name="res_model">business.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="business_category_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new business category
            </p>
            <p>
                Business categories classify companies in a hierarchy,
                e.g. to filter them in the public directory.
            </p>
        </field>
    </record>

    <menuitem id="menu_business_category_config"
              name="Business Categories"
              parent="contacts.res_partner_menu_config"
              action="business_category_action"
              sequence="10"/>

</odoo>
