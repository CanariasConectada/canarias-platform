<odoo>
    <data noupdate="0">
        <!-- What "managing a commercial zone" means on this platform, in
             one tick. Requested 2026-09-15: one manager per zone
             (Guanarteme, Lomo los Frailes, Tamaraceite) who sees the
             companies and contacts of their own zone and nothing of the
             others, organises the zone's events and mails its members;
             no sales, no products.

             The zone itself is NOT decided here: it is the user's session
             company. A manager is a user whose company is the zone company
             (`res.company.zone_company_key`) and whose only allowed company
             is that one. Every record rule below reads `company_ids`, and
             `zone_company_ownership` already puts the zone company on
             every contact of the zone's shops, so Contacts needs no rule
             of its own.

             A group, not a role, and not implied by Comercios nor by the
             default groups: nothing recomposes anything, and nobody gets
             it without an administrator ticking it. (6, 0) on purpose: an
             update of this module is the one place the list is decided.
             No privilege, so it renders as a checkbox under "Extra
             rights" (see merchant_group for the reason). -->
        <record id="group_zca_manager" model="res.groups">
            <field name="name">ZCA Manager</field>
            <field name="sequence">12</field>
            <field name="comment">Manager of a commercial zone: sees the companies and contacts of the zone that is their company, organises its events and sends mailings to its members. No sales, no products.</field>
            <field name="implied_ids" eval="[(6, 0, [
                ref('base.group_user'),
                ref('base.group_multi_company'),
                ref('base.group_partner_manager'),
                ref('event.group_event_manager'),
                ref('mass_mailing.group_mass_mailing_user'),
            ])]"/>
        </record>

        <!-- Companies of my zone. Core's employee rule only shows the
             companies the user is allowed into, i.e. the zone company
             itself; the shops OF the zone are the ones the manager needs
             to see. Read only: write, create and delete keep core's rule
             and the access list (internal users cannot write a company),
             so the manager reads the shops and edits none. -->
        <record id="res_company_rule_zca_manager" model="ir.rule">
            <field name="name">res.company: ZCA manager reads the companies of their zone</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="groups" eval="[(4, ref('group_zca_manager'))]"/>
            <field name="domain_force">['|', ('id', 'in', company_ids), ('commercial_zone', 'in', user.company_ids.filtered('zone_company_key').mapped('zone_company_key'))]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Mailings of my zone. `mailing.mailing` carries no company, so
             a mailing belongs to the zone whose staff created it or is
             responsible for it. Group rules are OR-ed only among the
             groups a user holds: a merchant or an administrator, who is
             not in this group, keeps seeing every mailing as today. -->
        <record id="mailing_mailing_rule_zca_manager" model="ir.rule">
            <field name="name">mailing.mailing: ZCA manager works on the mailings of their zone</field>
            <field name="model_id" ref="mass_mailing.model_mailing_mailing"/>
            <field name="groups" eval="[(4, ref('group_zca_manager'))]"/>
            <field name="domain_force">['|', ('create_uid.company_id', 'in', company_ids), ('user_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="mailing_list_rule_zca_manager" model="ir.rule">
            <field name="name">mailing.list: ZCA manager works on the mailing lists of their zone</field>
            <field name="model_id" ref="mass_mailing.model_mailing_list"/>
            <field name="groups" eval="[(4, ref('group_zca_manager'))]"/>
            <field name="domain_force">[('create_uid.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
