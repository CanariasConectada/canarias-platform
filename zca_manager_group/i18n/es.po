#. module: zca_manager_group
#: model:ir.actions.act_window,name:zca_manager_group.action_zone_companies
#: model:ir.ui.menu,name:zca_manager_group.menu_zone_companies
msgid "Companies"
msgstr "Compañías"

#. module: zca_manager_group
#: model:res.groups,comment:zca_manager_group.group_zca_manager
msgid "Manager of a commercial zone: sees the companies and contacts of the zone that is their company, organises its events and sends mailings to its members. No sales, no products."
msgstr "Gestor de una zona comercial: ve las compañías y los contactos de la zona que es su compañía, organiza sus eventos y envía correos a sus asociados. Sin ventas ni productos."

#. module: zca_manager_group
#: model:res.groups,name:zca_manager_group.group_zca_manager
msgid "ZCA Manager"
msgstr "Gestor ZCA"

#. module: zca_manager_group
#: model:ir.rule,name:zca_manager_group.mailing_list_rule_zca_manager
msgid "mailing.list: ZCA manager works on the mailing lists of their zone"
msgstr "mailing.list: el gestor ZCA trabaja con las listas de correo de su zona"

#. module: zca_manager_group
#: model:ir.rule,name:zca_manager_group.mailing_mailing_rule_zca_manager
msgid "mailing.mailing: ZCA manager works on the mailings of their zone"
msgstr "mailing.mailing: el gestor ZCA trabaja con los envíos de su zona"

#. module: zca_manager_group
#: model:ir.rule,name:zca_manager_group.res_company_rule_zca_manager
msgid "res.company: ZCA manager reads the companies of their zone"
msgstr "res.company: el gestor ZCA lee las compañías de su zona"
