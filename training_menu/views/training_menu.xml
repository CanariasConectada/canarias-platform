<odoo>
    <!-- Absolute on purpose: the courses are published on the portal
         website (canariasconectada.es) and a relative /slides would resolve
         against whatever host the backend is opened on. -->
    <!-- Same tab, not a new one: Odoo opens a "new" act_url with
         window.open AFTER the action round-trip, which browsers treat as a
         popup and block until the user allows it (reported 2026-09-10). -->
    <record id="action_training_courses" model="ir.actions.act_url">
        <field name="name">Formación</field>
        <field name="url">https://canariasconectada.es/slides</field>
        <field name="target">self</field>
    </record>

    <!-- A root entry every internal user sees in the apps menu; asked for on
         2026-09-10 so that the training is one click away for the people who
         work in the backend. -->
    <menuitem id="menu_training_root"
              name="Formación"
              action="action_training_courses"
              web_icon="training_menu,static/description/icon.png"
              groups="base.group_user"
              sequence="95"/>
</odoo>
