<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Line Tree -->
    <record id="view_microsite_validation_line_tree" model="ir.ui.view">
        <field name="name">microsite.validation.line.tree</field>
        <field name="model">microsite.validation.line</field>
        <field name="arch" type="xml">
            <list decoration-success="state=='ok'" decoration-warning="state=='incomplete'" decoration-danger="state=='error'">
                <field name="company_name"/>
                <field name="state"/>
                <field name="missing_fields" optional="hide"/>
                <field name="missing_sections" optional="hide"/>
                <field name="has_lorem" optional="show"/>
                <button name="action_open_partner" type="object" icon="fa-external-link" title="Abrir contacto"/>
            </list>
        </field>
    </record>

    <!-- Line Form -->
    <record id="view_microsite_validation_line_form" model="ir.ui.view">
        <field name="name">microsite.validation.line.form</field>
        <field name="model">microsite.validation.line</field>
        <field name="arch" type="xml">
            <form string="Detalle de Validación">
                <sheet>
                    <group>
                        <field name="company_name"/>
                        <field name="state"/>
                        <field name="website_id"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="missing_fields"/>
                        <field name="missing_sections"/>
                        <field name="has_lorem"/>
                        <field name="lorem_snippets"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Report Form -->
    <record id="view_microsite_validation_report_form" model="ir.ui.view">
        <field name="name">microsite.validation.report.form</field>
        <field name="model">microsite.validation.report</field>
        <field name="arch" type="xml">
            <form string="Reporte de Validación">
                <header>
                    <button name="action_validate_all" string="Ejecutar Validación" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="total_websites"/>
                            <field name="ok_count"/>
                            <field name="incomplete_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalles">
                            <field name="line_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Report Tree -->
    <record id="view_microsite_validation_report_tree" model="ir.ui.view">
        <field name="name">microsite.validation.report.tree</field>
        <field name="model">microsite.validation.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="total_websites"/>
                <field name="ok_count"/>
                <field name="incomplete_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_microsite_validation_report" model="ir.actions.act_window">
        <field name="name">Validación de Microsites</field>
        <field name="res_model">microsite.validation.report</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu under Website > Configuration -->
    <menuitem id="menu_microsite_validation_root"
              name="Validación Microsites"
              parent="website.menu_website_configuration"
              action="action_microsite_validation_report"
              sequence="100"/>

</odoo>
