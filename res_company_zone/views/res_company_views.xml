<odoo>

    <record id="view_company_form_zone" model="ir.ui.view">
        <field name="name">res.company.form.zone</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <label for="comercial" />
                <h2>
                    <field name="comercial" placeholder="e.g. The name on the shop sign" />
                </h2>
            </xpath>
            <field name="country_id" position="after">
                <field name="commercial_zone" />
            </field>
        </field>
    </record>

    <!-- The list behind "Contenido de página" shows all 218 shops in one
         flat run. The trade name goes first because it is the one the
         operators scan for (the legal name is the owner's own name for a
         third of them); which neighbourhood a row belongs to comes next.
         Inherited on the base list so every screen that lists companies
         gets the columns, removable per user because they are `optional`. -->
    <record id="view_company_tree_zone" model="ir.ui.view">
        <field name="name">res.company.list.zone</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="comercial" optional="show" />
            </field>
            <field name="name" position="after">
                <field name="commercial_zone" optional="show" />
            </field>
        </field>
    </record>

    <!-- res.company has no search view in base; the one every company list
         opens with belongs to OCA `res_company_search_view`, hence the hard
         dependency. Its `name` field is what the search box types into, so
         that domain is restated here with the trade name added: an
         inherited attribute replaces, it cannot append. -->
    <record id="view_res_company_search_zone" model="ir.ui.view">
        <field name="name">res.company.search.zone</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="res_company_search_view.view_res_company_search" />
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', '|',
                    ('name', 'ilike', self),
                    ('comercial', 'ilike', self),
                    ('vat', 'ilike', self),
                    ('company_registry', 'ilike', self)]</attribute>
            </field>
            <field name="name" position="after">
                <field name="comercial" />
            </field>
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter
                    name="group_commercial_zone"
                    string="Commercial zone"
                    context="{'group_by': 'commercial_zone'}"
                />
            </xpath>
        </field>
    </record>

</odoo>
